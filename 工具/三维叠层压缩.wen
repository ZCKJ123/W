# 三维叠层压缩实验
# 把字节流铺成 64×64 的二维格子，再一层层叠成三维体；
# 压缩放在层与层之间做，而不是在一条一维字节流上做。
# 对比：一维游程（平铺基线）/ 逐层二维游程 / 跨层异或+游程 / 整层去重+游程

依赖 文件库
依赖 数学库

将 层宽 变成 64
将 层高 变成 64
将 层大小 变成 层宽 * 层高

函数 片段 源 起 止 则
    将 长 变成 止 - 起
    将 出 变成 新建缓冲(长 + 8, 0)
    将 序 变成 0
    当 序 < 长 则
        缓冲写(出, 序, 缓冲读(源, 起 + 序))
        将 序 变成 序 + 1
    结束
    返回 出
结束

函数 字节相同 甲 甲起 乙 乙起 长 则
    将 序 变成 0
    当 序 < 长 则
        如果 缓冲读(甲, 甲起 + 序) 不等于 缓冲读(乙, 乙起 + 序) 则
            返回 0
        结束
        将 序 变成 序 + 1
    结束
    返回 1
结束

函数 全部相同 甲 乙 长 则
    将 序 变成 0
    当 序 < 长 则
        如果 缓冲读(甲, 序) 不等于 缓冲读(乙, 序) 则
            返回 0
        结束
        将 序 变成 序 + 1
    结束
    返回 1
结束

# 一维游程：整条流从头到尾压，不分层（平铺基线）
函数 一维游程 源 长 则
    将 出 变成 新建缓冲(长 * 2 + 64, 0)
    将 位 变成 0
    将 序 变成 0
    当 序 < 长 则
        将 值 变成 缓冲读(源, 序)
        将 数 变成 1
        将 序 变成 序 + 1
        当 序 < 长 则
            如果 缓冲读(源, 序) 等于 值 则
                如果 数 < 256 则
                    将 数 变成 数 + 1
                    将 序 变成 序 + 1
                否则
                    中断
                结束
            否则
                中断
            结束
        结束
        缓冲写(出, 位, 数 - 1)
        缓冲写(出, 位 + 1, 值)
        将 位 变成 位 + 2
    结束
    返回 片段(出, 0, 位)
结束

# 编码A：每层单独做二维游程（游程不跨层）
函数 编码A 源 长 则
    将 出 变成 新建缓冲(长 * 2 + 64, 0)
    将 位 变成 0
    将 层起 变成 0
    当 层起 < 长 则
        将 层止 变成 层起 + 层大小
        如果 层止 > 长 则
            将 层止 变成 长
        结束
        将 序 变成 层起
        当 序 < 层止 则
            将 值 变成 缓冲读(源, 序)
            将 数 变成 1
            将 序 变成 序 + 1
            当 序 < 层止 则
                如果 缓冲读(源, 序) 等于 值 则
                    如果 数 < 256 则
                        将 数 变成 数 + 1
                        将 序 变成 序 + 1
                    否则
                        中断
                    结束
                否则
                    中断
                结束
            结束
            缓冲写(出, 位, 数 - 1)
            缓冲写(出, 位 + 1, 值)
            将 位 变成 位 + 2
        结束
        将 层起 变成 层止
    结束
    返回 片段(出, 0, 位)
结束

函数 解码A 码 长 则
    将 出 变成 新建缓冲(长 + 64, 0)
    将 位 变成 0
    将 写 变成 0
    将 层起 变成 0
    当 层起 < 长 则
        将 层止 变成 层起 + 层大小
        如果 层止 > 长 则
            将 层止 变成 长
        结束
        当 写 < 层止 则
            将 数 变成 缓冲读(码, 位) + 1
            将 值 变成 缓冲读(码, 位 + 1)
            将 位 变成 位 + 2
            将 次 变成 0
            当 次 < 数 则
                缓冲写(出, 写, 值)
                将 写 变成 写 + 1
                将 次 变成 次 + 1
            结束
        结束
        将 层起 变成 层止
    结束
    返回 出
结束

# 编码B：每层先跟上一层做异或，再游程
函数 编码B 源 长 则
    将 出 变成 新建缓冲(长 * 2 + 64, 0)
    将 位 变成 0
    将 层起 变成 0
    当 层起 < 长 则
        将 层止 变成 层起 + 层大小
        如果 层止 > 长 则
            将 层止 变成 长
        结束
        将 序 变成 层起
        当 序 < 层止 则
            将 值 变成 缓冲读(源, 序)
            如果 序 >= 层大小 则
                将 值 变成 按位异或(值, 缓冲读(源, 序 - 层大小))
            结束
            将 数 变成 1
            将 序 变成 序 + 1
            当 序 < 层止 则
                将 次值 变成 缓冲读(源, 序)
                如果 序 >= 层大小 则
                    将 次值 变成 按位异或(次值, 缓冲读(源, 序 - 层大小))
                结束
                如果 次值 等于 值 则
                    如果 数 < 256 则
                        将 数 变成 数 + 1
                        将 序 变成 序 + 1
                    否则
                        中断
                    结束
                否则
                    中断
                结束
            结束
            缓冲写(出, 位, 数 - 1)
            缓冲写(出, 位 + 1, 值)
            将 位 变成 位 + 2
        结束
        将 层起 变成 层止
    结束
    返回 片段(出, 0, 位)
结束

函数 解码B 码 长 则
    将 出 变成 新建缓冲(长 + 64, 0)
    将 位 变成 0
    将 写 变成 0
    将 层起 变成 0
    当 层起 < 长 则
        将 层止 变成 层起 + 层大小
        如果 层止 > 长 则
            将 层止 变成 长
        结束
        当 写 < 层止 则
            将 数 变成 缓冲读(码, 位) + 1
            将 值 变成 缓冲读(码, 位 + 1)
            将 位 变成 位 + 2
            将 次 变成 0
            当 次 < 数 则
                将 字 变成 值
                如果 写 >= 层大小 则
                    将 字 变成 按位异或(字, 缓冲读(出, 写 - 层大小))
                结束
                缓冲写(出, 写, 字)
                将 写 变成 写 + 1
                将 次 变成 次 + 1
            结束
        结束
        将 层起 变成 层止
    结束
    返回 出
结束

# 编码C：整层去重 + 逐层游程
函数 编码C 源 长 则
    将 出 变成 新建缓冲(长 * 2 + 64, 0)
    将 位 变成 0
    将 层表 变成 []
    将 层起 变成 0
    当 层起 < 长 则
        将 层止 变成 层起 + 层大小
        如果 层止 > 长 则
            将 层止 变成 长
        结束
        将 命中 变成 -1
        将 序 变成 0
        当 序 < 长度(层表) 则
            将 旧 变成 层表[序]
            如果 长度(旧) 等于 层止 - 层起 则
                如果 全部相同(旧, 片段(源, 层起, 层止), 层止 - 层起) 等于 1 则
                    将 命中 变成 序
                    中断
                结束
            结束
            将 序 变成 序 + 1
        结束
        如果 命中 >= 0 则
            缓冲写(出, 位, 0)
            缓冲写(出, 位 + 1, 命中 % 256)
            缓冲写(出, 位 + 2, 向下取整(命中 / 256) % 256)
            将 位 变成 位 + 3
        否则
            缓冲写(出, 位, 1)
            将 位 变成 位 + 1
            将 序 变成 层起
            当 序 < 层止 则
                将 值 变成 缓冲读(源, 序)
                将 数 变成 1
                将 序 变成 序 + 1
                当 序 < 层止 则
                    如果 缓冲读(源, 序) 等于 值 则
                        如果 数 < 256 则
                            将 数 变成 数 + 1
                            将 序 变成 序 + 1
                        否则
                            中断
                        结束
                    否则
                        中断
                    结束
                结束
                缓冲写(出, 位, 数 - 1)
                缓冲写(出, 位 + 1, 值)
                将 位 变成 位 + 2
            结束
            追加(层表, 片段(源, 层起, 层止))
        结束
        将 层起 变成 层止
    结束
    返回 片段(出, 0, 位)
结束

函数 解码C 码 长 则
    将 出 变成 新建缓冲(长 + 64, 0)
    将 层表 变成 []
    将 位 变成 0
    将 写 变成 0
    将 层起 变成 0
    当 层起 < 长 则
        将 层止 变成 层起 + 层大小
        如果 层止 > 长 则
            将 层止 变成 长
        结束
        将 标 变成 缓冲读(码, 位)
        将 位 变成 位 + 1
        如果 标 等于 0 则
            将 引 变成 缓冲读(码, 位) + 256 * 缓冲读(码, 位 + 1)
            将 位 变成 位 + 2
            将 旧 变成 层表[引]
            将 序 变成 0
            将 长层 变成 层止 - 层起
            当 序 < 长层 则
                缓冲写(出, 层起 + 序, 缓冲读(旧, 序))
                将 序 变成 序 + 1
            结束
            将 写 变成 层止
        否则
            当 写 < 层止 则
                将 数 变成 缓冲读(码, 位) + 1
                将 值 变成 缓冲读(码, 位 + 1)
                将 位 变成 位 + 2
                将 次 变成 0
                当 次 < 数 则
                    缓冲写(出, 写, 值)
                    将 写 变成 写 + 1
                    将 次 变成 次 + 1
                结束
            结束
            追加(层表, 片段(出, 层起, 层止))
        结束
        将 层起 变成 层止
    结束
    返回 出
结束

# 编码D：层内左邻差分 + 游程（二维横向预测，用来对照纵向跨层预测）
函数 编码D 源 长 则
    将 出 变成 新建缓冲(长 * 2 + 64, 0)
    将 位 变成 0
    将 层起 变成 0
    当 层起 < 长 则
        将 层止 变成 层起 + 层大小
        如果 层止 > 长 则
            将 层止 变成 长
        结束
        将 序 变成 层起
        当 序 < 层止 则
            将 值 变成 缓冲读(源, 序)
            如果 序 > 层起 则
                将 值 变成 按位异或(值, 缓冲读(源, 序 - 1))
            结束
            将 数 变成 1
            将 序 变成 序 + 1
            当 序 < 层止 则
                将 次值 变成 缓冲读(源, 序)
                将 次值 变成 按位异或(次值, 缓冲读(源, 序 - 1))
                如果 次值 等于 值 则
                    如果 数 < 256 则
                        将 数 变成 数 + 1
                        将 序 变成 序 + 1
                    否则
                        中断
                    结束
                否则
                    中断
                结束
            结束
            缓冲写(出, 位, 数 - 1)
            缓冲写(出, 位 + 1, 值)
            将 位 变成 位 + 2
        结束
        将 层起 变成 层止
    结束
    返回 片段(出, 0, 位)
结束

函数 解码D 码 长 则
    将 出 变成 新建缓冲(长 + 64, 0)
    将 位 变成 0
    将 写 变成 0
    将 层起 变成 0
    当 层起 < 长 则
        将 层止 变成 层起 + 层大小
        如果 层止 > 长 则
            将 层止 变成 长
        结束
        当 写 < 层止 则
            将 数 变成 缓冲读(码, 位) + 1
            将 值 变成 缓冲读(码, 位 + 1)
            将 位 变成 位 + 2
            将 次 变成 0
            当 次 < 数 则
                将 字 变成 值
                如果 写 > 层起 则
                    将 字 变成 按位异或(字, 缓冲读(出, 写 - 1))
                结束
                缓冲写(出, 写, 字)
                将 写 变成 写 + 1
                将 次 变成 次 + 1
            结束
        结束
        将 层起 变成 层止
    结束
    返回 出
结束
# ---------- 数据集 ----------
函数 合成图案 层数 则
    将 总 变成 层数 * 层大小
    将 出 变成 新建缓冲(总, 0)
    将 层 变成 0
    当 层 < 层数 则
        将 行 变成 0
        当 行 < 层高 则
            将 列 变成 0
            当 列 < 层宽 则
                将 值 变成 (层 * 3 + 行 * 2 + 向下取整(列 / 8)) % 256
                缓冲写(出, 层 * 层大小 + 行 * 层宽 + 列, 值)
                将 列 变成 列 + 1
            结束
            将 行 变成 行 + 1
        结束
        将 层 变成 层 + 1
    结束
    返回 出
结束

函数 合成叠层 层数 则
    将 总 变成 层数 * 层大小
    将 出 变成 新建缓冲(总, 0)
    将 种 变成 12345
    将 序 变成 0
    当 序 < 层大小 则
        将 种 变成 (种 * 75 + 74) % 65537
        缓冲写(出, 序, 种 % 256)
        将 序 变成 序 + 1
    结束
    将 层 变成 1
    当 层 < 层数 则
        将 序 变成 0
        当 序 < 层大小 则
            缓冲写(出, 层 * 层大小 + 序, 缓冲读(出, (层 - 1) * 层大小 + 序))
            将 序 变成 序 + 1
        结束
        将 改 变成 0
        当 改 < 8 则
            将 位 变成 (层 * 977 + 改 * 131) % 层大小
            缓冲写(出, 层 * 层大小 + 位, (层 * 37 + 改 * 5) % 256)
            将 改 变成 改 + 1
        结束
        将 层 变成 层 + 1
    结束
    返回 出
结束

# ---------- 报告 ----------
函数 百分比 部分 总 则
    如果 总 等于 0 则
        返回 0
    结束
    返回 向下取整(部分 * 10000 / 总) / 100
结束

函数 报告 名 源 长 则
    打印 "==== " + 名 + "  " + 文本(长) + " 字节 ===="
    将 平 变成 一维游程(源, 长)
    打印 "一维游程        " + 文本(缓冲长度(平)) + "   " + 文本(百分比(缓冲长度(平), 长)) + "%"
    将 甲一 变成 编码A(源, 长)
    打印 "逐层二维游程    " + 文本(缓冲长度(甲一)) + "   " + 文本(百分比(缓冲长度(甲一), 长)) + "%"
    将 回A 变成 解码A(甲一, 长)
    如果 全部相同(回A, 源, 长) 等于 1 则
        打印 "  解码校验      通过"
    否则
        打印 "  解码校验      失败"
    结束
    将 乙一 变成 编码B(源, 长)
    打印 "跨层异或+游程   " + 文本(缓冲长度(乙一)) + "   " + 文本(百分比(缓冲长度(乙一), 长)) + "%"
    将 回B 变成 解码B(乙一, 长)
    如果 全部相同(回B, 源, 长) 等于 1 则
        打印 "  解码校验      通过"
    否则
        打印 "  解码校验      失败"
    结束
    将 压缩块 变成 编码C(源, 长)
    打印 "整层去重+游程   " + 文本(缓冲长度(压缩块)) + "   " + 文本(百分比(缓冲长度(压缩块), 长)) + "%"
    将 回C 变成 解码C(压缩块, 长)
    如果 全部相同(回C, 源, 长) 等于 1 则
        打印 "  解码校验      通过"
    否则
        打印 "  解码校验      失败"
    结束
    将 丁一 变成 编码D(源, 长)
    打印 "层内左邻差分   " + 文本(缓冲长度(丁一)) + "   " + 文本(百分比(缓冲长度(丁一), 长)) + "%"
    将 回D 变成 解码D(丁一, 长)
    如果 全部相同(回D, 源, 长) 等于 1 则
        打印 "  解码校验      通过"
    否则
        打印 "  解码校验      失败"
    结束
    打印 ""
结束

将 合成图案数据 变成 合成图案(64)
写二进制("C:/Temp/叠层_图案.bin", 合成图案数据)
报告("合成二维图案 64层", 合成图案数据, 缓冲长度(合成图案数据))

将 合成叠层数据 变成 合成叠层(64)
写二进制("C:/Temp/叠层_相似.bin", 合成叠层数据)
报告("合成叠层相似 64层", 合成叠层数据, 缓冲长度(合成叠层数据))

将 文源 变成 读二进制("库/自举运行时.wen")
报告("源码 自举运行时.wen", 文源, 缓冲长度(文源))

如果 文件存在("C:/Temp/wen_selfhost/evalnat7.exe") 则
    将 程序 变成 读二进制("C:/Temp/wen_selfhost/evalnat7.exe")
    报告("PE 求值器", 程序, 缓冲长度(程序))
否则
    打印 "（跳过 PE 求值器：C:/Temp/wen_selfhost/evalnat7.exe 不存在）"
结束
