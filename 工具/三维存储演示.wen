# 三维存储演示：容量靠加层翻倍，老数据不动
# 512 → 1024 不是压缩出来的，是多一层格子出来的。

函数 新建面 行 列 则
    将 面 变成 []
    将 行号 变成 0
    当 行号 < 行 则
        将 线 变成 []
        将 列号 变成 0
        当 列号 < 列 则
            追加(线, 0)
            将 列号 变成 列号 + 1
        结束
        追加(面, 线)
        将 行号 变成 行号 + 1
    结束
    返回 面
结束

函数 新建三维存储 层数 行 列 则
    将 体 变成 []
    将 层 变成 0
    当 层 < 层数 则
        追加(体, 新建面(行, 列))
        将 层 变成 层 + 1
    结束
    返回 {"体": 体, "行": 行, "列": 列, "层数": 层数}
结束

函数 三维加层 存 则
    追加(存["体"], 新建面(存["行"], 存["列"]))
    将 存["层数"] 变成 存["层数"] + 1
结束

函数 三维容量 存 则
    返回 存["层数"] * 存["行"] * 存["列"]
结束

函数 三维存 存 层 行 列 值 则
    将 存["体"][层][行][列] 变成 值
结束

函数 三维取 存 层 行 列 则
    返回 存["体"][层][行][列]
结束

# 8×8 的底面 = 64 格
将 存 变成 新建三维存储(1, 8, 8)
打印 "底面 8×8，1 层 → 容量 " + 文本(三维容量(存)) + " 格"
三维存(存, 0, 2, 3, "甲")
三维存(存, 0, 7, 7, "丙")

三维加层(存)
打印 "加一层 → 容量 " + 文本(三维容量(存)) + " 格（翻倍，底面没变）"
三维存(存, 1, 0, 0, "乙")

打印 "第 0 层 (2,3) 仍是 " + 三维取(存, 0, 2, 3)
打印 "第 0 层 (7,7) 仍是 " + 三维取(存, 0, 7, 7)
打印 "第 1 层 (0,0) 新写 " + 三维取(存, 1, 0, 0)

将 层 变成 2
当 层 <= 6 则
    三维加层(存)
    将 层 变成 层 + 1
结束
打印 ""
打印 "叠到 " + 文本(存["层数"]) + " 层 → 容量 " + 文本(三维容量(存)) + " 格"
打印 "对比单层：" + 文本(三维容量(存) / 64) + " 倍"
打印 ""
打印 "结论：底面 8×8 不变，层数就是容量倍数；"
打印 "      代价是体积（层数倍）和寻址（多一个层坐标）。"
