(* 文语言 0.1 语法产生式（单一事实来源草案）
   目标：给解析器、文档、测试一个可独立审阅的规则表。
   说明：词法层的空白/换行/注释状态机单独定义；`存入 … 存入` 是预处理器，不在此文法内。 *)

程序        = { 语句 } ;
语句        = 赋值 | 复合赋值 | 函数定义 | 如果 | 当 | 对于 | 返回 | 中断 | 继续
            | 依赖 | 尝试 | 打印 | 表达式语句 ;

赋值        = "将" 标识符 "变成" 表达式 ;
复合赋值    = "将" 标识符 ( "+=" | "-=" | "*=" | "/=" | "//=" | "%=" | "**=" ) 表达式 ;
函数定义    = "函数" 标识符 { 标识符 } "则" { 语句 } "结束" ;
如果        = "如果" 表达式 "则" { 语句 }
              { "否则如果" 表达式 "则" { 语句 } }
              [ "否则" { 语句 } ] "结束" ;
当          = "当" 表达式 "则" { 语句 } "结束" ;
对于        = "对于" 标识符 [ "," 标识符 ] "在" 表达式 "中" "则" { 语句 } "结束" ;
返回        = "返回" [ 表达式 ] ;
尝试        = "尝试" { 语句 } [ "捕获" 标识符 { 语句 } ] [ "最终" { 语句 } ] "结束" ;
依赖        = "依赖" 标识符 { "," 标识符 } ;

表达式      = 或表达式 ;
或表达式    = 且表达式 { "或" 且表达式 } ;
且表达式    = 非表达式 { "且" 非表达式 } ;
非表达式    = [ "非" ] 比较表达式 ;
比较表达式  = 加法表达式 [ ( "==" | "=" | "!=" | "<" | "<=" | ">" | ">=" ) 加法表达式 ]
            | 加法表达式 "在" 加法表达式 "中" ;
加法表达式  = 乘法表达式 { ( "+" | "-" ) 乘法表达式 } ;
乘法表达式  = 一元表达式 { ( "*" | "/" | "//" | "%" ) 一元表达式 } ;
一元表达式  = [ "+" | "-" ] 幂表达式 | "√" 一元表达式 ;
幂表达式    = 后缀表达式 [ "**" 一元表达式 ] ;
后缀表达式  = 原子 { 调用后缀 | 索引后缀 | 上标后缀 | 单位后缀 | 并置后缀 } ;

调用后缀    = "(" [ 表达式 { "," 表达式 } [ "," ] ] ")" ;
索引后缀    = "[" 表达式 "]" ;
上标后缀    = "²" | "³" | "⁴" | … ;
单位后缀    = "°" ;
并置后缀    = 一元表达式 ;   (* 只吃一个一元表达式，故 加一 2 * 3 = (加一 2) * 3 *)

原子        = 数字 | 文本 | "真" | "假" | "空" | 标识符 | 列表 | 字典 | 集合 | "(" 表达式 ")" ;

注释        = "#" { 非换行字符 } 换行 ;
换行        = … ;  (* 括号深度为 0 时才是语句分隔符；深度大于 0 时可续行 *)

(* 已知边界，必须显式写在这里，不能假装不存在：
   1. 词法有状态：括号深度、连续空行、注释行；不是纯正则。
   2. 标识符在词法层按后缀拆：`甲的平方` 拆成 `甲` 与 `²`，所以 `的平方` 等不能做普通标识符。
   3. `存入 … 存入` 是预处理器，在词法/语法之前截走，不属于本产生式。
   4. 零参数函数“名字一出现就调用”是求值器规则，不是产生式；因此函数不是完全的一等值。
   5. 比较不能连写；并置调用只吃一个一元表达式。 *)

