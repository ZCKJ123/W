(* 文语言 0.1.0 语法产生式
   对应实现：wen.cpp 0.1.0
   本文件是语法唯一来源；改语法必须同时改本文件、解析器、用例。
   `存入 … 存入` 是预处理器，不在此文法内。 *)

程序        = { 语句 } ;
语句        = 赋值 | 复合赋值 | 函数定义 | 如果 | 当 | 对于 | 返回 | 中断 | 继续
            | 依赖 | 导出 | 尝试 | 打印 | 表达式语句 ;

赋值        = "将" 赋值目标 "变成" 表达式 ;
复合赋值    = "将" 赋值目标 ( "+=" | "-=" | "*=" | "/=" | "//=" | "%=" | "**=" ) 表达式 ;
赋值目标    = 标识符 | 索引目标 ;
索引目标    = 标识符 "[" 表达式 "]" ;

函数定义    = "函数" 标识符 { 标识符 } "则" { 语句 } "结束" ;
如果        = "如果" 表达式 "则" { 语句 }
              { "否则如果" 表达式 "则" { 语句 } }
              [ "否则" { 语句 } ] "结束" ;
当          = "当" 表达式 "则" { 语句 } "结束" ;
对于        = "对于" 标识符 [ "," 标识符 ] "在" 表达式 "中" "则" { 语句 } "结束" ;
返回        = "返回" [ 表达式 ] ;
尝试        = "尝试" { 语句 } [ "捕获" 标识符 { 语句 } ] [ "最终" { 语句 } ] "结束" ;
依赖        = "依赖" 标识符 { "," 标识符 } ;
导出        = "导出" 标识符 { "," 标识符 } ;
打印        = "打印" 表达式 { "," 表达式 } ;

表达式      = 或表达式 ;
或表达式    = 且表达式 { "或" 且表达式 } ;
且表达式    = 非表达式 { "且" 非表达式 } ;
非表达式    = [ "非" ] 比较表达式 ;
比较表达式  = 加法表达式 [ 比较算子 加法表达式 ]
            | 加法表达式 "在" 加法表达式 "中" ;
加法表达式  = 乘法表达式 { ( "+" | "-" | "加" | "减" ) 乘法表达式 } ;
乘法表达式  = 一元表达式 { ( "*" | "/" | "//" | "%" | "乘" | "除以" ) 一元表达式 } ;
一元表达式  = [ "+" | "-" ] 幂表达式 | "√" 一元表达式 ;
幂表达式    = 后缀表达式 [ "**" 一元表达式 ] ;
后缀表达式  = 原子 { 调用后缀 | 索引后缀 | 上标后缀 | 角度后缀 | 并置后缀 } ;

调用后缀    = "(" [ 表达式 { "," 表达式 } [ "," ] ] ")" ;
索引后缀    = "[" ( 表达式 | 切片 ) "]" ;
切片        = [ 表达式 ] ":" [ 表达式 ] [ ":" [ 表达式 ] ] ;
上标后缀    = "²" | "³" | "⁴" | "⁵" | "⁶" | "⁷" | "⁸" | "⁹" ;
角度后缀    = "°" ;
并置后缀    = 一元表达式 ;

原子        = 数字 | 文本 | 插值文本 | "真" | "假" | "空" | 标识符
            | 列表 | 字典 | 集合 | "(" 表达式 ")" ;
列表        = "[" [ 表达式 { "," 表达式 } [ "," ] ] "]" ;
字典        = "{" [ 表达式 ":" 表达式 { "," 表达式 ":" 表达式 } [ "," ] ] "}" ;
集合        = "集合" "(" [ 表达式 { "," 表达式 } [ "," ] ] ")" ;

文本        = '"' { 字符 | 转义 } '"' | '“' { 字符 } '”' | '「' { 字符 } '」' ;
插值文本    = 'f"' { 字符 | 转义 | "{" 表达式 "}" } '"' ;
转义        = "\\" | '\"' | "\'" ;
比较算子    = "==" | "=" | "!=" | "<" | "<=" | ">" | ">=" ;
表达式语句  = 表达式 ;

(* 词法 *)
标识符      = 标识符首字符 { 标识符字符 } ;
标识符首字符 = 字母 | 汉字 | "_" ;
标识符字符  = 标识符首字符 | 数字字符 ;
字母        = ? A-Z a-z ? ;
汉字        = ? U+4E00..U+9FFF 及扩展区汉字 ? ;
数字字符    = ? 0-9 ? ;
数字        = 十进制数 [ 指数 ] | "0x" 十六进制数 | "0b" 二进制数 ;
十进制数    = ? 0-9 { 0-9 } [ "." { 0-9 } ] ? ;
指数        = ( "e" | "E" ) [ "+" | "-" ] 十进制数 ;
十六进制数  = ? 0-9 A-F a-f { 0-9 A-F a-f } ? ;
二进制数    = ? 0-1 { 0-1 } ? ;
字符        = ? 除换行、引号、反斜杠外的任意 Unicode 字符 ? ;

(* 语义约束，不写进产生式但必须遵守：
   1. 零参数函数在值位置是函数值；调用必须写 ()。
   2. 并置调用只允许作为独立值；直接和二元运算符混写是语法错误。
   3. 字典键必须是文本。
   4. 索引、切片、长度、查找都按 Unicode 字符计，不按字节。
   5. 查找字节 是唯一的字节偏移入口。
   6. 文本转义只认 \\、\"、\'；其他反斜杠保留字面。 *)
