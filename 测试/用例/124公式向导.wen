依赖 公式库
依赖 体库
依赖 体算法
依赖 数学库
# 公式向导：模板 → SDF 场 → 采样/等值面
将 场 变成 公式场(41, 公式向导("球", [20, 20, 20, 10]))
打印 "球场中心 " + 格式化(体采样(场, 20, 20, 20)["值"], 1)
打印 "球场外面 " + 格式化(体采样(场, 20, 20, 35)["值"], 1)
将 网 变成 SDF等值面(场)
打印 "球面数 > 0 " + 文本(网["面数"] > 0)
将 环 变成 公式场(41, 公式向导("环", [20, 20, 20, 12, 4]))
打印 "环上点 " + 文本(体采样(环, 20, 20, 32)["值"] < 0)
打印 "环心 " + 文本(体采样(环, 20, 20, 20)["值"] > 0)
将 盒 变成 公式场(41, 公式向导("盒", [20, 20, 20, 8, 5, 12]))
打印 "盒心 " + 文本(体采样(盒, 20, 20, 20)["值"] < 0)
打印 "盒角外 " + 文本(体采样(盒, 20, 20, 35)["值"] > 0)
将 柱 变成 公式场(41, 公式向导("柱", [20, 20, 20, 6, 12]))
打印 "柱心 " + 文本(体采样(柱, 20, 20, 20)["值"] < 0)
将 面 变成 公式场(21, 公式向导("面", [10, 10, 10, 0, 0, 1]))
打印 "面下层 " + 文本(体采样(面, 5, 10, 10)["值"] < 0)
打印 "面上层 " + 文本(体采样(面, 15, 10, 10)["值"] > 0)
将 波 变成 公式场(21, 公式向导("波", [2, 5, 0]))
打印 "波有起伏 " + 文本(绝对值(体采样(波, 10, 0, 0)["值"] - 体采样(波, 10, 0, 5)["值"]) > 0)
# 同一个模板也能直接填体
将 体 变成 体新建(21, 21, 21)
体按公式(体, 公式向导("球", [10, 10, 10, 6]), 200, 0)
打印 "填体格数 " + 文本(体计数(体))
# 高斯核当卷积公式
将 核 变成 体卷积公式(体, 1, 公式向导("高斯", [1]))
打印 "高斯核可用 " + 文本(体总和(核) > 0)
