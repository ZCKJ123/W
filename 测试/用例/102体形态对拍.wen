依赖 文件库
依赖 体库
依赖 体算法

# 形态 / 布尔 / 沿轴 的对拍：手写集合运算去核对内建
# 每条打印「名字 差异数」，期望全是 0
函数 值 l r c 则
    返回 (l * 31 + r * 17 + c * 13) % 200
结束

函数 造 则
    将 体 变成 体新建(6, 6, 6)
    将 l 变成 0
    当 l < 6 则
        将 r 变成 0
        当 r < 6 则
            将 c 变成 0
            当 c < 6 则
                体写(体, l, r, c, 值(l, r, c))
                将 c 变成 c + 1
            结束
            将 r 变成 r + 1
        结束
        将 l 变成 l + 1
    结束
    返回 体
结束

函数 实 体 l r c 则
    如果 l < 0 或 r < 0 或 c < 0 或 l >= 6 或 r >= 6 或 c >= 6 则
        返回 假
    结束
    返回 体读(体, l, r, c) > 0
结束

# 手算膨胀：自己或 6 邻居任何一个为实
函数 手膨胀 体 则
    将 出 变成 体新建(6, 6, 6)
    将 l 变成 0
    当 l < 6 则
        将 r 变成 0
        当 r < 6 则
            将 c 变成 0
            当 c < 6 则
                将 实心 变成 实(体, l, r, c)
                如果 实(体, l + 1, r, c) 或 实(体, l - 1, r, c) 或 实(体, l, r + 1, c) 或 实(体, l, r - 1, c) 或 实(体, l, r, c + 1) 或 实(体, l, r, c - 1) 则
                    将 实心 变成 真
                结束
                如果 实心 则
                    体写(出, l, r, c, 100)
                结束
                将 c 变成 c + 1
            结束
            将 r 变成 r + 1
        结束
        将 l 变成 l + 1
    结束
    返回 出
结束

# 手算腐蚀：自己和 6 邻居都为实
函数 手腐蚀 体 则
    将 出 变成 体新建(6, 6, 6)
    将 l 变成 0
    当 l < 6 则
        将 r 变成 0
        当 r < 6 则
            将 c 变成 0
            当 c < 6 则
                将 全实 变成 实(体, l, r, c)
                如果 非 实(体, l + 1, r, c) 或 非 实(体, l - 1, r, c) 或 非 实(体, l, r + 1, c) 或 非 实(体, l, r - 1, c) 或 非 实(体, l, r, c + 1) 或 非 实(体, l, r, c - 1) 则
                    将 全实 变成 假
                结束
                如果 全实 则
                    体写(出, l, r, c, 100)
                结束
                将 c 变成 c + 1
            结束
            将 r 变成 r + 1
        结束
        将 l 变成 l + 1
    结束
    返回 出
结束

函数 手并 甲 乙 则
    将 出 变成 体新建(6, 6, 6)
    将 l 变成 0
    当 l < 6 则
        将 r 变成 0
        当 r < 6 则
            将 c 变成 0
            当 c < 6 则
                如果 实(甲, l, r, c) 或 实(乙, l, r, c) 则
                    体写(出, l, r, c, 100)
                结束
                将 c 变成 c + 1
            结束
            将 r 变成 r + 1
        结束
        将 l 变成 l + 1
    结束
    返回 出
结束

函数 手差 甲 乙 则
    将 出 变成 体新建(6, 6, 6)
    将 l 变成 0
    当 l < 6 则
        将 r 变成 0
        当 r < 6 则
            将 c 变成 0
            当 c < 6 则
                如果 实(甲, l, r, c) 且 非 实(乙, l, r, c) 则
                    体写(出, l, r, c, 100)
                结束
                将 c 变成 c + 1
            结束
            将 r 变成 r + 1
        结束
        将 l 变成 l + 1
    结束
    返回 出
结束

函数 逐格差 甲 乙 则
    将 差 变成 0
    将 l 变成 0
    当 l < 6 则
        将 r 变成 0
        当 r < 6 则
            将 c 变成 0
            当 c < 6 则
                将 甲有 变成 体读(甲, l, r, c) > 0
                将 乙有 变成 体读(乙, l, r, c) > 0
                如果 甲有 不等于 乙有 则
                    将 差 变成 差 + 1
                结束
                将 c 变成 c + 1
            结束
            将 r 变成 r + 1
        结束
        将 l 变成 l + 1
    结束
    返回 差
结束

将 甲 变成 造()
将 乙 变成 体新建(6, 6, 6)
体写(乙, 2, 2, 2, 150)
体写(乙, 3, 3, 3, 150)

打印 "膨胀差异 " + 文本(逐格差(手膨胀(甲), 体形态(甲, 1, 1)))
打印 "腐蚀差异 " + 文本(逐格差(手腐蚀(甲), 体形态(甲, 1, 0)))
打印 "并差异 " + 文本(逐格差(手并(甲, 乙), 体布尔(甲, 乙, 0)))
打印 "交差异 " + 文本(逐格差(乙, 体布尔(甲, 乙, 1)))
打印 "差差异 " + 文本(逐格差(手差(甲, 乙), 体布尔(甲, 乙, 2)))

# 沿轴取最大：手算每列 (i, j) 上的最大值，和内建返回的缓冲逐字节比
将 小 变成 体新建(6, 6, 6)
将 l 变成 0
当 l < 6 则
    将 r 变成 0
    当 r < 6 则
        将 c 变成 0
        当 c < 6 则
            体写(小, l, r, c, (l * 40 + r * 7 + c * 3) % 250)
            将 c 变成 c + 1
        结束
        将 r 变成 r + 1
    结束
    将 l 变成 l + 1
结束
将 机 变成 体沿轴(小, 2, 1)
将 差2 变成 0
将 i 变成 0
当 i < 6 则
    将 j 变成 0
    当 j < 6 则
        将 手大 变成 0
        将 c 变成 0
        当 c < 6 则
            将 值 变成 体读(小, i, j, c)
            如果 值 > 手大 则
                将 手大 变成 值
            结束
            将 c 变成 c + 1
        结束
        如果 缓冲读(机, i * 6 + j) 不等于 手大 则
            将 差2 变成 差2 + 1
        结束
        将 j 变成 j + 1
    结束
    将 i 变成 i + 1
结束
打印 "沿轴最大差异 " + 文本(差2)