依赖 渲染库, 文件库
将 面 变成 新建面([[0, 0], [10, 0], [10, 10], [0, 10]])
打印 面["面积"], 面["中心"]
涂鸦("例子/_渲染-涂鸦.svg", 面, 8, "螺旋")
渐变("例子/_渲染-渐变.svg", 面, "#ff8800", "#0066ff", "横")
体积光2D("例子/_渲染-雾2D.svg", 面, 5, 5, 0.6)
体积光3D("例子/_渲染-雾3D.svg", 面, 5, 5, 0.7)
打印 文件存在 "例子/_渲染-涂鸦.svg", 文件存在 "例子/_渲染-雾3D.svg"
删除文件 "例子/_渲染-涂鸦.svg"
删除文件 "例子/_渲染-渐变.svg"
删除文件 "例子/_渲染-雾2D.svg"
删除文件 "例子/_渲染-雾3D.svg"
