(* 文语言 0.2 文法（提案，未实现）
   与 0.1 的差别：
   - 调用只允许显式 ()；零参数函数不再“名字出现即调用”
   - √ ° ² ³ 是核心 AST 节点，不是库函数调用
   - 并置调用保留，但不能直接和二元运算符混写
   - 关键字、算子、文法各只有一份来源
*)

程序        = { 语句 } ;
语句        = 赋值 | 复合赋值 | 函数定义 | 如果 | 当 | 对于 | 返回 | 中断 | 继续
            | 依赖 | 尝试 | 打印 | 表达式语句 ;

赋值        = "将" 标识符 "变成" 表达式 ;
复合赋值    = "将" 标识符 ( "+=" | "-=" | "*=" | "/=" | "//=" | "%=" | "**=" ) 表达式 ;
函数定义    = "函数" 标识符 { 标识符 } "则" { 语句 } "结束" ;
如果        = "如果" 表达式 "则" { 语句 }
              { "否则如果" 表达式 "则" { 语句 } }
              [ "否则" { 语句 } ] "结束" ;
当          = "当" 表达式 "则" { 语句 } "结束" ;
对于        = "对于" 标识符 [ "," 标识符 ] "在" 表达式 "中" "则" { 语句 } "结束" ;
返回        = "返回" [ 表达式 ] ;
尝试        = "尝试" { 语句 } [ "捕获" 标识符 { 语句 } ] [ "最终" { 语句 } ] "结束" ;
依赖        = "依赖" 标识符 { "," 标识符 } ;

表达式      = 或表达式 ;
或表达式    = 且表达式 { "或" 且表达式 } ;
且表达式    = 非表达式 { "且" 非表达式 } ;
非表达式    = [ "非" ] 比较表达式 ;
比较表达式  = 加法表达式 [ 比较算子 加法表达式 ]
            | 加法表达式 "在" 加法表达式 "中" ;
加法表达式  = 乘法表达式 { ( "+" | "-" | "加" | "减" ) 乘法表达式 } ;
乘法表达式  = 一元表达式 { ( "*" | "/" | "//" | "%" | "乘" | "除以" ) 一元表达式 } ;
一元表达式  = [ "+" | "-" ] 幂表达式 | "√" 一元表达式 ;
幂表达式    = 后缀表达式 [ "**" 一元表达式 ] ;
后缀表达式  = 原子 { 调用后缀 | 索引后缀 | 上标后缀 | 角度后缀 } ;

调用后缀    = "(" [ 表达式 { "," 表达式 } [ "," ] ] ")" ;
索引后缀    = "[" 表达式 "]" ;
上标后缀    = "²" | "³" | "⁴" | "⁵" | "⁶" | "⁷" | "⁸" | "⁹" ;
角度后缀    = "°" ;
并置调用    = 标识符 后缀表达式 ;   (* 只允许作为独立值；不能直接做二元运算的操作数 *)

原子        = 数字 | 文本 | "真" | "假" | "空" | 标识符 | 列表 | 字典 | 集合 | "(" 表达式 ")" ;

比较算子    = "==" | "=" | "!=" | "<" | "<=" | ">" | ">=" ;

(* 显式边界：
   1. 关键字、算子、文法以 0.2/关键字表.json、0.2/算子表.json、本文件为准。
   2. `存入 … 存入` 是预处理器，不属于本产生式；它的指令边界必须显式：`存入` 后接空白或行尾。
   3. 词法后缀拆词是词法规则，不在此产生式内。 *)
