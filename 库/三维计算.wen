# 三维计算：把「造形 → 变换 → 布尔 → 测量 → 网格 → 导出」串成一条链
# 全部用公式和体积算子做，没有渲染参与；测量值都是算出来的，不是估的

依赖 公式库
依赖 公式代数
依赖 体库
依赖 体算法
依赖 数学库

# ---------- 造形 ----------
函数 三维造球 边长 心 半径 则
    局部 体 变成 体新建(边长, 边长, 边长)
    体按公式(体, 公式向导("球", [心, 心, 心, 半径]), 255, 0)
    返回 体
结束

函数 三维造盒 边长 心 半长 半高 半深 则
    局部 体 变成 体新建(边长, 边长, 边长)
    体按公式(体, 公式向导("盒", [心, 心, 心, 半长, 半高, 半深]), 255, 0)
    返回 体
结束

函数 三维造环 边长 心 大半径 管半径 则
    局部 体 变成 体新建(边长, 边长, 边长)
    体按公式(体, 公式向导("环", [心, 心, 心, 大半径, 管半径]), 255, 0)
    返回 体
结束

函数 三维造柱 边长 心 半径 半高 则
    局部 体 变成 体新建(边长, 边长, 边长)
    体按公式(体, 公式向导("柱", [心, 心, 心, 半径, 半高]), 255, 0)
    返回 体
结束

# ---------- 布尔 ----------
函数 三维并 甲 乙 则
    返回 体布尔(甲, 乙, 0)
结束

函数 三维交 甲 乙 则
    返回 体布尔(甲, 乙, 1)
结束

函数 三维差 甲 乙 则
    返回 体布尔(甲, 乙, 2)
结束

# ---------- 变换 ----------
函数 三维移 体 层移 行移 列移 则
    返回 体平移(体, 层移, 行移, 列移)
结束

函数 三维缩放 体 倍率 则
    局部 新层 变成 最大(1, 向下取整(体宽(体) * 倍率))
    局部 新行 变成 最大(1, 向下取整(体高(体) * 倍率))
    局部 新列 变成 最大(1, 向下取整(体深(体) * 倍率))
    返回 体缩放(体, 新层, 新行, 新列)
结束

# ---------- 测量 ----------
函数 三维测量 体 则
    局部 惯 变成 体惯性(体)
    局部 盒 变成 体包围盒(体)
    局部 质 变成 体质心(体)
    局部 果 变成 {}
    将 果["格数"] 变成 体计数(体)
    将 果["包围盒"] 变成 盒
    将 果["质心"] 变成 质
    将 果["表面积"] 变成 体表面积(体)
    将 果["主惯量"] 变成 惯["主惯量"]
    将 果["质量"] 变成 惯["质量"]
    返回 果
结束

函数 三维报告 体 则
    局部 测 变成 三维测量(体)
    局部 质 变成 测["质心"]
    局部 主 变成 测["主惯量"]
    局部 前半 变成 "格数 " + 文本(测["格数"]) + "｜质心 " + 格式化(质["层"], 1) + "," + 格式化(质["行"], 1) + "," + 格式化(质["列"], 1)
    局部 后半 变成 "｜表面积 " + 格式化(测["表面积"], 1) + "｜主惯量 " + 格式化(主[0], 1) + "," + 格式化(主[1], 1) + "," + 格式化(主[2], 1)
    返回 前半 + 后半
结束

# ---------- 网格与导出 ----------
函数 三维网格 体 则
    返回 体等值面(体, 1)
结束

函数 三维导出 体 前缀 则
    局部 网 变成 三维网格(体)
    网格存OBJ(网, 前缀 + ".obj")
    网格存STL(网, 前缀 + ".stl")
    返回 {"前缀": 前缀, "点数": 网["点数"], "面数": 网["面数"]}
结束

# ---------- 图片 → 高度 → 三维 ----------
# 一张照片的高度：亮度定高（r*0.30 + g*0.59 + b*0.11），像素颜色跟着填进体里。
# 体是「层=高、行=图片高、列=图片宽」，所以 三维网格(体) 出来的就是浮雕地形。
函数 高度图从图片 路径 则
    局部 图 变成 图像读PNG(路径)
    返回 {"宽": 图["宽"], "高": 图["高"], "像素": 图["像素"], "通道": 图["通道"]}
结束

函数 体从图片 路径 高 则
    返回 体从图片缩放(路径, 高, 0)
结束

# 大照片放不进 1 亿格时，用「最大宽」把图按整数步长抽稀：1920 宽 + 最大宽 600 就是每 4 列取 1 列。
# 最大宽传 0 表示不抽稀（原图尺寸）。
函数 体从图片缩放 路径 高 最大宽 则
    局部 图 变成 图像读PNG(路径)
    局部 宽 变成 图["宽"]
    局部 行 变成 图["高"]
    局部 步 变成 1
    如果 最大宽 > 0 且 宽 > 最大宽 则
        将 步 变成 宽 // 最大宽
        如果 步 < 1 则
            将 步 变成 1
        结束
        如果 宽 % 最大宽 != 0 则
            将 步 变成 步 + 1
        结束
    结束
    局部 列数 变成 (宽 + 步 - 1) // 步
    局部 行数 变成 (行 + 步 - 1) // 步
    局部 格 变成 列数 * 行数 * 高
    如果 格 > 100000000 则
        抛出("体从图片：按最大宽 " + 文本(最大宽) + " 抽稀后仍要 " + 文本(格) + " 格（约 " + 文本(格 * 3 / 1048576) + " MB），超过 1 亿格上限；再调小最大宽或高度")
    结束
    局部 源 变成 图["像素"]
    局部 新 变成 新建缓冲(列数 * 行数 * 3)
    局部 序号 变成 0
    局部 行号 变成 0
    当 行号 < 行数 则
        局部 原行 变成 行号 * 步
        如果 原行 >= 行 则
            局部 原行 变成 行 - 1
        结束
        局部 列号 变成 0
        当 列号 < 列数 则
            局部 原列 变成 列号 * 步
            如果 原列 >= 宽 则
                局部 原列 变成 宽 - 1
            结束
            局部 起点 变成 (原行 * 宽 + 原列) * 3
            缓冲写(新, 序号, 缓冲读(源, 起点))
            缓冲写(新, 序号 + 1, 缓冲读(源, 起点 + 1))
            缓冲写(新, 序号 + 2, 缓冲读(源, 起点 + 2))
            将 序号 变成 序号 + 3
            将 列号 变成 列号 + 1
        结束
        将 行号 变成 行号 + 1
    结束
    局部 体 变成 体新建彩色(高, 行数, 列数)
    体彩高度场(体, 新, 行数, 列数)
    返回 体
结束
# ---------- 视频 → 体 ----------
# 等间隔抽帧，每帧抽稀后叠成一层（层号 = 帧序号），返回彩色体。
# 一次只持有一帧，不按 帧数×宽×高 预申请，所以 2K/4K 也不会炸。
函数 体从视频 路径 层数 最大宽 则
    局部 信 变成 视频信息(路径)
    局部 宽 变成 信["宽"]
    局部 行 变成 信["高"]
    局部 总帧 变成 信["帧数"]
    如果 层数 > 总帧 且 总帧 > 0 则
        将 层数 变成 总帧
    结束
    如果 层数 < 1 则
        将 层数 变成 1
    结束
    局部 间隔 变成 1
    如果 总帧 >= 层数 * 2 则
        将 间隔 变成 总帧 // 层数
    结束
    局部 步 变成 1
    如果 最大宽 > 0 且 宽 > 最大宽 则
        将 步 变成 宽 // 最大宽
        如果 步 < 1 则
            将 步 变成 1
        结束
        如果 宽 % 最大宽 != 0 则
            将 步 变成 步 + 1
        结束
    结束
    局部 列数 变成 (宽 + 步 - 1) // 步
    局部 行数 变成 (行 + 步 - 1) // 步
    局部 格 变成 列数 * 行数 * 层数
    如果 格 > 100000000 则
        抛出("体从视频：" + 文本(层数) + " 层 " + 文本(列数) + "x" + 文本(行数) + " 要 " + 文本(格) + " 格（约 " + 文本(格 * 3 / 1048576) + " MB），超过 1 亿格上限；调小最大宽或层数")
    结束
    局部 体 变成 体新建彩色(层数, 行数, 列数)
    局部 层号 变成 0
    当 层号 < 层数 则
        局部 图 变成 视频帧(路径, 层号 * 间隔)
        局部 像 变成 图["像素"]
        局部 行号 变成 0
        当 行号 < 行数 则
            局部 原行 变成 行号 * 步
            如果 原行 >= 行 则
                将 原行 变成 行 - 1
            结束
            局部 列号 变成 0
            当 列号 < 列数 则
                局部 原列 变成 列号 * 步
                如果 原列 >= 宽 则
                    将 原列 变成 宽 - 1
                结束
                局部 起点 变成 (原行 * 宽 + 原列) * 3
                体彩写(体, 层号, 行号, 列号, 缓冲读(像, 起点), 缓冲读(像, 起点 + 1), 缓冲读(像, 起点 + 2))
                将 列号 变成 列号 + 1
            结束
            将 行号 变成 行号 + 1
        结束
        将 层号 变成 层号 + 1
    结束
    返回 体
结束
# ---------- 视频 → 体（顺序读，不跳转）----------
# 一次打开解码器，顺序读完全片，每 间隔 帧取一帧写一层。
# 每帧只持有一帧内存；层与层顺序写入，不需要多线程也不会慢。
函数 体从视频 路径 层数 最大宽 则
    局部 信 变成 视频信息(路径)
    局部 总帧 变成 信["帧数"]
    如果 层数 < 1 则
        将 层数 变成 1
    结束
    如果 总帧 > 0 且 层数 > 总帧 则
        将 层数 变成 总帧
    结束
    局部 间隔 变成 1
    如果 层数 > 0 则
        将 间隔 变成 总帧 // 层数
    结束
    如果 间隔 < 1 则
        将 间隔 变成 1
    结束
    局部 句 变成 视频打开(路径, 最大宽, 1)
    局部 首 变成 视频取帧(句, -1)
    局部 宽 变成 首["宽"]
    局部 行 变成 首["高"]
    局部 格 变成 宽 * 行 * 层数
    如果 格 > 100000000 则
        视频关闭(句)
        抛出("体从视频：" + 文本(层数) + " 层 " + 文本(宽) + "x" + 文本(行) + " 要 " + 文本(格) + " 格（约 " + 文本(格 * 3 / 1048576) + " MB），超过 1 亿格上限；调小最大宽或层数")
    结束
    局部 体 变成 体新建彩色(层数, 行, 宽)
    体写图(体, 0, 首["像素"], 行, 宽)
    局部 层 变成 1
    局部 帧 变成 1
    当 层 < 层数 则
        局部 像 变成 视频取帧(句, -1)
        如果 帧 % 间隔 == 0 则
            体写图(体, 层, 像["像素"], 行, 宽)
            将 层 变成 层 + 1
        结束
        将 帧 变成 帧 + 1
    结束
    视频关闭(句)
    返回 体
结束
# ---------- 单张图 → 深度 → 三维模型 ----------
# 三条线索加权：地面先验（越靠下越近）、局部对比度（越清楚越近）、
# 空气透视（越蓝越亮越灰 = 越远）。不依赖任何模型文件，纯算出来。
函数 图片三维 路径 高度 则
    局部 图 变成 图像读PNG(路径)
    局部 深 变成 深度图(图["像素"], 图["宽"], 图["高"])
    返回 体从深度(深, 高度)
结束

函数 视频帧三维 路径 帧号 高度 最大宽 则
    局部 句 变成 视频打开(路径, 最大宽, 1)
    局部 图 变成 视频取帧(句, 帧号)
    视频关闭(句)
    局部 深 变成 深度图(图["像素"], 图["宽"], 图["高"])
    返回 体从深度(深, 高度)
结束
# 由明暗（光影）反推高度：亮度梯度 → 法线斜率 → 泊松积分成高度场 → 体积
# 适合有明确光照方向的照片（日照、灯照、浮雕、地形）；迭代次数越高越平滑。
函数 图片浮雕 路径 高度 则
    局部 图 变成 图像读PNG(路径)
    局部 深 变成 明暗高度(图["像素"], 图["宽"], 图["高"], 300)
    返回 体从深度(深, 高度)
结束

函数 视频帧浮雕 路径 帧号 高度 最大宽 则
    局部 句 变成 视频打开(路径, 最大宽, 1)
    局部 图 变成 视频取帧(句, 帧号)
    视频关闭(句)
    局部 深 变成 明暗高度(图["像素"], 图["宽"], 图["高"], 300)
    返回 体从深度(深, 高度)
结束
# 三条线索合成一张高度图：明暗（坡度）、阴影（影长×tanθ）、远近（地面+纹理+空气）
# 单条都会在某类图上翻车，合成后稳得多。
函数 图片综合浮雕 路径 高度 则
    局部 图 变成 图像读PNG(路径)
    局部 宽 变成 图["宽"]
    局部 行 变成 图["高"]
    局部 亮 变成 明暗高度(图["像素"], 宽, 行, 300)
    局部 影 变成 阴影高度(图["像素"], 宽, 行, 45)
    局部 远 变成 深度图(图["像素"], 宽, 行)
    局部 合 变成 新建缓冲(宽 * 行)
    局部 序 变成 0
    当 序 < 宽 * 行 则
        局部 值 变成 (缓冲读(亮["深度"], 序) + 缓冲读(影["深度"], 序) + 缓冲读(远["深度"], 序)) // 3
        缓冲写(合, 序, 值)
        将 序 变成 序 + 1
    结束
    返回 体从深度({"宽": 宽, "高": 行, "深度": 合, "像素": 图["像素"]}, 高度)
结束