依赖 自举运行时
依赖 自举运行时

函数 写16 缓冲 偏移 值 则
    缓冲写(缓冲, 偏移, 值 % 256)
    缓冲写(缓冲, 偏移 + 1, 向下取整(值 / 256) % 256)
    返回 偏移 + 2
结束

函数 写32 缓冲 偏移 值 则
    缓冲写(缓冲, 偏移, 值 % 256)
    缓冲写(缓冲, 偏移 + 1, 向下取整(值 / 256) % 256)
    缓冲写(缓冲, 偏移 + 2, 向下取整(值 / 65536) % 256)
    缓冲写(缓冲, 偏移 + 3, 向下取整(值 / 16777216) % 256)
    返回 偏移 + 4
结束

函数 写64 缓冲 偏移 值 则
    写32(缓冲, 偏移, 值 % 4294967296)
    写32(缓冲, 偏移 + 4, 向下取整(值 / 4294967296))
    返回 偏移 + 8
结束

函数 写表 缓冲 基 表 则
    将 位 变成 基
    对于 项 在 表 中 则
        缓冲写(缓冲, 位, 项)
        将 位 变成 位 + 1
    结束
    返回 位
结束

函数 发 缓冲 位 值 则
    缓冲写(缓冲, 位, 值)
    返回 位 + 1
结束

函数 调 缓冲 位 目标 则
    将 位 变成 发(缓冲, 位, 0xFF)
    将 位 变成 发(缓冲, 位, 0x15)
    写32(缓冲, 位, 目标 - (0xC00 + 位 + 4))
    返回 位 + 4
结束

函数 跳 缓冲 位 目标 则
    将 位 变成 发(缓冲, 位, 0xE9)
    写32(缓冲, 位, 目标 - (0xC00 + 位 + 4))
    返回 位 + 4
结束

函数 栈64 缓冲 位 偏移 值 则
    将 位 变成 发(缓冲, 位, 0x48)
    将 位 变成 发(缓冲, 位, 0xC7)
    将 位 变成 发(缓冲, 位, 0x44)
    将 位 变成 发(缓冲, 位, 0x24)
    将 位 变成 发(缓冲, 位, 偏移)
    写32(缓冲, 位, 值)
    返回 位 + 4
结束

函数 串址 缓冲 位 寄存器 目标 则
    将 位 变成 发(缓冲, 位, 寄存器)
    将 位 变成 发(缓冲, 位, 0x8D)
    将 位 变成 发(缓冲, 位, 0x15)
    写32(缓冲, 位, 目标 - (0xC00 + 位 + 4))
    返回 位 + 4
结束

函数 串址八 缓冲 位 目标 则
    将 位 变成 发(缓冲, 位, 0x4C)
    将 位 变成 发(缓冲, 位, 0x8D)
    将 位 变成 发(缓冲, 位, 0x05)
    写32(缓冲, 位, 目标 - (0xC00 + 位 + 4))
    返回 位 + 4
结束

函数 串址九 缓冲 位 目标 则
    将 位 变成 发(缓冲, 位, 0x4C)
    将 位 变成 发(缓冲, 位, 0x8D)
    将 位 变成 发(缓冲, 位, 0x0D)
    写32(缓冲, 位, 目标 - (0xC00 + 位 + 4))
    返回 位 + 4
结束

函数 存到 缓冲 位 偏移 则
    将 位 变成 发(缓冲, 位, 0x48)
    将 位 变成 发(缓冲, 位, 0x89)
    将 位 变成 发(缓冲, 位, 0x44)
    将 位 变成 发(缓冲, 位, 0x24)
    将 位 变成 发(缓冲, 位, 偏移)
    返回 位 + 1
结束

函数 取到 缓冲 位 寄存器 偏移 则
    将 位 变成 发(缓冲, 位, 0x48)
    将 位 变成 发(缓冲, 位, 0x8B)
    将 位 变成 发(缓冲, 位, 寄存器)
    将 位 变成 发(缓冲, 位, 0x44)
    将 位 变成 发(缓冲, 位, 0x24)
    将 位 变成 发(缓冲, 位, 偏移)
    返回 位 + 1
结束

