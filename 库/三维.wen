# 三维：统一入口，调用方不用关心底层是稠密体还是分块体
# 小体积自动用稠密（连续缓冲），大体积自动用分块（32³ 稀疏块）
#
# 用法：
#   将 卷 变成 新建三维(256, 256, 256)
#   三维写(卷, 层, 行, 列, 255)
#   三维读(卷, 层, 行, 列)
#   打印 三维统计(卷)

依赖 文件库
依赖 数学库
依赖 哈希库
依赖 体数据
依赖 分块体

将 稠密上限 变成 262144

函数 新建三维 层 行 列 则
    局部 总 变成 层 * 行 * 列
    如果 总 <= 稠密上限 则
        返回 {"型": "稠密", "体": 新建体(层, 行, 列), "层数": 层, "行数": 行, "列数": 列, "总格": 总}
    结束
    返回 {"型": "分块", "体": 新建分块体(层, 行, 列, 32), "层数": 层, "行数": 行, "列数": 列, "总格": 总}
结束

函数 三维写 卷 层 行 列 值 则
    如果 卷["型"] 等于 "稠密" 则
        体设(卷["体"], 层, 行, 列, 值)
        返回 1
    结束
    体写(卷["体"], 层, 行, 列, 值)
    返回 1
结束

函数 三维读 卷 层 行 列 则
    如果 层 < 0 则
        返回 0
    结束
    如果 行 < 0 则
        返回 0
    结束
    如果 列 < 0 则
        返回 0
    结束
    如果 层 >= 卷["层数"] 则
        返回 0
    结束
    如果 行 >= 卷["行数"] 则
        返回 0
    结束
    如果 列 >= 卷["列数"] 则
        返回 0
    结束
    如果 卷["型"] 等于 "稠密" 则
        返回 体取(卷["体"], 层, 行, 列)
    结束
    返回 体读(卷["体"], 层, 行, 列)
结束

函数 三维统计 卷 则
    如果 卷["型"] 等于 "稠密" 则
        局部 统 变成 体统计(卷["体"])
        局部 物理 变成 卷["总格"] + 8
        返回 {"型": "稠密", "总格": 统["格数"], "非零": 统["非零"], "物理字节": 物理, "倍数": 卷["总格"] / 物理, "最小": 统["最小"], "最大": 统["最大"]}
    结束
    局部 统2 变成 分块统计(卷["体"])
    返回 {"型": "分块", "总格": 统2["逻辑格"], "非零": 统2["块数"], "物理字节": 统2["物理字节"], "倍数": 统2["倍数"], "最小": 0, "最大": 255}
结束

函数 三维指纹 卷 则
    如果 卷["型"] 等于 "稠密" 则
        返回 体指纹(卷["体"])
    结束
    返回 分块指纹(卷["体"])
结束

# 取一层二维截面；分块体逐格读，稠密体直接切
函数 三维切片 卷 层 则
    局部 面 变成 []
    局部 行序 变成 0
    当 行序 < 卷["行数"] 则
        局部 线 变成 []
        局部 列序 变成 0
        当 列序 < 卷["列数"] 则
            追加(线, 三维读(卷, 层, 行序, 列序))
            将 列序 变成 列序 + 1
        结束
        追加(面, 线)
        将 行序 变成 行序 + 1
    结束
    返回 面
结束

# 三维平滑只支持稠密体（分块体跨块邻域留到下一版）
函数 三维平滑 卷 则
    如果 卷["型"] 不等于 "稠密" 则
        抛出("三维平滑暂只支持稠密体；分块体请按块调用")
    结束
    局部 新体 变成 体平滑(卷["体"])
    返回 {"型": "稠密", "体": 新体, "层数": 卷["层数"], "行数": 卷["行数"], "列数": 卷["列数"], "总格": 卷["总格"]}
结束

# 取一层截面到连续缓冲（分块体走整块拷贝，稠密体直接搬行）
函数 三维切片缓冲 卷 层 则
    如果 卷["型"] 等于 "分块" 则
        返回 分块切片缓冲(卷["体"], 层)
    结束
    局部 行数 变成 卷["行数"]
    局部 列数 变成 卷["列数"]
    局部 出 变成 新建缓冲(行数 * 列数, 0)
    局部 数 变成 卷["体"]["数"]
    局部 基 变成 层 * 行数 * 列数
    局部 位 变成 0
    当 位 < 行数 * 列数 则
        缓冲写(出, 位, 数[基 + 位] % 256)
        将 位 变成 位 + 1
    结束
    返回 出
结束
