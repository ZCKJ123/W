# 体数据：真正的三维数组（层 × 行 × 列），带邻域计算
# 不是把二维摊平，是按三坐标寻址：址 = (层 × 行数 + 行) × 列数 + 列

依赖 文件库
依赖 数学库
依赖 哈希库

函数 新建体 层 行 列 则
    局部 数 变成 []
    局部 总 变成 层 * 行 * 列
    局部 序 变成 0
    当 序 < 总 则
        追加(数, 0)
        将 序 变成 序 + 1
    结束
    返回 {"层": 层, "行": 行, "列": 列, "数": 数}
结束

函数 体址 体 层 行 列 则
    返回 (层 * 体["行"] + 行) * 体["列"] + 列
结束

函数 体设 体 层 行 列 值 则
    将 体["数"][体址(体, 层, 行, 列)] 变成 值
结束

函数 体取 体 层 行 列 则
    返回 体["数"][体址(体, 层, 行, 列)]
结束

函数 在体内 体 层 行 列 则
    如果 层 < 0 则
        返回 0
    结束
    如果 行 < 0 则
        返回 0
    结束
    如果 列 < 0 则
        返回 0
    结束
    如果 层 >= 体["层"] 则
        返回 0
    结束
    如果 行 >= 体["行"] 则
        返回 0
    结束
    如果 列 >= 体["列"] 则
        返回 0
    结束
    返回 1
结束

# 3×3×3 邻域（含自己）求和与计数
函数 邻域和 体 层 行 列 则
    局部 和 变成 0
    局部 数 变成 0
    局部 甲 变成 -1
    当 甲 <= 1 则
        局部 乙 变成 -1
        当 乙 <= 1 则
            局部 丙 变成 -1
            当 丙 <= 1 则
                如果 在体内(体, 层 + 甲, 行 + 乙, 列 + 丙) 等于 1 则
                    将 和 变成 和 + 体取(体, 层 + 甲, 行 + 乙, 列 + 丙)
                    将 数 变成 数 + 1
                结束
                将 丙 变成 丙 + 1
            结束
            将 乙 变成 乙 + 1
        结束
        将 甲 变成 甲 + 1
    结束
    返回 [和, 数]
结束

# 三维盒式平滑，返回新体
函数 体平滑 体 则
    局部 出 变成 新建体(体["层"], 体["行"], 体["列"])
    局部 层序 变成 0
    当 层序 < 体["层"] 则
        局部 行序 变成 0
        当 行序 < 体["行"] 则
            局部 列序 变成 0
            当 列序 < 体["列"] 则
                局部 邻 变成 邻域和(体, 层序, 行序, 列序)
                体设(出, 层序, 行序, 列序, 向下取整(邻[0] / 邻[1]))
                将 列序 变成 列序 + 1
            结束
            将 行序 变成 行序 + 1
        结束
        将 层序 变成 层序 + 1
    结束
    返回 出
结束

# 取一层，返回二维列表（行 × 列）
函数 体切片 体 层 则
    局部 面 变成 []
    局部 行序 变成 0
    当 行序 < 体["行"] 则
        局部 线 变成 []
        局部 列序 变成 0
        当 列序 < 体["列"] 则
            追加(线, 体取(体, 层, 行序, 列序))
            将 列序 变成 列序 + 1
        结束
        追加(面, 线)
        将 行序 变成 行序 + 1
    结束
    返回 面
结束

函数 体统计 体 则
    局部 最小 变成 999999
    局部 最大 变成 -999999
    局部 和 变成 0
    局部 非零 变成 0
    对于 值 在 体["数"] 中 则
        如果 值 < 最小 则
            将 最小 变成 值
        结束
        如果 值 > 最大 则
            将 最大 变成 值
        结束
        将 和 变成 和 + 值
        如果 值 不等于 0 则
            将 非零 变成 非零 + 1
        结束
    结束
    返回 {"最小": 最小, "最大": 最大, "和": 和, "非零": 非零, "格数": 长度(体["数"])}
结束

# 指纹：把所有格子的值按 0..255 取整后串成字节再 SHA-256
函数 体指纹 体 则
    局部 数 变成 体["数"]
    局部 缓 变成 新建缓冲(长度(数), 0)
    局部 序 变成 0
    当 序 < 长度(数) 则
        缓冲写(缓, 序, 数[序] % 256)
        将 序 变成 序 + 1
    结束
    返回 缓冲SHA256(缓)
结束
