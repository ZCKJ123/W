# 分块体：大体积切成 32³ 小块；小块两种存法
#   常量块 {满:1, 值:v}    整块一个值，只占 8 字节（实心区/背景区都吃这个）
#   缓冲块 {满:0, 缓:buf}  有变化，占 32KB
# 寻址：格 = (层 × 行数 + 行) × 列数 + 列；块键 = (层/32, 行/32, 列/32)

依赖 文件库
依赖 数学库
依赖 哈希库

函数 新建分块体 层数 行数 列数 块边 则
    返回 {"层数": 层数, "行数": 行数, "列数": 列数, "块边": 块边, "块表": {}, "块数": 0, "逻辑格": 层数 * 行数 * 列数}
结束

函数 块键 体 层 行 列 则
    局部 边 变成 体["块边"]
    返回 文本(向下取整(层 / 边)) + "," + 文本(向下取整(行 / 边)) + "," + 文本(向下取整(列 / 边))
结束

函数 块内址 体 层 行 列 则
    局部 边 变成 体["块边"]
    返回 ((层 % 边) * 边 + 行 % 边) * 边 + 列 % 边
结束

函数 查块 体 层 行 列 则
    局部 表 变成 体["块表"]
    局部 键 变成 块键(体, 层, 行, 列)
    如果 有键(表, 键) 则
        返回 表[键]
    结束
    返回 0
结束

# 建块：默认是常量 0，不分配 32KB
函数 建块 体 层 行 列 则
    局部 表 变成 体["块表"]
    局部 键 变成 块键(体, 层, 行, 列)
    如果 有键(表, 键) 则
        返回 表[键]
    结束
    局部 块 变成 {"满": 1, "值": 0, "缓": 0}
    将 表[键] 变成 块
    将 体["块数"] 变成 体["块数"] + 1
    返回 块
结束

# 常量块要改成有变化的块时，先铺 32KB 缓冲
函数 展开块 体 块 则
    如果 块["满"] 等于 0 则
        返回 块["缓"]
    结束
    局部 边 变成 体["块边"]
    局部 缓 变成 新建缓冲(边 * 边 * 边, 块["值"] % 256)
    将 块["缓"] 变成 缓
    将 块["满"] 变成 0
    返回 缓
结束

函数 体写 体 层 行 列 值 则
    局部 块 变成 建块(体, 层, 行, 列)
    局部 位 变成 块内址(体, 层, 行, 列)
    如果 块["满"] 等于 0 则
        缓冲写(块["缓"], 位, 值)
        返回 1
    结束
    如果 块["值"] 等于 值 则
        返回 1
    结束
    局部 缓 变成 展开块(体, 块)
    缓冲写(缓, 位, 值)
    返回 1
结束

函数 体读 体 层 行 列 则
    局部 块 变成 查块(体, 层, 行, 列)
    如果 块 等于 0 则
        返回 0
    结束
    如果 块["满"] 等于 1 则
        返回 块["值"]
    结束
    返回 缓冲读(块["缓"], 块内址(体, 层, 行, 列))
结束

# 整块填同一个值：直接记成常量块，不分配缓冲
函数 体填空块 体 层起 行起 列起 值 则
    局部 表 变成 体["块表"]
    局部 键 变成 块键(体, 层起, 行起, 列起)
    如果 非 有键(表, 键) 则
        将 表[键] 变成 {"满": 1, "值": 值, "缓": 0}
        将 体["块数"] 变成 体["块数"] + 1
        返回 1
    结束
    局部 块 变成 表[键]
    将 块["满"] 变成 1
    将 块["值"] 变成 值
    将 块["缓"] 变成 0
    返回 1
结束

函数 分块统计 体 则
    局部 边 变成 体["块边"]
    局部 块字节 变成 0
    局部 常量块 变成 0
    局部 缓冲块 变成 0
    对于 键名 在 键(体["块表"]) 中 则
        局部 块 变成 体["块表"][键名]
        如果 块["满"] 等于 1 则
            将 块字节 变成 块字节 + 8
            将 常量块 变成 常量块 + 1
        否则
            将 块字节 变成 块字节 + 边 * 边 * 边
            将 缓冲块 变成 缓冲块 + 1
        结束
    结束
    局部 物理 变成 块字节 + 体["块数"] * 16
    局部 逻辑 变成 体["逻辑格"]
    局部 倍 变成 0
    如果 物理 > 0 则
        将 倍 变成 逻辑 / 物理
    结束
    返回 {"逻辑格": 逻辑, "块数": 体["块数"], "常量块": 常量块, "缓冲块": 缓冲块, "物理字节": 物理, "倍数": 倍}
结束

# 按块整块拷贝一层截面
函数 分块切片缓冲 体 层 则
    局部 边 变成 体["块边"]
    局部 行数 变成 体["行数"]
    局部 列数 变成 体["列数"]
    局部 出 变成 新建缓冲(行数 * 列数, 0)
    局部 表 变成 体["块表"]
    局部 层块 变成 向下取整(层 / 边)
    局部 内层 变成 层 % 边
    局部 块行数 变成 向下取整(行数 / 边)
    局部 块列数 变成 向下取整(列数 / 边)
    局部 行块 变成 0
    当 行块 < 块行数 则
        局部 列块 变成 0
        当 列块 < 块列数 则
            局部 键 变成 文本(层块) + "," + 文本(行块) + "," + 文本(列块)
            如果 有键(表, 键) 则
                局部 块 变成 表[键]
                局部 行坐标 变成 0
                当 行坐标 < 边 则
                    局部 列坐标 变成 0
                    当 列坐标 < 边 则
                        局部 值 变成 块["值"]
                        如果 块["满"] 等于 0 则
                            将 值 变成 缓冲读(块["缓"], (内层 * 边 + 行坐标) * 边 + 列坐标)
                        结束
                        缓冲写(出, (行块 * 边 + 行坐标) * 列数 + 列块 * 边 + 列坐标, 值)
                        将 列坐标 变成 列坐标 + 1
                    结束
                    将 行坐标 变成 行坐标 + 1
                结束
            结束
            将 列块 变成 列块 + 1
        结束
        将 行块 变成 行块 + 1
    结束
    返回 出
结束

# 零拷贝视图：前面建索引，读的时候直接跳
函数 分块切片视图 体 层 则
    局部 边 变成 体["块边"]
    局部 行数 变成 体["行数"]
    局部 列数 变成 体["列数"]
    局部 块行数 变成 向下取整(行数 / 边)
    局部 块列数 变成 向下取整(列数 / 边)
    局部 层块 变成 向下取整(层 / 边)
    局部 内层 变成 层 % 边
    局部 表 变成 体["块表"]
    局部 索引 变成 []
    局部 行块 变成 0
    当 行块 < 块行数 则
        局部 列块 变成 0
        当 列块 < 块列数 则
            局部 键 变成 文本(层块) + "," + 文本(行块) + "," + 文本(列块)
            局部 块 变成 0
            如果 有键(表, 键) 则
                将 块 变成 表[键]
            结束
            追加(索引, 块)
            将 列块 变成 列块 + 1
        结束
        将 行块 变成 行块 + 1
    结束
    返回 {"边": 边, "行数": 行数, "列数": 列数, "块行数": 块行数, "块列数": 块列数, "内层": 内层, "索引": 索引}
结束

函数 视图读 视 行 列 则
    局部 边 变成 视["边"]
    局部 块列数 变成 视["块列数"]
    局部 块 变成 视["索引"][向下取整(行 / 边) * 块列数 + 向下取整(列 / 边)]
    如果 块 等于 0 则
        返回 0
    结束
    如果 块["满"] 等于 1 则
        返回 块["值"]
    结束
    返回 缓冲读(块["缓"], (视["内层"] * 边 + 行 % 边) * 边 + 列 % 边)
结束

# 3×3×3 平滑一个块（带 halo，跨块邻居也能读到）
函数 分块平滑块 体 层起 行起 列起 则
    局部 边 变成 体["块边"]
    局部 加边 变成 边 + 2
    局部 垫 变成 新建缓冲(加边 * 加边 * 加边, 0)
    局部 层坐标 变成 0
    当 层坐标 < 加边 则
        局部 行坐标 变成 0
        当 行坐标 < 加边 则
            局部 列坐标 变成 0
            当 列坐标 < 加边 则
                缓冲写(垫, (层坐标 * 加边 + 行坐标) * 加边 + 列坐标, 体读(体, 层起 + 层坐标 - 1, 行起 + 行坐标 - 1, 列起 + 列坐标 - 1))
                将 列坐标 变成 列坐标 + 1
            结束
            将 行坐标 变成 行坐标 + 1
        结束
        将 层坐标 变成 层坐标 + 1
    结束
    局部 出 变成 新建缓冲(边 * 边 * 边, 0)
    将 层坐标 变成 0
    当 层坐标 < 边 则
        将 行坐标 变成 0
        当 行坐标 < 边 则
            将 列坐标 变成 0
            当 列坐标 < 边 则
                局部 和 变成 0
                局部 数 变成 0
                局部 甲 变成 0
                当 甲 <= 2 则
                    局部 乙 变成 0
                    当 乙 <= 2 则
                        局部 丙 变成 0
                        当 丙 <= 2 则
                            将 和 变成 和 + 缓冲读(垫, ((层坐标 + 甲) * 加边 + (行坐标 + 乙)) * 加边 + (列坐标 + 丙))
                            将 数 变成 数 + 1
                            将 丙 变成 丙 + 1
                        结束
                        将 乙 变成 乙 + 1
                    结束
                    将 甲 变成 甲 + 1
                结束
                缓冲写(出, (层坐标 * 边 + 行坐标) * 边 + 列坐标, 向下取整(和 / 数))
                将 列坐标 变成 列坐标 + 1
            结束
            将 行坐标 变成 行坐标 + 1
        结束
        将 层坐标 变成 层坐标 + 1
    结束
    返回 出
结束

# 指纹：按块键排序，常量块记值，缓冲块记 SHA-256
函数 分块指纹 体 则
    局部 键们 变成 键(体["块表"])
    局部 排序键 变成 []
    对于 项 在 键们 中 则
        追加(排序键, 项)
    结束
    局部 序 变成 0
    当 序 < 长度(排序键) 则
        局部 甲 变成 序 + 1
        当 甲 < 长度(排序键) 则
            如果 排序键[甲] < 排序键[序] 则
                局部 暂 变成 排序键[序]
                将 排序键[序] 变成 排序键[甲]
                将 排序键[甲] 变成 暂
            结束
            将 甲 变成 甲 + 1
        结束
        将 序 变成 序 + 1
    结束
    局部 文 变成 ""
    对于 键名 在 排序键 中 则
        局部 块 变成 体["块表"][键名]
        如果 块["满"] 等于 1 则
            将 文 变成 文 + 键名 + ":常量" + 文本(块["值"]) + ";"
        否则
            将 文 变成 文 + 键名 + ":" + 缓冲SHA256(块["缓"]) + ";"
        结束
    结束
    返回 SHA256(文)
结束

# 分块平滑（可分离版）：x、y、z 各扫一遍，每格 3 次加法而不是 27 次
函数 分块平滑块快 体 层起 行起 列起 则
    局部 边 变成 体["块边"]
    局部 宽 变成 边 + 2
    局部 垫 变成 新建缓冲(宽 * 宽 * 宽, 0)
    局部 层坐标 变成 0
    当 层坐标 < 宽 则
        局部 行坐标 变成 0
        当 行坐标 < 宽 则
            局部 列坐标 变成 0
            当 列坐标 < 宽 则
                缓冲写(垫, (层坐标 * 宽 + 行坐标) * 宽 + 列坐标, 体读(体, 层起 + 层坐标 - 1, 行起 + 行坐标 - 1, 列起 + 列坐标 - 1))
                将 列坐标 变成 列坐标 + 1
            结束
            将 行坐标 变成 行坐标 + 1
        结束
        将 层坐标 变成 层坐标 + 1
    结束
    局部 横 变成 []
    将 层坐标 变成 0
    当 层坐标 < 宽 则
        将 行坐标 变成 0
        当 行坐标 < 宽 则
            将 列坐标 变成 0
            当 列坐标 < 边 则
                局部 起 变成 (层坐标 * 宽 + 行坐标) * 宽 + 列坐标
                追加(横, 缓冲读(垫, 起) + 缓冲读(垫, 起 + 1) + 缓冲读(垫, 起 + 2))
                将 列坐标 变成 列坐标 + 1
            结束
            将 行坐标 变成 行坐标 + 1
        结束
        将 层坐标 变成 层坐标 + 1
    结束
    局部 纵 变成 []
    将 层坐标 变成 0
    当 层坐标 < 宽 则
        将 行坐标 变成 0
        当 行坐标 < 边 则
            将 列坐标 变成 0
            当 列坐标 < 边 则
                局部 起2 变成 (层坐标 * 宽 + 行坐标) * 边 + 列坐标
                追加(纵, 横[起2] + 横[起2 + 边] + 横[起2 + 2 * 边])
                将 列坐标 变成 列坐标 + 1
            结束
            将 行坐标 变成 行坐标 + 1
        结束
        将 层坐标 变成 层坐标 + 1
    结束
    局部 出 变成 新建缓冲(边 * 边 * 边, 0)
    将 层坐标 变成 0
    当 层坐标 < 边 则
        将 行坐标 变成 0
        当 行坐标 < 边 则
            将 列坐标 变成 0
            当 列坐标 < 边 则
                局部 起3 变成 (层坐标 * 边 + 行坐标) * 边 + 列坐标
                缓冲写(出, 起3, 向下取整((纵[起3] + 纵[起3 + 边 * 边] + 纵[起3 + 2 * 边 * 边]) / 27))
                将 列坐标 变成 列坐标 + 1
            结束
            将 行坐标 变成 行坐标 + 1
        结束
        将 层坐标 变成 层坐标 + 1
    结束
    返回 出
结束
