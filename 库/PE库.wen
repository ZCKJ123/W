# PE库.wen —— 纯文言 PE64 打包，不依赖 C 运行时
函数 写16 缓冲 偏移 值 则
    缓冲写整数(缓冲, 偏移, 值, 2, "小端")
结束
函数 写32 缓冲 偏移 值 则
    缓冲写整数(缓冲, 偏移, 值, 4, "小端")
结束
函数 写64 缓冲 偏移 值 则
    缓冲写整数(缓冲, 偏移, 值, 8, "小端")
结束
函数 打包退出PE 路径 退出码 则
    将 缓冲 变成 新建缓冲(2048, 0)
    缓冲写(缓冲, 0, 77)
    缓冲写(缓冲, 1, 90)
    写32(缓冲, 0x3C, 0x40)
    缓冲写(缓冲, 0x40, 80)
    缓冲写(缓冲, 0x41, 69)
    写16(缓冲, 0x44, 0x8664)
    写16(缓冲, 0x46, 2)
    写16(缓冲, 0x54, 0xF0)
    写16(缓冲, 0x56, 0x22)
    将 可选 变成 0x58
    写16(缓冲, 可选, 0x20B)
    写32(缓冲, 可选+4, 0x200)
    写32(缓冲, 可选+8, 0x200)
    写32(缓冲, 可选+16, 0x1000)
    写32(缓冲, 可选+20, 0x1000)
    写64(缓冲, 可选+24, 0x140000000)
    写32(缓冲, 可选+32, 0x1000)
    写32(缓冲, 可选+36, 0x200)
    写16(缓冲, 可选+48, 6)
    写32(缓冲, 可选+56, 0x3000)
    写32(缓冲, 可选+60, 0x400)
    写16(缓冲, 可选+68, 3)
    写64(缓冲, 可选+72, 0x100000)
    写64(缓冲, 可选+80, 0x1000)
    写64(缓冲, 可选+88, 0x100000)
    写64(缓冲, 可选+96, 0x1000)
    写32(缓冲, 可选+108, 16)
    写32(缓冲, 可选+120, 0x2000)
    写32(缓冲, 可选+124, 0x28)
    将 节 变成 可选 + 0xF0
    将 名 变成 [46, 116, 101, 120, 116]
    将 序 变成 0
    对于 字节 在 名 中 则
        缓冲写(缓冲, 节+序, 字节)
        将 序 变成 序 + 1
    结束
    写32(缓冲, 节+8, 0x100)
    写32(缓冲, 节+12, 0x1000)
    写32(缓冲, 节+16, 0x200)
    写32(缓冲, 节+20, 0x400)
    写32(缓冲, 节+36, 0x60000020)
    将 节2 变成 节 + 40
    将 名2 变成 [46, 105, 100, 97, 116, 97]
    将 序 变成 0
    对于 字节 在 名2 中 则
        缓冲写(缓冲, 节2+序, 字节)
        将 序 变成 序 + 1
    结束
    写32(缓冲, 节2+8, 0x100)
    写32(缓冲, 节2+12, 0x2000)
    写32(缓冲, 节2+16, 0x200)
    写32(缓冲, 节2+20, 0x600)
    写32(缓冲, 节2+36, 0xC0000040)
    将 代码 变成 0x400
    缓冲写(缓冲, 代码, 0x48)
    缓冲写(缓冲, 代码+1, 0x83)
    缓冲写(缓冲, 代码+2, 0xEC)
    缓冲写(缓冲, 代码+3, 0x28)
    缓冲写(缓冲, 代码+4, 0xB9)
    写32(缓冲, 代码+5, 退出码)
    缓冲写(缓冲, 代码+9, 0xFF)
    缓冲写(缓冲, 代码+10, 0x15)
    写32(缓冲, 代码+11, 0x2050 - 0x100F)
    缓冲写(缓冲, 代码+15, 0xCC)
    将 导入 变成 0x600
    写32(缓冲, 导入, 0x2040)
    写32(缓冲, 导入+12, 0x20A0)
    写32(缓冲, 导入+16, 0x2050)
    写64(缓冲, 导入+0x40, 0x2080)
    写64(缓冲, 导入+0x48, 0)
    写64(缓冲, 导入+0x50, 0x2080)
    写64(缓冲, 导入+0x58, 0)
    将 名址 变成 导入 + 0x80
    将 退出名 变成 [69, 120, 105, 116, 80, 114, 111, 99, 101, 115, 115]
    将 序 变成 0
    对于 字节 在 退出名 中 则
        缓冲写(缓冲, 名址+2+序, 字节)
        将 序 变成 序 + 1
    结束
    将 库址 变成 导入 + 0xA0
    将 库名 变成 [75, 69, 82, 78, 69, 76, 51, 50, 46, 100, 108, 108]
    将 序 变成 0
    对于 字节 在 库名 中 则
        缓冲写(缓冲, 库址+序, 字节)
        将 序 变成 序 + 1
    结束
    写二进制(路径, 缓冲)
    返回 真
结束
