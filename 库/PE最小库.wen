    写16(缓冲, 0x46, 1)
    写16(缓冲, 0x54, 0xF0)
    写16(缓冲, 0x56, 0x22)
    将 可 变成 0x58
    写16(缓冲, 可, 0x20B)
    写32(缓冲, 可+4, 0x200)
    写32(缓冲, 可+8, 0x200)
    写32(缓冲, 可+16, 0x1014)
    写32(缓冲, 可+20, 0x1000)
    写64(缓冲, 可+24, 0x140000000)
    写32(缓冲, 可+32, 0x1000)
    写32(缓冲, 可+36, 0x200)
    写16(缓冲, 可+48, 6)
    写32(缓冲, 可+56, 图大小)
    写32(缓冲, 可+60, 0x400)
    写16(缓冲, 可+68, 2)
    写64(缓冲, 可+72, 0x1000000)
    写64(缓冲, 可+80, 0x1000)
    写64(缓冲, 可+88, 0x100000)
    写64(缓冲, 可+96, 0x1000)
    写32(缓冲, 可+108, 16)
    将 节 变成 可 + 0xF0
    将 名 变成 [46,116,101,120,116]
    将 序 变成 0
    对于 字节 在 名 中 则
        缓冲写(缓冲, 节+序, 字节)
        将 序 变成 序 + 1
    结束
    写32(缓冲, 节+8, 0x200)
    写32(缓冲, 节+12, 0x1000)
    写32(缓冲, 节+16, 文节大小)
    写32(缓冲, 节+20, 0x400)
    写32(缓冲, 节+36, 0xE0000020)
    将 序 变成 0
    当 序 < 码长 则
        缓冲写(缓冲, 0x414 + 序, 缓冲读(码, 序))
        将 序 变成 序 + 1
