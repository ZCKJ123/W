函数 写16 缓冲 偏移 值 则
    缓冲写整数(缓冲, 偏移, 值, 2, "小端")
结束
函数 写32 缓冲 偏移 值 则
    缓冲写整数(缓冲, 偏移, 值, 4, "小端")
结束
函数 写64 缓冲 偏移 值 则
    缓冲写整数(缓冲, 偏移, 值, 8, "小端")
结束
函数 打包最小PE 路径 码文 则
    将 码 变成 十六进制转缓冲(码文)
    将 码长 变成 长度(码)
    将 文节大小 变成 0x200
    当 文节大小 < 0x14 + 码长 则
        将 文节大小 变成 文节大小 + 0x200
    结束
    将 图大小 变成 0x1000 + 文节大小
    将 图大小 变成 图大小 + 0xFFF
    将 图大小 变成 图大小 - 图大小 % 0x1000
    将 缓冲 变成 新建缓冲(0x1000, 0)
    缓冲写(缓冲, 0, 77)
    缓冲写(缓冲, 1, 90)
    写32(缓冲, 0x3C, 0x40)
    缓冲写(缓冲, 0x40, 80)
    缓冲写(缓冲, 0x41, 69)
    写16(缓冲, 0x44, 0x8664)
    写16(缓冲, 0x46, 1)
    写16(缓冲, 0x54, 0xF0)
    写16(缓冲, 0x56, 0x22)
    将 可 变成 0x58
    写16(缓冲, 可, 0x20B)
    写32(缓冲, 可+4, 0x200)
    写32(缓冲, 可+8, 0x200)
    写32(缓冲, 可+16, 0x1014)
    写32(缓冲, 可+20, 0x1000)
    写64(缓冲, 可+24, 0x140000000)
    写32(缓冲, 可+32, 0x1000)
    写32(缓冲, 可+36, 0x200)
    写16(缓冲, 可+48, 6)
    写32(缓冲, 可+56, 图大小)
    写32(缓冲, 可+60, 0x400)
    写16(缓冲, 可+68, 2)
    写64(缓冲, 可+72, 0x100000)
    写64(缓冲, 可+80, 0x1000)
    写64(缓冲, 可+88, 0x100000)
    写64(缓冲, 可+96, 0x1000)
    写32(缓冲, 可+108, 16)
    将 节 变成 可 + 0xF0
    将 名 变成 [46,116,101,120,116]
    将 序 变成 0
    对于 字节 在 名 中 则
        缓冲写(缓冲, 节+序, 字节)
        将 序 变成 序 + 1
    结束
    写32(缓冲, 节+8, 0x200)
    写32(缓冲, 节+12, 0x1000)
    写32(缓冲, 节+16, 文节大小)
    写32(缓冲, 节+20, 0x400)
    写32(缓冲, 节+36, 0xE0000020)
    将 序 变成 0
    当 序 < 码长 则
        缓冲写(缓冲, 0x414 + 序, 缓冲读(码, 序))
        将 序 变成 序 + 1
    结束
    写二进制(路径, 缓冲)
    返回 真
结束

函数 打包退出PE 路径 码文 则
    将 码 变成 十六进制转缓冲(码文)
    将 码长 变成 长度(码)
    将 文节大小 变成 0x200
    当 文节大小 < 0x14 + 码长 则
        将 文节大小 变成 文节大小 + 0x200
    结束
    将 导基 变成 0x400 + 文节大小
    将 缓冲 变成 新建缓冲(0x1000, 0)
    缓冲写(缓冲, 0, 77)
    缓冲写(缓冲, 1, 90)
    写32(缓冲, 0x3C, 0x40)
    缓冲写(缓冲, 0x40, 80)
    缓冲写(缓冲, 0x41, 69)
    写16(缓冲, 0x44, 0x8664)
    写16(缓冲, 0x46, 2)
    写16(缓冲, 0x54, 0xF0)
    写16(缓冲, 0x56, 0x22)
    将 可 变成 0x58
    写16(缓冲, 可, 0x20B)
    写32(缓冲, 可+4, 0x200)
    写32(缓冲, 可+8, 0x200)
    写32(缓冲, 可+16, 0x1014)
    写32(缓冲, 可+20, 0x1000)
    写64(缓冲, 可+24, 0x140000000)
    写32(缓冲, 可+32, 0x1000)
    写32(缓冲, 可+36, 0x200)
    写16(缓冲, 可+48, 6)
    写32(缓冲, 可+56, 0x3000)
    写32(缓冲, 可+60, 0x400)
    写16(缓冲, 可+68, 2)
    写64(缓冲, 可+72, 0x100000)
    写64(缓冲, 可+80, 0x1000)
    写64(缓冲, 可+88, 0x100000)
    写64(缓冲, 可+96, 0x1000)
    写32(缓冲, 可+108, 16)
    写32(缓冲, 可+120, 0x2000)
    写32(缓冲, 可+124, 0x28)
    将 节 变成 可 + 0xF0
    将 名 变成 [46,116,101,120,116]
    将 序 变成 0
    对于 字节 在 名 中 则
        缓冲写(缓冲, 节+序, 字节)
        将 序 变成 序 + 1
    结束
    写32(缓冲, 节+8, 0x14 + 码长)
    写32(缓冲, 节+12, 0x1000)
    写32(缓冲, 节+16, 文节大小)
    写32(缓冲, 节+20, 0x400)
    写32(缓冲, 节+36, 0xE0000020)
    将 节2 变成 节 + 40
    将 名2 变成 [46,105,100,97,116,97]
    将 序 变成 0
    对于 字节 在 名2 中 则
        缓冲写(缓冲, 节2+序, 字节)
        将 序 变成 序 + 1
    结束
    写32(缓冲, 节2+8, 0x100)
    写32(缓冲, 节2+12, 0x2000)
    写32(缓冲, 节2+16, 0x100)
    写32(缓冲, 节2+20, 导基)
    写32(缓冲, 节2+36, 0x40000040)
    将 序 变成 0
    当 序 < 码长 则
        缓冲写(缓冲, 0x414 + 序, 缓冲读(码, 序))
        将 序 变成 序 + 1
    结束
    写32(缓冲, 导基, 0x2040)
    写32(缓冲, 导基+12, 0x20A0)
    写32(缓冲, 导基+16, 0x2060)
    写64(缓冲, 导基+0x40, 0x2080)
    写64(缓冲, 导基+0x48, 0)
    写64(缓冲, 导基+0x60, 0x2080)
    写64(缓冲, 导基+0x68, 0)
    将 退名 变成 [0,0,69,120,105,116,80,114,111,99,101,115,115]
    将 序 变成 0
    对于 字节 在 退名 中 则
        缓冲写(缓冲, 导基 + 0x80 + 序, 字节)
        将 序 变成 序 + 1
    结束
    将 库名 变成 [75,69,82,78,69,76,51,50,46,100,108,108]
    将 序 变成 0
    对于 字节 在 库名 中 则
        缓冲写(缓冲, 导基 + 0xA0 + 序, 字节)
        将 序 变成 序 + 1
    结束
    写二进制(路径, 缓冲)
    返回 真
结束

函数 打包单节退出PE 路径 码文 则
    将 码 变成 十六进制转缓冲(码文)
    将 码长 变成 长度(码)
    将 缓冲 变成 新建缓冲(0x40400, 0)
    缓冲写(缓冲, 0, 77)
    缓冲写(缓冲, 1, 90)
    写32(缓冲, 0x3C, 0x40)
    缓冲写(缓冲, 0x40, 80)
    缓冲写(缓冲, 0x41, 69)
    写16(缓冲, 0x44, 0x8664)
    写16(缓冲, 0x46, 1)
    写16(缓冲, 0x54, 0xF0)
    写16(缓冲, 0x56, 0x22)
    将 可 变成 0x58
    写16(缓冲, 可, 0x20B)
    写32(缓冲, 可+4, 0x200)
    写32(缓冲, 可+8, 0x200)
    写32(缓冲, 可+16, 0x1014)
    写32(缓冲, 可+20, 0x1000)
    写64(缓冲, 可+24, 0x140000000)
    写32(缓冲, 可+32, 0x1000)
    写32(缓冲, 可+36, 0x200)
    写16(缓冲, 可+48, 6)
    写32(缓冲, 可+56, 0x41000)
    写32(缓冲, 可+60, 0x400)
    写16(缓冲, 可+68, 2)
    写64(缓冲, 可+72, 0x100000)
    写64(缓冲, 可+80, 0x1000)
    写64(缓冲, 可+88, 0x100000)
    写64(缓冲, 可+96, 0x1000)
    写32(缓冲, 可+108, 16)
    写32(缓冲, 可+120, 0x3F000)
    写32(缓冲, 可+124, 0x28)
    将 节 变成 可 + 0xF0
    将 名 变成 [46,116,101,120,116]
    将 序 变成 0
    对于 字节 在 名 中 则
        缓冲写(缓冲, 节+序, 字节)
        将 序 变成 序 + 1
    结束
    写32(缓冲, 节+8, 0x40000)
    写32(缓冲, 节+12, 0x1000)
    写32(缓冲, 节+16, 0x40000)
    写32(缓冲, 节+20, 0x400)
    写32(缓冲, 节+36, 0xE0000020)
    将 序 变成 0
    当 序 < 码长 则
        缓冲写(缓冲, 0x414 + 序, 缓冲读(码, 序))
        将 序 变成 序 + 1
    结束
    将 导 变成 0x3E400
    写32(缓冲, 导, 0x3F0B0)
    写32(缓冲, 导+12, 0x3F200)
    写32(缓冲, 导+16, 0x3F050)
    将 名表 变成 [0x3F100, 0x3F120, 0x3F140, 0x3F160, 0x3F180, 0x3F1A0, 0x3F1C0, 0x3F1E0]
    将 序 变成 0
    对于 址 在 名表 中 则
        写64(缓冲, 导 + 0xB0 + 8 * 序, 址)
        写64(缓冲, 导 + 0x50 + 8 * 序, 址)
        将 序 变成 序 + 1
    结束
    写64(缓冲, 导 + 0xB0 + 8 * 序, 0)
    写64(缓冲, 导 + 0x50 + 8 * 序, 0)
    将 名们 变成 [[0,0,83,108,101,101,112], [0,0,69,120,105,116,80,114,111,99,101,115,115], [0,0,71,101,116,80,114,111,99,101,115,115,72,101,97,112], [0,0,72,101,97,112,65,108,108,111,99], [0,0,67,114,101,97,116,101,70,105,108,101,65], [0,0,71,101,116,70,105,108,101,83,105,122,101], [0,0,82,101,97,100,70,105,108,101], [0,0,67,108,111,115,101,72,97,110,100,108,101]]
    将 序 变成 0
    对于 字节们 在 名们 中 则
        将 列 变成 0
        对于 字节 在 字节们 中 则
            缓冲写(缓冲, 导 + 0x100 + 0x20 * 序 + 列, 字节)
            将 列 变成 列 + 1
        结束
        将 序 变成 序 + 1
    结束
    将 库名 变成 [75,69,82,78,69,76,51,50,46,100,108,108]
    将 序 变成 0
    对于 字节 在 库名 中 则
        缓冲写(缓冲, 导 + 0x200 + 序, 字节)
        将 序 变成 序 + 1
    结束
    写二进制(路径, 缓冲)
    返回 真
结束

