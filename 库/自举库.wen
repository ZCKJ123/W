    结束
    如果 类 等于 "比较" 则
        生成表达式(节点["左"], 码, 变量)
        发(码, 80)
        生成表达式(节点["右"], 码, 变量)
        发(码, 89)
        发多(码, [72, 57, 193])
        如果 节点["符"] 等于 "<" 则
            发多(码, [15, 146, 192])
        否则如果 节点["符"] 等于 "<=" 则
