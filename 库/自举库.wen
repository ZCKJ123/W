                    发(码, 向下取整(值 / 权2) % 256)
                    将 权2 变成 权2 * 256
                结束
                将 偏 变成 偏 + 8
            结束
            发多(码, [255, 21])
            将 权 变成 1
            将 差 变成 0x30A0 - (0x1014 + 长度(码) + 4)
            对于 位 在 范围(0, 4) 中 则
                发(码, 向下取整(差 / 权) % 256)
                将 权 变成 权 * 256
            结束
            发多(码, [72, 137, 132, 36, 176, 0, 0, 0])
            发多(码, [72, 137, 193])
            发多(码, [72, 199, 194, 252, 255, 255, 255])
            发多(码, [73, 184, 0, 64, 0, 64, 1, 0, 0, 0])
            发多(码, [255, 21])
            将 权 变成 1
            将 差 变成 0x30C0 - (0x1014 + 长度(码) + 4)
            对于 位 在 范围(0, 4) 中 则
                发(码, 向下取整(差 / 权) % 256)
                将 权 变成 权 * 256
            结束
            发多(码, [72, 139, 140, 36, 176, 0, 0, 0])
            发多(码, [49, 210])
            发多(码, [65, 184, 1, 0, 0, 0])
            发多(码, [255, 21])
            将 权 变成 1
            将 差 变成 0x30D0 - (0x1014 + 长度(码) + 4)
            对于 位 在 范围(0, 4) 中 则
                发(码, 向下取整(差 / 权) % 256)
                将 权 变成 权 * 256
            结束
            将 环 变成 长度(码)
            发多(码, [72, 141, 76, 36, 96])
            发多(码, [49, 210, 69, 49, 192, 69, 49, 201])
            发多(码, [255, 21])
            将 权 变成 1
            将 差 变成 0x30A8 - (0x1014 + 长度(码) + 4)
            对于 位 在 范围(0, 4) 中 则
                发(码, 向下取整(差 / 权) % 256)
                将 权 变成 权 * 256
            结束
            发多(码, [133, 192, 15, 132])
            将 补 变成 长度(码)
            发多(码, [0, 0, 0, 0])
            发多(码, [72, 141, 76, 36, 96])
            发多(码, [255, 21])
            将 权 变成 1
            将 差 变成 0x30B0 - (0x1014 + 长度(码) + 4)
            对于 位 在 范围(0, 4) 中 则
                发(码, 向下取整(差 / 权) % 256)
                将 权 变成 权 * 256
            结束
            发多(码, [72, 141, 76, 36, 96])
            发多(码, [255, 21])
            将 权 变成 1
            将 差 变成 0x30B8 - (0x1014 + 长度(码) + 4)
            对于 位 在 范围(0, 4) 中 则
                发(码, 向下取整(差 / 权) % 256)
                将 权 变成 权 * 256
            结束
            发多(码, [72, 139, 140, 36, 176, 0, 0, 0])
            发多(码, [49, 210])
            发多(码, [69, 49, 192])
            发多(码, [255, 21])
            将 权 变成 1
            将 差 变成 0x30D0 - (0x1014 + 长度(码) + 4)
            对于 位 在 范围(0, 4) 中 则
                发(码, 向下取整(差 / 权) % 256)
                将 权 变成 权 * 256
            结束
            将 跳 变成 长度(码)
            发(码, 235)
            发(码, (环 - (跳 + 2) + 256) % 256)
            将 完 变成 长度(码)
            发多(码, [49, 192])
            将 差 变成 完 - (补 + 4)
            将 权 变成 1
            对于 位 在 范围(0, 4) 中 则
                将 码[补 + 位] 变成 向下取整(差 / 权) % 256
                将 权 变成 权 * 256
            结束
            返回 0
        结束
        如果 节点["名"] 等于 "睡眠" 则
            如果 长度(参数) 等于 1 则
                生成表达式(参数[0], 码, 变量)
                发多(码, [137, 193])
                发多(码, [255, 21])
                将 权 变成 1
                将 差 变成 0x7F050 - (0x1014 + 长度(码) + 4)
                对于 位 在 范围(0, 4) 中 则
                    发(码, 向下取整(差 / 权) % 256)
                    将 权 变成 权 * 256
                结束
                发多(码, [49, 192])
                返回 0
            结束
        结束
        如果 节点["名"] 等于 "长度" 且 参数[0]["类型"] 不等于 "文本" 则
            生成表达式({"类型": "调用", "名": "取长", "参数": [参数[0]]}, 码, 变量)
            返回 0
        结束
        如果 节点["名"] 等于 "显示" 则
            如果 长度(参数) 等于 1 则
                将 可显示 变成 参数[0]["类型"] 等于 "文本"
                如果 参数[0]["类型"] 等于 "运算" 且 参数[0]["符"] 等于 "+" 则
                    如果 参数[0]["左"]["类型"] 等于 "文本" 且 参数[0]["右"]["类型"] 等于 "文本" 则
                        将 可显示 变成 真
                    结束
                结束
                如果 可显示 则
                    发多(码, [49, 201])
                    发多(码, [72, 141, 21])
                    将 权 变成 1
                    将 差 变成 0x2100 - (0x1014 + 长度(码) + 4)
                    对于 位 在 范围(0, 4) 中 则
                        发(码, 向下取整(差 / 权) % 256)
                        将 权 变成 权 * 256
                    结束
                    发多(码, [76, 141, 5])
                    将 权 变成 1
                    将 差 变成 0x2180 - (0x1014 + 长度(码) + 4)
                    对于 位 在 范围(0, 4) 中 则
                        发(码, 向下取整(差 / 权) % 256)
                        将 权 变成 权 * 256
                    结束
                    发多(码, [69, 49, 201])
                    发多(码, [255, 21])
                    将 权 变成 1
                    将 差 变成 0x3050 - (0x1014 + 长度(码) + 4)
                    对于 位 在 范围(0, 4) 中 则
                        发(码, 向下取整(差 / 权) % 256)
                        将 权 变成 权 * 256
                    结束
                    返回 0
                结束
            结束
        结束
        如果 节点["名"] 等于 "长度" 则
            如果 长度(参数) 等于 1 则
                如果 参数[0]["类型"] 等于 "文本" 则
                    发整数(码, 长度(参数[0]["值"]))
                    返回 0
                结束
            结束
        结束
        将 默认 变成 []
        对于 项 在 函数默认表 中 则
            如果 项[0] 等于 节点["名"] 则
                将 默认 变成 项[1]
            结束
        结束
        将 总 变成 长度(参数)
        如果 长度(默认) > 总 则
            将 总 变成 长度(默认)
        结束
        如果 总 % 2 等于 1 则
            发多(码, [72, 131, 236, 8])
        结束
        将 序 变成 总 - 1
        当 序 >= 长度(参数) 则
            将 值 变成 整数(默认[序])
            发多(码, [72, 184])
            将 权 变成 1
            对于 位 在 范围(0, 8) 中 则
                发(码, 向下取整(值 / 权) % 256)
                将 权 变成 权 * 256
            结束
            发(码, 80)
            将 序 变成 序 - 1
        结束
        将 序 变成 长度(参数) - 1
        当 序 >= 0 则
            生成表达式(参数[序], 码, 变量)
            发(码, 80)
            将 序 变成 序 - 1
        结束
        发(码, 232)
        将 位 变成 长度(码)
        发多(码, [0, 0, 0, 0])
        追加(当前调用补丁, [位, 节点["名"]])
        发多(码, [72, 129, 196])
        将 数 变成 8 * 总
        如果 总 % 2 等于 1 则
            将 数 变成 数 + 8
        结束
        将 权 变成 1
        对于 序 在 范围(0, 4) 中 则
            发(码, 向下取整(数 / 权) % 256)
            将 权 变成 权 * 256
        结束
        返回 0
    结束
    抛出("自举编译不支持表达式：" + 类)
结束

函数 生成语句 节点 码 变量 则
    将 类 变成 节点["类型"]
    如果 类 等于 "表达式" 则
        生成表达式(节点["值"], 码, 变量)
        返回 0
    结束
    如果 类 等于 "下标赋值" 则
        生成表达式({"类型": "调用", "名": "设元素", "参数": [{"类型": "名字", "值": 节点["名"]}, 节点["路径"][0], 节点["值"]]}, 码, 变量)
        返回 0
    结束
    如果 类 等于 "赋值" 则
        生成表达式(节点["值"], 码, 变量)
        将 槽 变成 找序号(变量, 节点["名"])
        如果 槽 >= 0 则
            发地址(码, [72, 137, 133], 槽)
            返回 0
        结束
        将 址 变成 找全局址(节点["名"])
        如果 址 >= 0 则
            发多(码, [72, 186])
            将 权 变成 1
            对于 位 在 范围(0, 8) 中 则
                发(码, 向下取整(址 / 权) % 256)
                将 权 变成 权 * 256
            结束
            发多(码, [72, 137, 2])
            返回 0
        结束
        将 槽 变成 取槽(变量, 节点["名"])
        发地址(码, [72, 137, 133], 槽)
        返回 0
    结束
    如果 类 等于 "返回" 则
        生成表达式(节点["值"], 码, 变量)
        发多(码, [242, 72, 15, 42, 192, 201, 195])
        返回 0
    结束
    如果 类 等于 "如果" 则
        生成表达式(节点["条件"], 码, 变量)
        发多(码, [72, 133, 192])
        将 假跳 变成 发跳转(码, "je")
        对于 句 在 节点["主体"] 中 则
            生成语句(句, 码, 变量)
        结束
        如果 长度(节点["否则"]) > 0 则
            将 跳过 变成 发跳转(码, "jmp")
            补跳转(码, 假跳, 长度(码))
            对于 句 在 节点["否则"] 中 则
                生成语句(句, 码, 变量)
            结束
            补跳转(码, 跳过, 长度(码))
        否则
            补跳转(码, 假跳, 长度(码))
        结束
        返回 0
    结束
    如果 类 等于 "继续" 则
        如果 长度(循环头栈) > 0 则
            将 头 变成 循环头栈[长度(循环头栈) - 1]
            将 跳 变成 发跳转(码, "jmp")
            补跳转(码, 跳, 头)
        结束
        返回 0
    结束
    如果 类 等于 "中断" 则
        如果 长度(循环断栈) > 0 则
            将 栈 变成 循环断栈[长度(循环断栈) - 1]
            将 位 变成 发跳转(码, "jmp")
            追加(栈, 位)
        结束
        返回 0
    结束
    如果 类 等于 "对于" 则
        将 序名 变成 "序临时" + 文本(长度(变量))
        将 列名 变成 "列临时" + 文本(长度(变量))
        追加(变量, 序名)
        追加(变量, 列名)
        生成表达式({"类型": "调用", "名": "迭代", "参数": [节点["迭"]]}, 码, 变量)
        将 槽列 变成 取槽(变量, 列名)
        发地址(码, [72, 137, 133], 槽列)
        发多(码, [72, 199, 192, 0, 0, 0, 0])
        将 槽序 变成 取槽(变量, 序名)
        发地址(码, [72, 137, 133], 槽序)
        将 体 变成 [{"类型": "赋值", "名": 节点["名"], "值": {"类型": "下标", "对象": {"类型": "名字", "值": 列名}, "键": {"类型": "名字", "值": 序名}}}]
        追加(体, {"类型": "赋值", "名": 序名, "值": {"类型": "运算", "左": {"类型": "名字", "值": 序名}, "符": "+", "右": {"类型": "数字", "值": "1"}}})
        对于 句 在 节点["主体"] 中 则
            追加(体, 句)
        结束
        生成语句({"类型": "当", "条件": {"类型": "比较", "符": "<", "左": {"类型": "名字", "值": 序名}, "右": {"类型": "调用", "名": "长度", "参数": [{"类型": "名字", "值": 列名}]}}, "主体": 体}, 码, 变量)
        返回 0
    结束
    如果 类 等于 "打印" 则
        将 打印首 变成 真
        对于 项 在 节点["参数"] 中 则
            如果 非 打印首 则
                生成表达式({"类型": "调用", "名": "输出文本", "参数": [{"类型": "文本", "值": " "}]}, 码, 变量)
            结束
            将 打印首 变成 假
            生成表达式({"类型": "调用", "名": "打印值", "参数": [项]}, 码, 变量)
        结束
        生成表达式({"类型": "调用", "名": "输出文本", "参数": [{"类型": "调用", "名": "换行符", "参数": []}]}, 码, 变量)
        返回 0
    结束
    如果 类 等于 "尝试" 则
        对于 句 在 节点["主体"] 中 则
            生成语句(句, 码, 变量)
        结束
        对于 句 在 节点["捕获"] 中 则
            生成语句(句, 码, 变量)
        结束
        对于 句 在 节点["最终"] 中 则
            生成语句(句, 码, 变量)
        结束
        返回 0
    结束
    如果 类 等于 "当" 则
        将 循环头 变成 长度(码)
        追加(循环头栈, 循环头)
        生成表达式(节点["条件"], 码, 变量)
        发多(码, [72, 133, 192])
        将 出跳 变成 发跳转(码, "je")
        追加(循环断栈, [])
        对于 句 在 节点["主体"] 中 则
            生成语句(句, 码, 变量)
        结束
        将 回跳 变成 发跳转(码, "jmp")
        补跳转(码, 回跳, 循环头)
        补跳转(码, 出跳, 长度(码))
        弹出(循环头栈)
        将 断们 变成 弹出(循环断栈)
        对于 位 在 断们 中 则
            补跳转(码, 位, 长度(码))
        结束
        返回 0
    结束
    将 行号 变成 "?"
        如果 有键(节点, "行") 则
            将 行号 变成 文本(节点["行"])
        结束
        将 附 变成 ""
        如果 有键(节点, "值") 则
            将 附 变成 附 + " 值=" + 文本(节点["值"])
        结束
        抛出("自举编译不支持语句：" + 类 + 附 + " 行=" + 行号)
结束

函数 发正地址 码 偏移 则
    发多(码, [72, 139, 133])
    将 权 变成 1
    对于 序 在 范围(0, 4) 中 则
        发(码, 向下取整(偏移 / 权) % 256)
        将 权 变成 权 * 256
    结束
结束

函数 找函数起始 名 则
    对于 项 在 当前函数表 中 则
        如果 项[0] 等于 名 则
            返回 项[1]
        结束
    结束
    返回 -1
结束

函数 编译语法树 树 则
    将 当前函数表 变成 []
    将 当前调用补丁 变成 []
    将 主句 变成 []
    将 函数们 变成 []
    对于 句 在 树["语句"] 中 则
        如果 句["类型"] 等于 "函数" 则
            追加(函数们, 句)
            追加(函数默认表, [句["名"], 句["默认"]])
        否则
            追加(主句, 句)
        结束
    结束
    将 码 变成 [85, 72, 137, 229, 72, 129, 236, 0, 16, 0, 0]
    将 变量 变成 []
    对于 句 在 主句 中 则
        生成语句(句, 码, 变量)
    结束
    发多(码, [72, 199, 192, 0, 0, 0, 0, 242, 72, 15, 42, 192, 201, 195])
    对于 函 在 函数们 中 则
        将 起点 变成 长度(码)
        追加(当前函数表, [函["名"], 起点])
        发多(码, [85, 72, 137, 229, 72, 129, 236, 0, 16, 0, 0])
        将 变量 变成 []
        将 序号 变成 0
        对于 参 在 函["参数"] 中 则
            追加(变量, 参)
            将 槽 变成 取槽(变量, 参)
            发正地址(码, 16 + 8 * 序号)
            发地址(码, [72, 137, 133], 槽)
            将 序号 变成 序号 + 1
        结束
        对于 句 在 函["主体"] 中 则
            生成语句(句, 码, 变量)
        结束
        发多(码, [72, 199, 192, 0, 0, 0, 0, 242, 72, 15, 42, 192, 201, 195])
    结束
    对于 补 在 当前调用补丁 中 则
        将 目标 变成 找函数起始(补[1])
        如果 目标 < 0 则
            如果 宽松未定义 则
                将 目标 变成 找函数起始("未定义")
            否则
                抛出("未定义函数：" + 补[1])
            结束
        结束
        将 相对 变成 目标 - (补[0] + 4)
        将 权 变成 1
        对于 序 在 范围(0, 4) 中 则
            将 码[补[0] + 序] 变成 向下取整(相对 / 权) % 256
            将 权 变成 权 * 256
        结束
    结束
    返回 机器函数(码转文本(码))
结束

函数 编译源 源 则
    返回 编译语法树(语法程序(源))
结束

函数 编译语法树文本 树 则
    将 当前函数表 变成 []
    将 当前调用补丁 变成 []
    将 主句 变成 []
    将 函数们 变成 []
    对于 句 在 树["语句"] 中 则
        如果 句["类型"] 等于 "函数" 则
            追加(函数们, 句)
            追加(函数默认表, [句["名"], 句["默认"]])
        否则
            追加(主句, 句)
        结束
    结束
    对于 句 在 主句 中 则
        如果 句["类型"] 等于 "返回" 则
        结束
    结束
    将 全局表 变成 []
    对于 句 在 主句 中 则
        如果 句["类型"] 等于 "赋值" 且 找序号(全局表, 句["名"]) < 0 则
            追加(全局表, 句["名"])
        结束
    结束
    将 码 变成 [85, 72, 137, 229, 72, 129, 236, 0, 16, 0, 0]
    将 变量 变成 []
    对于 句 在 主句 中 则
        生成语句(句, 码, 变量)
    结束
    发多(码, [72, 199, 192, 0, 0, 0, 0, 242, 72, 15, 42, 192, 201, 195])
    对于 函 在 函数们 中 则
        将 起点 变成 长度(码)
        追加(当前函数表, [函["名"], 起点])
        发多(码, [85, 72, 137, 229, 72, 129, 236, 0, 16, 0, 0])
        将 变量 变成 []
        将 序号 变成 0
        对于 参 在 函["参数"] 中 则
            追加(变量, 参)
            将 槽 变成 取槽(变量, 参)
            发正地址(码, 16 + 8 * 序号)
            发地址(码, [72, 137, 133], 槽)
            将 序号 变成 序号 + 1
        结束
        对于 句 在 函["主体"] 中 则
            生成语句(句, 码, 变量)
        结束
        发多(码, [72, 199, 192, 0, 0, 0, 0, 242, 72, 15, 42, 192, 201, 195])
    结束
    对于 补 在 当前调用补丁 中 则
        将 目标 变成 找函数起始(补[1])
        如果 目标 < 0 则
             如果 宽松未定义 则
                 将 目标 变成 找函数起始("未定义")
             否则
            抛出("未定义函数：" + 补[1])
             结束
        结束
        将 相对 变成 目标 - (补[0] + 4)
        将 权 变成 1
        对于 序 在 范围(0, 4) 中 则
            将 码[补[0] + 序] 变成 向下取整(相对 / 权) % 256
            将 权 变成 权 * 256
        结束
    结束
    返回 码转文本(码)
结束

函数 编译源字节 源 则
    将 文本模式 变成 假
    返回 编译语法树文本(语法程序(源))
结束
函数 编译文本源 源 则
    将 文本模式 变成 真
    将 宽松未定义 变成 真
    将 果 变成 编译语法树文本(语法程序(源))
    将 宽松未定义 变成 假
    将 文本模式 变成 假
    返回 果
结束

函数 编译显示源 源 则
    将 树 变成 语法程序(源)
    将 句 变成 树["语句"][0]
    将 调 变成 句["值"]
    将 参 变成 调["参数"][0]
    将 文 变成 ""
    如果 参["类型"] 等于 "文本" 则
        将 文 变成 参["值"]
    否则如果 参["类型"] 等于 "运算" 且 参["符"] 等于 "+" 则
        如果 参["左"]["类型"] 等于 "文本" 且 参["右"]["类型"] 等于 "文本" 则
            将 文 变成 参["左"]["值"] + 参["右"]["值"]
        结束
    结束
    将 码 变成 编译语法树文本(树)
    返回 {"码": 码, "文本": 文}
结束

导出 编译表达式 编译程序 编译语法树 编译语法树文本 编译源 编译源字节 编译文本源 编译显示源

