        否则如果 节点["符"] 等于 ">" 则
            发多(码, [15, 151, 192])
        否则如果 节点["符"] 等于 ">=" 则
            发多(码, [15, 147, 192])
        否则如果 节点["符"] 等于 "==" 则
            发多(码, [15, 148, 192])
        否则
            发多(码, [15, 149, 192])
        结束
        发多(码, [15, 182, 192])
        返回 0
    结束
    如果 类 等于 "逻辑" 则
        生成表达式(节点["左"], 码, 变量)
        发(码, 80)
        生成表达式(节点["右"], 码, 变量)
        发(码, 89)
        如果 节点["符"] 等于 "且" 则
            发多(码, [72, 33, 200])
        否则
            发多(码, [72, 9, 200])
        结束
        返回 0
    结束
    如果 类 等于 "调用" 则
        将 参数 变成 节点["参数"]
        将 序 变成 长度(参数) - 1
        当 序 >= 0 则
            生成表达式(参数[序], 码, 变量)
            发(码, 80)
            将 序 变成 序 - 1
        结束
        发(码, 232)
        将 位 变成 长度(码)
        发多(码, [0, 0, 0, 0])
        追加(当前调用补丁, [位, 节点["名"]])
        发多(码, [72, 129, 196])
        将 数 变成 8 * 长度(参数)
        将 权 变成 1
        对于 序 在 范围(0, 4) 中 则
            发(码, 向下取整(数 / 权) % 256)
            将 权 变成 权 * 256
        结束
        返回 0
    结束
    返回 0
结束

函数 生成语句 节点 码 变量 则
    将 类 变成 节点["类型"]
    如果 类 等于 "赋值" 则
        生成表达式(节点["值"], 码, 变量)
        将 槽 变成 取槽(变量, 节点["名"])
        发地址(码, [72, 137, 133], 槽)
        返回 0
    结束
    如果 类 等于 "返回" 则
        生成表达式(节点["值"], 码, 变量)
        发多(码, [242, 72, 15, 42, 192, 201, 195])
        返回 0
    结束
    如果 类 等于 "如果" 则
        生成表达式(节点["条件"], 码, 变量)
        发多(码, [72, 133, 192])
        将 假跳 变成 发跳转(码, "je")
        对于 句 在 节点["主体"] 中 则
            生成语句(句, 码, 变量)
        结束
        如果 长度(节点["否则"]) > 0 则
            将 跳过 变成 发跳转(码, "jmp")
            补跳转(码, 假跳, 长度(码))
            对于 句 在 节点["否则"] 中 则
                生成语句(句, 码, 变量)
            结束
            补跳转(码, 跳过, 长度(码))
        否则
            补跳转(码, 假跳, 长度(码))
        结束
        返回 0
    结束
    如果 类 等于 "当" 则
        将 循环头 变成 长度(码)
        生成表达式(节点["条件"], 码, 变量)
        发多(码, [72, 133, 192])
        将 出跳 变成 发跳转(码, "je")
        对于 句 在 节点["主体"] 中 则
            生成语句(句, 码, 变量)
        结束
        将 回跳 变成 发跳转(码, "jmp")
        补跳转(码, 回跳, 循环头)
        补跳转(码, 出跳, 长度(码))
        返回 0
    结束
    返回 0
结束

函数 发正地址 码 偏移 则
    发多(码, [72, 139, 133])
    将 权 变成 1
    对于 序 在 范围(0, 4) 中 则
        发(码, 向下取整(偏移 / 权) % 256)
        将 权 变成 权 * 256
    结束
结束

函数 找函数起始 名 则
    对于 项 在 当前函数表 中 则
        如果 项[0] 等于 名 则
            返回 项[1]
        结束
    结束
    返回 -1
结束

函数 编译语法树 树 则
    将 当前函数表 变成 []
    将 当前调用补丁 变成 []
    将 主句 变成 []
    将 函数们 变成 []
    对于 句 在 树["语句"] 中 则
        如果 句["类型"] 等于 "函数" 则
            追加(函数们, 句)
        否则
            追加(主句, 句)
        结束
    结束
    将 码 变成 [85, 72, 137, 229, 72, 129, 236, 0, 1, 0, 0]
    将 变量 变成 []
    对于 句 在 主句 中 则
        生成语句(句, 码, 变量)
    结束
    发多(码, [72, 199, 192, 0, 0, 0, 0, 242, 72, 15, 42, 192, 201, 195])
    对于 函 在 函数们 中 则
        将 起点 变成 长度(码)
        追加(当前函数表, [函["名"], 起点])
        发多(码, [85, 72, 137, 229, 72, 129, 236, 0, 1, 0, 0])
        将 变量 变成 []
        将 序号 变成 0
        对于 参 在 函["参数"] 中 则
            追加(变量, 参)
            将 槽 变成 取槽(变量, 参)
            发正地址(码, 16 + 8 * 序号)
            发地址(码, [72, 137, 133], 槽)
            将 序号 变成 序号 + 1
        结束
        对于 句 在 函["主体"] 中 则
            生成语句(句, 码, 变量)
        结束
        发多(码, [72, 199, 192, 0, 0, 0, 0, 242, 72, 15, 42, 192, 201, 195])
    结束
    对于 补 在 当前调用补丁 中 则
        将 目标 变成 找函数起始(补[1])
        将 相对 变成 目标 - (补[0] + 4)
        将 权 变成 1
        对于 序 在 范围(0, 4) 中 则
            将 码[补[0] + 序] 变成 向下取整(相对 / 权) % 256
            将 权 变成 权 * 256
        结束
    结束
    返回 机器函数(码转文本(码))
结束

函数 编译源 源 则
    返回 编译语法树(语法程序(源))
