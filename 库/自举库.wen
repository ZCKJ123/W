                补跳转(码, 跳过, 长度(码))
            否则
                补跳转(码, 假跳, 长度(码))
            结束
        否则如果 行[0] 等于 "当" 则
            将 条件 变成 条件文本(行)
            将 循环头 变成 长度(码)
            将 临时 变成 [记号化(条件), 0, 码, 变量]
            读逻辑(临时)
            发多(码, [72, 133, 192])
            将 出跳 变成 发跳转(码, "je")
            将 结果 变成 编译块(状态, "结束")
            将 回跳 变成 发跳转(码, "jmp")
            补跳转(码, 回跳, 循环头)
            补跳转(码, 出跳, 长度(码))
        否则如果 长度(行) > 3 且 行[0] 等于 "将" 且 行[1] 等于 " " 则
            将 部分 变成 分割(行, " ")
            将 名 变成 部分[1]
            将 文本 变成 表达式文本(部分, 3)
            将 临时 变成 [记号化(文本), 0, 码, 变量]
            读逻辑(临时)
            将 槽 变成 取槽(变量, 名)
            发地址(码, [72, 137, 133], 槽)
        否则如果 长度(行) > 2 且 行[0] 等于 "返" 且 行[1] 等于 "回" 则
            将 文本 变成 修剪(行[2:长度(行)])
            将 临时 变成 [记号化(文本), 0, 码, 变量]
            读逻辑(临时)
            发多(码, [242, 72, 15, 42, 192, 201, 195])
        结束
    结束
    返回 "结束"
结束

函数 编译程序 源 则
    将 码 变成 [85, 72, 137, 229, 72, 129, 236, 0, 1, 0, 0]
