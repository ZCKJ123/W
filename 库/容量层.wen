# 容量层：文语言自带的去重 / 快照链 / 校验内核
# 用法：
#   将 层 变成 新建容量层()
#   存值(层, "v0", 某缓冲)
#   存值(层, "v1", 改过的缓冲)     # 自动和上一版做差分，只存变化的分块
#   将 回 变成 取值(层, "v1")
#   打印 容量报告(层)
#
# 差分方式：新旧块号列表求公共前缀/后缀，只存中间变化的部分

依赖 文件库
依赖 数学库
依赖 哈希库

将 块最小 变成 256
将 块最大 变成 1024

函数 新建容量层 则
    返回 {"块仓": [], "块表": {}, "链": {}, "块字节": 0, "清单字节": 0}
结束

函数 切块 缓 则
    局部 块们 变成 []
    局部 总长 变成 缓冲长度(缓)
    局部 起 变成 0
    当 起 < 总长 则
        局部 哈 变成 0
        局部 止 变成 起
        当 止 < 总长 则
            将 哈 变成 (哈 * 2 + 缓冲读(缓, 止) * 2654435761) % 4294967296
            局部 块长 变成 止 - 起 + 1
            如果 块长 >= 块最小 则
                如果 哈 % 256 等于 0 则
                    将 止 变成 止 + 1
                    中断
                结束
            结束
            如果 块长 >= 块最大 则
                将 止 变成 止 + 1
                中断
            结束
            将 止 变成 止 + 1
        结束
        追加(块们, [起, 止])
        将 起 变成 止
    结束
    返回 块们
结束

函数 复制范围 源 起 止 则
    局部 复长 变成 止 - 起
    局部 出 变成 新建缓冲(复长, 0)
    局部 复序 变成 0
    当 复序 < 复长 则
        缓冲写(出, 复序, 缓冲读(源, 起 + 复序))
        将 复序 变成 复序 + 1
    结束
    返回 出
结束

函数 收块 层 源 起 止 则
    局部 片 变成 复制范围(源, 起, 止)
    局部 指 变成 缓冲SHA256(片)
    局部 表 变成 层["块表"]
    如果 有键(表, 指) 则
        返回 表[指]
    结束
    局部 仓 变成 层["块仓"]
    局部 号 变成 长度(仓)
    追加(仓, 片)
    将 表[指] 变成 号
    将 层["块字节"] 变成 层["块字节"] + 缓冲长度(片)
    返回 号
结束

函数 块号们 层 缓 则
    局部 块们 变成 切块(缓)
    局部 号们 变成 []
    对于 块 在 块们 中 则
        追加(号们, 收块(层, 缓, 块[0], 块[1]))
    结束
    返回 号们
结束

# 存一版：和「上一键」做差分，只记中间变化的块号
函数 存值 层 版键 缓 则
    局部 新号们 变成 块号们(层, 缓)
    局部 链 变成 层["链"]
    如果 长度(链) 等于 0 则
        将 链[版键] 变成 {"基": "", "号们": 新号们}
        将 层["清单字节"] 变成 层["清单字节"] + 长度(新号们) * 12 + 8
        返回 新号们
    结束
    # 找上一版
    局部 上键 变成 ""
    对于 旧键 在 键(链) 中 则
        将 上键 变成 旧键
    结束
    将 旧号们 变成 全号们(层, 上键)
    局部 前 变成 0
    当 前 < 长度(新号们) 则
        如果 前 < 长度(旧号们) 则
            如果 新号们[前] 等于 旧号们[前] 则
                将 前 变成 前 + 1
            否则
                中断
            结束
        否则
            中断
        结束
    结束
    局部 后 变成 0
    当 后 < 长度(新号们) - 前 则
        如果 后 < 长度(旧号们) - 前 则
            如果 新号们[长度(新号们) - 1 - 后] 等于 旧号们[长度(旧号们) - 1 - 后] 则
                将 后 变成 后 + 1
            否则
                中断
            结束
        否则
            中断
        结束
    结束
    局部 中段 变成 []
    局部 序 变成 前
    当 序 < 长度(新号们) - 后 则
        追加(中段, 新号们[序])
        将 序 变成 序 + 1
    结束
    将 链[版键] 变成 {"基": 上键, "前": 前, "后": 后, "中": 中段}
    将 层["清单字节"] 变成 层["清单字节"] + 长度(中段) * 12 + 24
    返回 新号们
结束

# 递归取出一版的完整块号列表
函数 全号们 层 版键 则
    局部 链 变成 层["链"]
    如果 非 有键(链, 版键) 则
        返回 []
    结束
    局部 节 变成 链[版键]
    如果 非 有键(节, "号们") 则
        局部 基 变成 节["基"]
        局部 旧 变成 全号们(层, 基)
        局部 出 变成 []
        局部 序 变成 0
        当 序 < 节["前"] 则
            追加(出, 旧[序])
            将 序 变成 序 + 1
        结束
        对于 号 在 节["中"] 中 则
            追加(出, 号)
        结束
        将 序 变成 长度(旧) - 节["后"]
        当 序 < 长度(旧) 则
            追加(出, 旧[序])
            将 序 变成 序 + 1
        结束
        返回 出
    结束
    返回 节["号们"]
结束

# 取回一版数据
函数 取值 层 版键 则
    局部 号们 变成 全号们(层, 版键)
    局部 仓 变成 层["块仓"]
    局部 长 变成 0
    对于 号 在 号们 中 则
        将 长 变成 长 + 缓冲长度(仓[号])
    结束
    局部 出 变成 新建缓冲(长, 0)
    局部 位 变成 0
    对于 号 在 号们 中 则
        局部 片 变成 仓[号]
        局部 序 变成 0
        当 序 < 缓冲长度(片) 则
            缓冲写(出, 位, 缓冲读(片, 序))
            将 位 变成 位 + 1
            将 序 变成 序 + 1
        结束
    结束
    返回 出
结束

函数 容量报告 层 则
    局部 逻辑 变成 0
    对于 项键 在 键(层["链"]) 中 则
        将 逻辑 变成 逻辑 + 缓冲长度(取值(层, 项键))
    结束
    局部 物理 变成 层["块字节"] + 层["清单字节"]
    局部 倍 变成 0
    如果 物理 > 0 则
        将 倍 变成 逻辑 / 物理
    结束
    返回 {"逻辑": 逻辑, "物理": 物理, "倍数": 倍, "块数": 长度(层["块仓"]), "键数": 长度(层["链"])}
结束

# 键级默克尔根
函数 容量指纹 层 则
    局部 文 变成 ""
    对于 项键 在 键(层["链"]) 中 则
        将 文 变成 文 + 项键 + "=" + 缓冲SHA256(取值(层, 项键)) + ";"
    结束
    返回 SHA256(文)
结束

# 体与容量层：体先转缓冲，再按内容去重存进来
函数 存体 层 键 体 则
    返回 存值(层, 键, 体转缓冲(体))
结束

函数 取体 层 键 则
    局部 缓 变成 取值(层, 键)
    如果 缓冲长度(缓) 等于 0 则
        返回 空
    结束
    返回 缓冲转体(缓)
结束