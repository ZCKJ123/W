依赖 数学库
依赖 集合库
依赖 文件库
依赖 解析库
将 求值环境 变成 {}
将 求值函数 变成 {}
函数 求表达式 节点 则
    将 类 变成 节点["类型"]
    如果 类 等于 "数字" 则
        返回 小数(节点["值"])
    结束
    如果 类 等于 "度数" 则
        返回 小数(节点["值"])
    结束
    如果 类 等于 "文本" 则
        返回 节点["值"]
    结束
    如果 类 等于 "格式文本" 则
        将 文 变成 节点["值"]
        将 出 变成 ""
        将 序 变成 0
        当 序 < 长度(文) 则
            将 字 变成 文[序]
            如果 字 等于 "{" 且 序 + 1 < 长度(文) 且 文[序 + 1] 等于 "{" 则
                将 出 变成 出 + "{"
                将 序 变成 序 + 2
            否则如果 字 等于 "}" 且 序 + 1 < 长度(文) 且 文[序 + 1] 等于 "}" 则
                将 出 变成 出 + "}"
                将 序 变成 序 + 2
            否则如果 字 等于 "{" 则
                将 闭 变成 序 + 1
                当 闭 < 长度(文) 且 文[闭] 不等于 "}" 则
                    将 闭 变成 闭 + 1
                结束
                将 式 变成 文[序 + 1:闭]
                将 出 变成 出 + 文本(求表达式(语法表达式(式)))
                将 序 变成 闭 + 1
            否则
                将 出 变成 出 + 字
                将 序 变成 序 + 1
            结束
        结束
        返回 出
    结束
    如果 类 等于 "字典" 则
        将 对 变成 {}
        将 序 变成 0
        对于 键项 在 节点["键"] 中 则
            将 对[文本(求表达式(键项))] 变成 求表达式(节点["值"][序])
            将 序 变成 序 + 1
        结束
        返回 对
    结束
    如果 类 等于 "列表" 则
        将 列 变成 []
        对于 项 在 节点["项"] 中 则
            追加(列, 求表达式(项))
        结束
        返回 列
    结束
    如果 类 等于 "下标" 则
        将 对 变成 求表达式(节点["对象"])
        将 键值 变成 求表达式(节点["键"])
        如果 类型(对) 等于 "字典" 则
            返回 对[文本(键值)]
        结束
        将 键值 变成 整数(键值)
        如果 键值 < 0 则
            将 键值 变成 长度(对) + 键值
        结束
        返回 对[键值]
    结束
    如果 类 等于 "切片" 则
        将 对 变成 求表达式(节点["对象"])
        将 长 变成 长度(对)
        将 步 变成 整数(求表达式(节点["步"]))
        将 起 变成 0
        将 止 变成 长
        如果 节点["起"]["类型"] 不等于 "空" 则
            将 起 变成 整数(求表达式(节点["起"]))
        否则
            如果 步 < 0 则
                将 起 变成 长 - 1
            结束
        结束
        如果 节点["止"]["类型"] 不等于 "空" 则
            将 止 变成 整数(求表达式(节点["止"]))
        否则
            如果 步 < 0 则
                将 止 变成 -1
            结束
        结束
        如果 起 < 0 则
            将 起 变成 长 + 起
        结束
        如果 止 < 0 且 止 不等于 -1 则
            将 止 变成 长 + 止
        结束
        将 出 变成 []
        将 序 变成 起
        如果 步 > 0 则
            当 序 < 止 且 序 < 长 则
                追加(出, 对[序])
                将 序 变成 序 + 步
            结束
        否则
            当 序 > 止 且 序 >= 0 则
                追加(出, 对[序])
                将 序 变成 序 + 步
            结束
        结束
        返回 出
    结束
    如果 类 等于 "名字" 则
        将 名 变成 节点["值"]
        如果 长度(名) > 3 且 名[长度(名) - 3:长度(名)] 等于 "的平方" 则
            将 基 变成 名[0:长度(名) - 3]
            如果 有键(求值环境, 基) 则
                返回 求值环境[基] * 求值环境[基]
            结束
        结束
        如果 长度(名) > 1 且 名[0] 等于 "√" 则
            返回 平方根(小数(名[1:长度(名)]))
        结束
        如果 长度(名) > 1 且 名[长度(名) - 1] 等于 "²" 则
            将 基 变成 名[0:长度(名) - 1]
            如果 有键(求值环境, 基) 则
                返回 求值环境[基] * 求值环境[基]
            结束
        结束
        如果 名 等于 "圆周率" 则
            返回 圆周率
        结束
        如果 有键(求值环境, 节点["值"]) 则
            返回 求值环境[节点["值"]]
        结束
        如果 有键(求值函数, 节点["值"]) 则
            返回 求值函数[节点["值"]]
        结束
        抛出("未定义变量：" + 节点["值"])
    结束
    如果 类 等于 "一元" 则
        将 值 变成 求表达式(节点["值"])
        如果 节点["符"] 等于 "-" 或 节点["符"] 等于 "减" 则
            返回 0 - 值
        结束
        如果 值 等于 0 则
            返回 1
        结束
        返回 0
    结束
    如果 类 等于 "运算" 则
        将 左 变成 求表达式(节点["左"])
        将 右 变成 求表达式(节点["右"])
        如果 节点["符"] 等于 "+" 或 节点["符"] 等于 "加" 则
            返回 左 + 右
        结束
        如果 节点["符"] 等于 "-" 则
            返回 左 - 右
        结束
        如果 节点["符"] 等于 "*" 或 节点["符"] 等于 "×" 或 节点["符"] 等于 "乘" 则
            返回 左 * 右
        结束
        如果 节点["符"] 等于 "**" 则
            返回 左 ** 右
        结束
        如果 节点["符"] 等于 "//" 则
            返回 向下取整(左 / 右)
        结束
        如果 节点["符"] 等于 "/" 或 节点["符"] 等于 "除以" 则
            返回 左 / 右
        结束
        返回 左 % 右
    结束
    如果 类 等于 "比较" 则
        将 左 变成 求表达式(节点["左"])
        将 右 变成 求表达式(节点["右"])
        将 符 变成 节点["符"]
        将 成 变成 0
        如果 符 等于 "==" 则
            将 成 变成 左 等于 右
        否则如果 符 等于 "!=" 则
            将 成 变成 左 不等于 右
        否则如果 符 等于 "<" 则
            将 成 变成 左 < 右
        否则如果 符 等于 "<=" 则
            将 成 变成 左 <= 右
        否则如果 符 等于 ">" 则
            将 成 变成 左 > 右
        否则
            将 成 变成 左 >= 右
        结束
        如果 成 则
            返回 1
        结束
        返回 0
    结束
    如果 类 等于 "包含" 则
        将 左 变成 求表达式(节点["左"])
        将 右 变成 求表达式(节点["右"])
        如果 类型(右) 等于 "列表" 则
            对于 项 在 右 中 则
                如果 项 等于 左 则
                    返回 1
                结束
            结束
        结束
        返回 0
    结束
    如果 类 等于 "逻辑" 则
        将 左 变成 求表达式(节点["左"])
        将 右 变成 求表达式(节点["右"])
        如果 节点["符"] 等于 "且" 则
            如果 左 不等于 0 且 右 不等于 0 则
                返回 1
            结束
            返回 0
        结束
        如果 左 不等于 0 或 右 不等于 0 则
            返回 1
        结束
        返回 0
    结束
    如果 类 等于 "调用" 则
        如果 节点["名"] 等于 "抛出" 则
            抛出(求表达式(节点["参数"][0]))
            返回 0
        结束
        如果 节点["名"] 等于 "新建集合" 则
            返回 新建集合()
        结束
        如果 节点["名"] 等于 "集合添加" 则
            将 集 变成 求表达式(节点["参数"][0])
            集合添加(集, 求表达式(节点["参数"][1]))
            返回 集
        结束
        如果 节点["名"] 等于 "集合存在" 则
            返回 集合存在(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "并集" 则
            返回 并集(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "交集" 则
            返回 交集(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "差集" 则
            返回 差集(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "阶乘" 则
            返回 阶乘(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "最大公约数" 则
            返回 最大公约数(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "最小公倍数" 则
            返回 最小公倍数(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "是否素数" 则
            返回 是否素数(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "质因数分解" 则
            返回 质因数分解(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "平均数" 则
            返回 平均数(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "中位数" 则
            返回 中位数(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "方差" 则
            返回 方差(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "标准差" 则
            返回 标准差(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "样本方差" 则
            返回 样本方差(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "样本标准差" 则
            返回 样本标准差(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "组合数" 则
            返回 组合数(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "排列数" 则
            返回 排列数(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "格式化" 则
            如果 长度(节点["参数"]) 等于 1 则
                返回 格式化(求表达式(节点["参数"][0]))
            结束
            返回 格式化(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "查找" 则
            返回 查找(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "替换" 则
            返回 替换(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]), 求表达式(节点["参数"][2]))
        结束
        如果 节点["名"] 等于 "分割" 则
            返回 分割(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "修剪" 则
            返回 修剪(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "根号" 则
            返回 平方根(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "正弦" 则
            返回 正弦(求表达式(节点["参数"][0]) * 圆周率 / 180.0)
        结束
        如果 节点["名"] 等于 "有键" 则
            返回 有键(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "键" 则
            返回 键(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "值" 则
            将 字 变成 求表达式(节点["参数"][0])
            将 出 变成 []
            对于 键名 在 键(字) 中 则
                追加(出, 字[键名])
            结束
            返回 出
        结束
        如果 节点["名"] 等于 "长度" 则
            返回 长度(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "插入" 则
            将 列 变成 求表达式(节点["参数"][0])
            插入(列, 整数(求表达式(节点["参数"][1])), 求表达式(节点["参数"][2]))
            返回 列
        结束
        如果 节点["名"] 等于 "弹出" 则
            返回 弹出(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "追加" 则
            将 列 变成 求表达式(节点["参数"][0])
            追加(列, 求表达式(节点["参数"][1]))
            返回 列
        结束
        如果 节点["名"] 等于 "排序" 则
            返回 排序(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "反转" 则
            返回 反转(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "求和" 则
            返回 求和(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "范围" 则
            返回 范围(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "文本" 则
            返回 文本(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "整数" 则
            返回 整数(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "小数" 则
            返回 小数(求表达式(节点["参数"][0]))
        结束
        将 函 变成 空
        如果 有键(求值环境, 节点["名"]) 则
            如果 求值环境[节点["名"]]["类型"] 等于 "函数" 则
                将 函 变成 求值环境[节点["名"]]
            结束
        结束
        如果 函 等于 空 且 有键(求值函数, 节点["名"]) 则
            将 函 变成 求值函数[节点["名"]]
        结束
        如果 函 等于 空 则
            抛出("未定义函数：" + 节点["名"])
        结束
        返回 调用函数(函, 节点)
    结束
    抛出("求值器暂不支持：" + 类)
结束
函数 调用函数 函 节点 则
    将 值们 变成 []
    对于 项 在 节点["参数"] 中 则
        追加(值们, 求表达式(项))
    结束
    将 旧 变成 求值环境
    将 新 变成 {}
    如果 有键(函, "环境") 则
        将 新 变成 函["环境"]
    结束
    将 序 变成 0
    对于 名 在 函["参数"] 中 则
        如果 序 < 长度(值们) 则
            将 新[名] 变成 值们[序]
        否则
            将 默 变成 函["默认"][序]
            如果 默 不等于 "" 则
                将 新[名] 变成 小数(默)
            否则
                将 新[名] 变成 0
            结束
        结束
        将 序 变成 序 + 1
    结束
    将 求值环境 变成 新
    将 结 变成 求块(函["主体"])
    将 求值环境 变成 旧
    如果 结[0] 等于 1 则
        返回 结[1]
    结束
    返回 0
结束
函数 求块 语句们 则
    对于 句 在 语句们 中 则
        将 类 变成 句["类型"]
        如果 类 等于 "尝试" 则
            尝试
                将 结 变成 求块(句["主体"])
            捕获 错
                将 求值环境[句["捕名"]] 变成 错
                将 结 变成 求块(句["捕获"])
            最终
                求块(句["最终"])
            结束
            如果 结[0] 不等于 0 则
                返回 结
            结束
        否则如果 类 等于 "函数" 则
            将 句["环境"] 变成 求值环境
            将 求值环境[句["名"]] 变成 句
        否则如果 类 等于 "下标赋值" 则
            将 根 变成 求值环境[句["名"]]
            将 对 变成 根
            将 路径 变成 句["路径"]
            对于 序 在 范围(0, 长度(路径) - 1) 中 则
                将 对 变成 对[整数(求表达式(路径[序]))]
            结束
            将 末 变成 求表达式(路径[长度(路径) - 1])
            如果 类型(对) 等于 "字典" 则
                将 对[文本(末)] 变成 求表达式(句["值"])
            否则
                将 末 变成 整数(末)
                将 对[末] 变成 求表达式(句["值"])
            结束
            将 求值环境[句["名"]] 变成 根
        否则如果 类 等于 "表达式" 则
            求表达式(句["值"])
        否则如果 类 等于 "复合赋值" 则
            将 旧 变成 求值环境[句["名"]]
            将 右 变成 求表达式(句["值"])
            如果 句["符"] 等于 "+=" 则
                将 求值环境[句["名"]] 变成 旧 + 右
            否则如果 句["符"] 等于 "-=" 则
                将 求值环境[句["名"]] 变成 旧 - 右
            否则如果 句["符"] 等于 "*=" 则
                将 求值环境[句["名"]] 变成 旧 * 右
            否则
                将 求值环境[句["名"]] 变成 旧 / 右
            结束
        否则如果 类 等于 "赋值" 则
            将 求值环境[句["名"]] 变成 求表达式(句["值"])
        否则如果 类 等于 "打印" 则
            对于 项 在 句["参数"] 中 则
                打印 求表达式(项)
            结束
        否则如果 类 等于 "返回" 则
            返回 [1, 求表达式(句["值"])]
        否则如果 类 等于 "中断" 则
            返回 [2, 0]
        否则如果 类 等于 "继续" 则
            返回 [3, 0]
        否则如果 类 等于 "如果" 则
            如果 求表达式(句["条件"]) 不等于 0 则
                将 结 变成 求块(句["主体"])
                如果 结[0] 不等于 0 则
                    返回 结
                结束
            否则
                将 结 变成 求块(句["否则"])
                如果 结[0] 不等于 0 则
                    返回 结
                结束
            结束
        否则如果 类 等于 "对于" 则
            将 列 变成 求表达式(句["迭"])
            如果 类型(列) 等于 "字典" 则
                对于 键名 在 键(列) 中 则
                    将 求值环境[句["名"]] 变成 键名
                    如果 句["名2"] 不等于 "" 则
                        将 求值环境[句["名2"]] 变成 列[键名]
                    结束
                    将 结 变成 求块(句["主体"])
                    如果 结[0] 等于 1 则
                        返回 结
                    结束
                    如果 结[0] 等于 2 则
                        中断
                    结束
                结束
            否则
                对于 值 在 列 中 则
                    将 求值环境[句["名"]] 变成 值
                    将 结 变成 求块(句["主体"])
                    如果 结[0] 等于 1 则
                        返回 结
                    结束
                    如果 结[0] 等于 2 则
                        中断
                    结束
                结束
            结束
        否则如果 类 等于 "当" 则
            将 次 变成 0
            当 求表达式(句["条件"]) 不等于 0 则
                将 结 变成 求块(句["主体"])
                如果 结[0] 等于 1 则
                    返回 结
                结束
                如果 结[0] 等于 2 则
                    中断
                结束
                如果 结[0] 等于 3 则
                    继续
                结束
                将 次 变成 次 + 1
                如果 次 > 1000000 则
                    抛出("循环次数过多")
                结束
            结束
        结束
    结束
    返回 [0, 0]
结束
函数 加载库 名 则
    将 路 变成 "库/" + 名 + ".wen"
    如果 文件存在(路) 则
        将 树 变成 语法程序(读文件(路))
        对于 句 在 树["语句"] 中 则
            如果 句["类型"] 等于 "函数" 则
                将 求值函数[句["名"]] 变成 句
            结束
        结束
    结束
结束
函数 求值源 源 则
    将 树 变成 语法程序(源)
    将 求值环境 变成 {}
    将 求值函数 变成 {}
    将 主句 变成 []
    对于 句 在 树["语句"] 中 则
        如果 句["类型"] 等于 "依赖" 则
            对于 库名 在 句["名们"] 中 则
                加载库(库名)
            结束
        否则如果 句["类型"] 等于 "函数" 则
            将 求值函数[句["名"]] 变成 句
        否则
            追加(主句, 句)
        结束
    结束
    将 结 变成 求块(主句)
    如果 结[0] 等于 1 则
        返回 结[1]
    结束
    返回 0
结束
函数 求值文件 路径 则
    返回 求值源(读文件(路径))
结束
函数 运行文言 路径 则
    返回 求值文件(路径)
结束
导出 求表达式 求值源 求值文件 运行文言
