        如果 节点["名"] 等于 "追加" 则
            将 列 变成 求表达式(节点["参数"][0])
            追加(列, 求表达式(节点["参数"][1]))
            返回 列
        结束
        如果 节点["名"] 等于 "排序" 则
            返回 排序(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "反转" 则
            返回 反转(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "求和" 则
            返回 求和(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "范围" 则
            返回 范围(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "文本" 则
            返回 文本(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "整数" 则
            返回 整数(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "小数" 则
            返回 小数(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "调用" 则
            将 名参 变成 节点["参数"][0]
            将 名值 变成 名参["值"]
            将 列 变成 求表达式(节点["参数"][1])
            将 参们 变成 []
            对于 项 在 列 中 则
                追加(参们, {"类型": "值", "值": 项})
            结束
            返回 求表达式({"类型": "调用", "名": 名值, "参数": 参们})
        结束
        如果 节点["名"] 等于 "平方根" 则
            返回 平方根(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "最大" 则
            如果 长度(节点["参数"]) > 1 则
                将 最 变成 求表达式(节点["参数"][0])
                对于 参 在 节点["参数"] 中 则
                    将 值 变成 求表达式(参)
                    如果 值 > 最 则
                        将 最 变成 值
                    结束
                结束
                返回 最
            结束
            返回 最大(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "最小" 则
            如果 长度(节点["参数"]) > 1 则
                将 最 变成 求表达式(节点["参数"][0])
                对于 参 在 节点["参数"] 中 则
                    将 值 变成 求表达式(参)
                    如果 值 < 最 则
                        将 最 变成 值
                    结束
                结束
                返回 最
            结束
            返回 最小(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "查找字节" 则
            返回 查找字节(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "映射" 则
            将 列 变成 求表达式(节点["参数"][0])
            将 新函 变成 取函值(节点["参数"][1]["值"])
            将 出列 变成 []
            对于 项 在 列 中 则
                追加(出列, 调用值(新函, [项]))
            结束
            返回 出列
        结束
        如果 节点["名"] 等于 "过滤" 则
            将 列 变成 求表达式(节点["参数"][0])
            将 新函 变成 取函值(节点["参数"][1]["值"])
            将 出列 变成 []
            对于 项 在 列 中 则
                如果 真值(调用值(新函, [项])) 不等于 0 则
                    追加(出列, 项)
                结束
            结束
            返回 出列
        结束
        如果 节点["名"] 等于 "折叠" 则
            将 列 变成 求表达式(节点["参数"][0])
            将 累 变成 求表达式(节点["参数"][1])
            将 新函 变成 取函值(节点["参数"][2]["值"])
            对于 项 在 列 中 则
                将 累 变成 调用值(新函, [累, 项])
            结束
            返回 累
        结束
        如果 节点["名"] 等于 "任意" 则
            将 列 变成 求表达式(节点["参数"][0])
            将 新函 变成 取函值(节点["参数"][1]["值"])
            对于 项 在 列 中 则
                如果 真值(调用值(新函, [项])) 不等于 0 则
                    返回 "真"
                结束
            结束
            返回 "假"
        结束
        如果 节点["名"] 等于 "全部" 则
            将 列 变成 求表达式(节点["参数"][0])
            将 新函 变成 取函值(节点["参数"][1]["值"])
            对于 项 在 列 中 则
                如果 真值(调用值(新函, [项])) 等于 0 则
                    返回 "假"
                结束
            结束
            返回 "真"
        结束
        如果 节点["名"] 等于 "找到" 则
            将 列 变成 求表达式(节点["参数"][0])
            将 新函 变成 取函值(节点["参数"][1]["值"])
            对于 项 在 列 中 则
                如果 真值(调用值(新函, [项])) 不等于 0 则
                    返回 项
                结束
            结束
            返回 0
        结束
        如果 节点["名"] 等于 "计数" 则
            将 列 变成 求表达式(节点["参数"][0])
            将 新函 变成 取函值(节点["参数"][1]["值"])
            将 数 变成 0
            对于 项 在 列 中 则
                如果 真值(调用值(新函, [项])) 不等于 0 则
                    将 数 变成 数 + 1
                结束
            结束
            返回 数
        结束
        如果 节点["名"] 等于 "排序依据" 则
            将 列 变成 求表达式(节点["参数"][0])
            将 新函 变成 取函值(节点["参数"][1]["值"])
            将 出列 变成 []
            对于 项 在 列 中 则
                将 新键 变成 调用值(新函, [项])
                将 位 变成 长度(出列)
                当 位 > 0 则
                    将 前键 变成 调用值(新函, [出列[位 - 1]])
                    如果 前键 > 新键 则
                        将 位 变成 位 - 1
                    否则
                        中断
                    结束
                结束
                插入(出列, 位, 项)
            结束
            返回 出列
        结束
        如果 节点["名"] 等于 "去重" 则
            将 列 变成 求表达式(节点["参数"][0])
            将 出列 变成 []
            对于 项 在 列 中 则
                将 有 变成 0
                对于 已 在 出列 中 则
                    如果 相等值(已, 项) 等于 1 则
                        将 有 变成 1
                        中断
                    结束
                结束
                如果 有 等于 0 则
                    追加(出列, 项)
                结束
            结束
            返回 出列
        结束
        如果 节点["名"] 等于 "展平" 则
            将 列 变成 求表达式(节点["参数"][0])
            将 出列 变成 []
            对于 项 在 列 中 则
                如果 类型(项) 等于 "列表" 则
                    对于 子 在 项 中 则
                        追加(出列, 子)
                    结束
                否则
                    追加(出列, 项)
                结束
            结束
            返回 出列
        结束
        将 函 变成 空
        如果 有键(求值函数, 节点["名"]) 则
            将 函 变成 求值函数[节点["名"]]
        结束
        如果 函 等于 空 且 有键(求值环境, 节点["名"]) 则
            如果 求值环境[节点["名"]]["类型"] 等于 "函数" 则
                将 函 变成 求值环境[节点["名"]]
            结束
        结束
        如果 函 等于 空 则
            返回 抛出("未定义函数：" + 节点["名"])
        结束
        返回 调用函数(函, 节点)
    结束
    返回 抛出("求值器暂不支持：" + 类)
结束
函数 取函值 名 则
    如果 有键(求值函数, 名) 则
        返回 求值函数[名]
    结束
    如果 有键(求值环境, 名) 则
        将 值 变成 求值环境[名]
        如果 类型(值) 等于 "字典" 则
            如果 有键(值, "类型") 则
                如果 值["类型"] 等于 "函数" 则
                    返回 值
                结束
            结束
        结束
    结束
    返回 空
结束
函数 调用函数 函 节点 则
    将 值们 变成 []
    对于 项 在 节点["参数"] 中 则
        追加(值们, 求表达式(项))
    结束
    返回 调用值(函, 值们)
结束
函数 调用值 函 值们 则
    将 旧 变成 求值环境
    将 新 变成 {}
    如果 有键(求值函数环境, 函["名"]) 则
        将 新 变成 求值函数环境[函["名"]]
    结束
    将 参们 变成 []
    如果 有键(函, "参数") 则
        将 参们 变成 函["参数"]
    结束
    将 序 变成 0
    对于 名 在 参们 中 则
        如果 序 < 长度(值们) 则
            将 新[名] 变成 值们[序]
        否则
            将 默 变成 ""
            如果 有键(函, "默认") 且 序 < 长度(函["默认"]) 则
                将 默 变成 函["默认"][序]
            结束
            如果 默 不等于 "" 则
                将 新[名] 变成 小数(默)
            否则
                将 新[名] 变成 0
            结束
        结束
        将 序 变成 序 + 1
    结束
    将 求值环境 变成 新
    将 结 变成 求块(函["主体"])
    将 求值环境 变成 旧
    如果 结[0] 等于 4 或 结[0] 等于 1 则
        返回 结[1]
    结束
    返回 0
结束
函数 求块 语句们 则
    对于 句 在 语句们 中 则
        将 类 变成 句["类型"]
        如果 类 等于 "抛出" 则
            将 因 变成 求表达式(句["值"])
            将 求值错误值 变成 {"类型": "运行时错误", "原因": 因}
            将 求值错误 变成 1
            返回 [4, 求值错误值]
        否则如果 类 等于 "尝试" 则
            将 结 变成 求块(句["主体"])
            如果 结[0] 等于 4 则
                将 求值环境[句["捕名"]] 变成 结[1]
                将 结 变成 求块(句["捕获"])
            结束
            求块(句["最终"])
            如果 结[0] 不等于 0 则
                返回 结
            结束
        否则如果 类 等于 "函数" 则
            将 求值函数环境[句["名"]] 变成 求值环境
            将 求值函数[句["名"]] 变成 句
        否则如果 类 等于 "下标赋值" 则
            将 根 变成 求值环境[句["名"]]
            将 对 变成 根
            将 路径 变成 句["路径"]
            将 序 变成 0
            当 序 < 长度(路径) - 1 则
                将 键 变成 求表达式(路径[序])
                如果 是文本(键) 则
                    将 对 变成 对[键]
                否则
                    将 对 变成 对[整数(键)]
                结束
                将 序 变成 序 + 1
            结束
            将 末 变成 求表达式(路径[长度(路径) - 1])
            设元素(对, 末, 求表达式(句["值"]))
            将 求值环境[句["名"]] 变成 根
        否则如果 类 等于 "表达式" 则
            将 表值 变成 求表达式(句["值"])
            如果 是错误(表值) 则
                返回 [4, 表值]
            结束
        否则如果 类 等于 "复合赋值" 则
            将 旧 变成 求值环境[句["名"]]
            将 右 变成 求表达式(句["值"])
            如果 句["符"] 等于 "+=" 则
                将 求值环境[句["名"]] 变成 旧 + 右
            否则如果 句["符"] 等于 "-=" 则
                将 求值环境[句["名"]] 变成 旧 - 右
            否则如果 句["符"] 等于 "*=" 则
                将 求值环境[句["名"]] 变成 旧 * 右
            否则
                将 求值环境[句["名"]] 变成 旧 / 右
            结束
        否则如果 类 等于 "赋值" 则
            将 新值 变成 求表达式(句["值"])
            将 求值环境[句["名"]] 变成 新值
            如果 是错误(新值) 则
                返回 [4, 新值]
            结束
        否则如果 类 等于 "打印" 则
            将 首 变成 真
            对于 项 在 句["参数"] 中 则
                如果 非 首 则
                    输出文本(" ")
                结束
                将 首 变成 假
                将 打印值 变成 求表达式(项)
                打印值(打印值)
            结束
            输出文本(换行符())
        否则如果 类 等于 "返回" 则
            将 返值 变成 求表达式(句["值"])
            如果 是错误(返值) 则
                返回 [4, 返值]
            结束
            返回 [1, 返值]
        否则如果 类 等于 "中断" 则
            返回 [2, 0]
        否则如果 类 等于 "继续" 则
            返回 [3, 0]
        否则如果 类 等于 "如果" 则
            如果 真值(求表达式(句["条件"])) 不等于 0 则
                将 结 变成 求块(句["主体"])
                如果 结[0] 不等于 0 则
                    返回 结
                结束
            否则
                将 结 变成 求块(句["否则"])
                如果 结[0] 不等于 0 则
                    返回 结
                结束
            结束
        否则如果 类 等于 "对于" 则
            将 列 变成 求表达式(句["迭"])
            如果 类型(列) 等于 "字典" 则
                对于 键名 在 键(列) 中 则
                    将 求值环境[句["名"]] 变成 键名
                    如果 句["名2"] 不等于 "" 则
                        将 求值环境[句["名2"]] 变成 列[键名]
                    结束
                    将 结 变成 求块(句["主体"])
                    如果 结[0] 等于 4 或 结[0] 等于 1 则
                        返回 结
                    结束
                    如果 结[0] 等于 2 则
                        中断
                    结束
                结束
            否则
                对于 值 在 列 中 则
                    将 求值环境[句["名"]] 变成 值
                    将 结 变成 求块(句["主体"])
                    如果 结[0] 等于 4 或 结[0] 等于 1 则
                        返回 结
                    结束
                    如果 结[0] 等于 2 则
                        中断
                    结束
                结束
            结束
        否则如果 类 等于 "当" 则
            将 次 变成 0
            当 真值(求表达式(句["条件"])) 不等于 0 则
                将 结 变成 求块(句["主体"])
                如果 结[0] 等于 4 则
                    返回 结
                结束
                如果 结[0] 等于 1 则
                    返回 结
                结束
                如果 结[0] 等于 2 则
                    中断
                结束
                如果 结[0] 等于 3 则
                    继续
                结束
                将 次 变成 次 + 1
                如果 次 > 1000000 则
                    返回 抛出("循环次数过多")
                结束
            结束
        结束
    结束
    返回 [0, 0]
结束
函数 加载库 名 则
    将 路 变成 "库/" + 名 + ".wen"
    如果 文件在(路) 则
        将 树 变成 语法程序(读文件(路))
        对于 句 在 树["语句"] 中 则
            如果 句["类型"] 等于 "函数" 则
                将 求值函数[句["名"]] 变成 句
            结束
        结束
    结束
结束
函数 求值源 源 则
    将 树 变成 语法程序(源)
    将 求值环境 变成 {}
    将 求值函数 变成 {}
    将 主句 变成 []
    对于 句 在 树["语句"] 中 则
        如果 句["类型"] 等于 "依赖" 则
            对于 库名 在 句["名们"] 中 则
                加载库(库名)
            结束
        否则如果 句["类型"] 等于 "函数" 则
            将 求值函数[句["名"]] 变成 句
        否则
            追加(主句, 句)
        结束
    结束
    将 结 变成 求块(主句)
    如果 结[0] 等于 4 或 结[0] 等于 1 则
        返回 结[1]
    结束
    返回 0
结束
函数 求值文件 路径 则
    返回 求值源(读文件(路径))
结束
函数 运行文言 路径 则
    返回 求值文件(路径)
结束

函数 求值源简 源 则
    将 树 变成 语法程序(源)
    将 求值错误 变成 0
    将 结 变成 求块(树["语句"])
    如果 结[0] 等于 4 或 结[0] 等于 1 则
        返回 结[1]
    结束
    返回 0
结束
