# 嵌套求值深度标记：>0 时内层 求值源 不清输出、不自己收尾打印，交给外层统一吐。
将 求值嵌套 变成 0
函数 相等值 甲 乙 则
    如果 类型(甲) 等于 "列表" 且 类型(乙) 等于 "列表" 则
        如果 长度(甲) 不等于 长度(乙) 则
            返回 0
        结束
        将 序 变成 0
        当 序 < 长度(甲) 则
            如果 相等值(甲[序], 乙[序]) 等于 0 则
                返回 0
            结束
            将 序 变成 序 + 1
        结束
        返回 1
    结束
    如果 甲 等于 乙 则
        返回 1
    结束
    返回 0
结束

函数 是物理常量 名 则
    如果 名 等于 "光速" 则
        返回 1
    结束
    如果 名 等于 "重力加速度" 则
        返回 1
    结束
    如果 名 等于 "声速" 则
        返回 1
    结束
    如果 名 等于 "万有引力常数" 则
        返回 1
    结束
    如果 名 等于 "普朗克常数" 则
        返回 1
    结束
    如果 名 等于 "电子电荷" 则
        返回 1
    结束
    如果 名 等于 "阿伏伽德罗常数" 则
        返回 1
    结束
    如果 名 等于 "理想气体常数" 则
        返回 1
    结束
    如果 名 等于 "静电力常量" 则
        返回 1
    结束
    返回 0
结束

函数 查控制位 值 层 则
    # 宿主 继续/中断 在循环外报运行时错误「「继续」只能用在循环里」；
    # 求值器原来直接返回控制码，脚本在宿主上跑不过、在这里 rc=0 静默通过。
    # 只用块字段递归，不去碰表达式树，避免把别的「继续」误判。
    如果 类型(值) 等于 "列表" 则
        对于 项 在 值 中 则
            将 子错 变成 查控制位(项, 层)
            如果 字符长(子错) > 0 则
                返回 子错
            结束
        结束
        返回 ""
    结束
    如果 类型(值) 不等于 "字典" 则
        返回 ""
    结束
    将 子层 变成 层
    将 本类 变成 ""
    如果 有键(值, "类型") 则
        将 本类 变成 值["类型"]
    结束
    如果 本类 等于 "继续" 则
        如果 层 等于 0 则
            返回 "「继续」只能用在循环里"
        结束
    结束
    如果 本类 等于 "中断" 则
        如果 层 等于 0 则
            返回 "「中断」只能用在循环里"
        结束
    结束
    如果 本类 等于 "当" 则
        将 子层 变成 层 + 1
    结束
    如果 本类 等于 "对于" 则
        将 子层 变成 层 + 1
    结束
    对于 部名 在 键(值) 中 则
        如果 部名 等于 "语句" 或 部名 等于 "主体" 或 部名 等于 "否则" 或 部名 等于 "捕获" 或 部名 等于 "最终" 或 部名 等于 "分支" 则
            将 子错 变成 查控制位(值[部名], 子层)
            如果 字符长(子错) > 0 则
                返回 子错
            结束
        结束
    结束
    返回 ""
结束

函数 记依赖 源 则
    # 只认行首的「依赖」。宿主写 依赖 物理库 或 依赖 数学库, 物理库 两种都收，
    # 逗号后可能带空格，也可能用全角逗号，这里一律切干净。
    将 行们 变成 分割(源, 换行符())
    对于 行 在 行们 中 则
        将 行文 变成 修剪(行)
        如果 字符长(行文) > 2 则
            如果 缓冲转文本(字符切片(行文, 0, 2)) 等于 "依赖" 则
                将 尾 变成 修剪(缓冲转文本(字符切片(行文, 2, 字符长(行文))))
                # 一行里可以写多条：依赖 A; 依赖 B（宿主按分号切语句），
                # 全角分号也可能出现；逗号是同一句里的库列表。四层分开切。
                将 组们 变成 分割(尾, "；")
                对于 组 在 组们 中 则
                将 组分们 变成 分割(组, ";")
                对于 组分 在 组分们 中 则
                将 段们 变成 分割(组分, "，")
                对于 大段 在 段们 中 则
                    将 小段们 变成 分割(大段, ",")
                    对于 小段 在 小段们 中 则
                        将 库名 变成 修剪(小段)
                        如果 字符长(库名) > 2 则
                            如果 缓冲转文本(字符切片(库名, 0, 2)) 等于 "依赖" 则
                                将 库名 变成 修剪(缓冲转文本(字符切片(库名, 2, 字符长(库名))))
                            结束
                        结束
                        # 宿主 加载模块 有一层别名（wen.cpp 4607）：翻译器/外派库 都落成
                        # 兼容库，JSON库 落成 数据格式库…不归一会把 46反编译 误判成缺依赖。
                        如果 库名 等于 "JSON库" 则
                            将 库名 变成 "数据格式库"
                        结束
                        如果 库名 等于 "HTML库" 则
                            将 库名 变成 "网页库"
                        结束
                        如果 库名 等于 "加速库" 则
                            将 库名 变成 "跃迁库"
                        结束
                        如果 库名 等于 "外派库" 则
                            将 库名 变成 "兼容库"
                        结束
                        如果 库名 等于 "安全库" 则
                            将 库名 变成 "网络库"
                        结束
                        如果 库名 等于 "检测库" 则
                            将 库名 变成 "网络库"
                        结束
                        如果 库名 等于 "翻译器" 则
                            将 库名 变成 "兼容库"
                        结束
                        如果 字符长(库名) > 0 则
                            # 宿主 加载模块 认不出库名时报「找不到库…」；
                            # 求值器以前整行 依赖 当注释跳过，于是错库被静默吞掉。
                            如果 非 有键(求值已知库, 库名) 则
                                如果 求值缺库 等于 "" 则
                                    将 求值缺库 变成 库名
                                结束
                            结束
                            将 求值依赖[库名] 变成 1
                        结束
                    结束
                结束
                结束
                结束
            结束
        结束
    结束
结束

函数 需数字 左 右 符 则
    # 宿主对算术算子的报错是「「-」需要数字，收到文本」这种按算子归因的写法。
    # 求值器原来把左右直接丢给 减法/乘法 这几个库辅助，它们一律报
    # 「不是有效整数：甲」，用户看不出是哪个算子、也看不出是哪边错的。
    如果 类型(左) 不等于 "数字" 则
        返回 造错("「" + 符 + "」需要数字，收到" + 类型(左))
    结束
    如果 类型(右) 不等于 "数字" 则
        返回 造错("「" + 符 + "」需要数字，收到" + 类型(右))
    结束
    返回 空
结束

函数 求表达式 节点 则
    将 类 变成 节点["类型"]
    如果 类 等于 "值" 则
        返回 节点["值"]
    结束
    如果 类 等于 "数字" 则
        返回 小数(节点["值"])
    结束
    如果 类 等于 "布尔" 则
        # 返回真布尔，而不是 1/0：原来返回数字，生成JSON 出来的 true 就变成 1
        # （10数据格式 最后一行 "甲":[1,2,true,null] 对不上）。
        # 配套改动：真值 里补了布尔分支，否则 假 会被数不等(假,0) 判成真。
        如果 节点["值"] 等于 "真" 则
            返回 真
        结束
        返回 假
    结束
    如果 类 等于 "空值" 则
        返回 空
    结束
    如果 类 等于 "空" 则
        返回 空
    结束
    如果 类 等于 "度数" 则
        返回 小数(节点["值"])
    结束
    如果 类 等于 "文本" 则
        返回 节点["值"]
    结束
    如果 类 等于 "格式文本" 则
        将 文 变成 节点["值"]
        将 出 变成 ""
        将 序 变成 0
        当 序 < 字符长(文) 则
            将 字 变成 字符取(文, 序)
            如果 字 等于 "{" 且 序 + 1 < 字符长(文) 且 字符取(文, 序 + 1) 等于 "{" 则
                将 出 变成 出 + "{"
                将 序 变成 序 + 2
            否则如果 字 等于 "}" 且 序 + 1 < 字符长(文) 且 字符取(文, 序 + 1) 等于 "}" 则
                将 出 变成 出 + "}"
                将 序 变成 序 + 2
            否则如果 字 等于 "{" 则
                将 闭 变成 序 + 1
                当 闭 < 字符长(文) 且 字符取(文, 闭) 不等于 "}" 则
                    将 闭 变成 闭 + 1
                结束
                将 式 变成 字符切片(文, 序 + 1, 闭)
                将 出 变成 出 + 文本(求表达式(语法表达式(式)))
                将 序 变成 闭 + 1
            否则
                将 出 变成 出 + 字
                将 序 变成 序 + 1
            结束
        结束
        返回 出
    结束
    如果 类 等于 "字典" 则
        将 对 变成 {}
        将 序 变成 0
        对于 键项 在 节点["键"] 中 则
            将 对[文本(求表达式(键项))] 变成 求表达式(节点["值"][序])
            将 序 变成 序 + 1
        结束
        返回 对
    结束
    如果 类 等于 "列表" 则
        将 列 变成 []
        对于 项 在 节点["项"] 中 则
            追加(列, 求表达式(项))
        结束
        返回 列
    结束
    如果 类 等于 "下标" 则
        将 对 变成 求表达式(节点["对象"])
        将 键值 变成 求表达式(节点["键"])
        如果 是文本(对) 则
            # 宿主：「文本下标」需要数字，收到文本
            如果 类型(键值) 不等于 "数字" 则
                返回 造错("「文本下标」需要数字，收到" + 类型(键值))
            结束
            将 键值 变成 整数(键值)
            将 个 变成 字符长(对)
            如果 键值 < 0 则
                将 键值 变成 个 + 键值
            结束
            # 文本下标越界要报错：宿主实测文案是「文本下标越界：5」，原来这里直接 字符取
            # 返回空串，145字符串错误 的 尝试/捕获 永远等不到错误。
            如果 键值 < 0 或 键值 >= 个 则
                返回 造错("文本下标越界：" + 文本(键值))
            结束
            返回 字符取(对, 键值)
        结束
        # 字典下标：{"甲": 90}["甲"] 这种。原来直接走「长度 vs 列表长」的探测，
        # 宿主真字典在那一支里被当成列表，接着 整数("甲") 就报「不是有效数字：甲」。
        # 字典的键是文本，不能转整数，必须先按真实类型分流。
        如果 类型(对) 等于 "字典" 则
            # 宿主：「字典的键必须是文本」；原来非文本键会被 文本(键值) 拼成「2」，
            # 报成「字典里没有键「2」」，把「键类型错」误读成「缺键」。
            如果 类型(键值) 不等于 "文本" 则
                返回 造错("字典的键必须是文本")
            结束
            # 缺键不能靠宿主下标抛异常：那条路是 C++ 异常，求值器里没有 try，
            # 会直接穿透整次求值，连 尝试/捕获 都拦不住（144字典错误 就是这么崩的）。
            # 宿主这个错误是可捕获的运行时错误，这里也要返回错误对象、让 尝试 接住。
            如果 非 有键(对, 文本(键值)) 则
                返回 造错("字典里没有键「" + 文本(键值) + "」")
            结束
            返回 对[键值]
        结束
        如果 长度(对) 不等于 列表长(对) 则
            返回 对[键值]
        结束
        # 宿主：「列表下标」需要数字，收到文本；原来是 整数("甲") 报「不是有效数字：甲」
        如果 类型(键值) 不等于 "数字" 则
            返回 造错("「列表下标」需要数字，收到" + 类型(键值))
        结束
        将 键值 变成 整数(键值)
        如果 键值 < 0 则
            将 键值 变成 长度(对) + 键值
        结束
        # 负下标换算完还小于 0：宿主报「列表下标越界：-1（长度 2）」。
        # 不挡这一下，宿主的下标会把 -1 当代末元素返回，静默算出错误结果。
        如果 键值 < 0 则
            返回 造错("列表下标越界：" + 文本(键值) + "（长度 " + 文本(长度(对)) + "）")
        结束
        如果 键值 >= 长度(对) 则
            # 文案对齐宿主：宿主是「列表下标越界：5（长度 3）」，带上建议由 CLI 补。
            返回 造错("列表下标越界：" + 文本(键值) + "（长度 " + 文本(长度(对)) + "）")
        结束
        返回 对[键值]
    结束
    如果 类 等于 "切片" 则
        将 对 变成 求表达式(节点["对象"])
        如果 是文本(对) 则
            将 长 变成 字符长(对)
            将 步 变成 整数(求表达式(节点["步"]))
            将 起 变成 0
            将 止 变成 长
            如果 节点["起"]["类型"] 不等于 "空" 则
                将 起 变成 整数(求表达式(节点["起"]))
            否则
                如果 步 < 0 则
                    将 起 变成 长 - 1
                结束
            结束
            如果 节点["止"]["类型"] 不等于 "空" 则
                将 止 变成 整数(求表达式(节点["止"]))
            否则
                如果 步 < 0 则
                    将 止 变成 -1
                结束
            结束
            如果 起 < 0 则
                将 起 变成 长 + 起
            结束
            如果 止 < 0 且 止 不等于 -1 则
                将 止 变成 长 + 止
            结束
            将 出 变成 ""
            将 序 变成 起
            如果 步 > 0 则
                当 序 < 止 且 序 < 长 则
                    # 这里原来用 字符串连接 拼 —— 它在 自举运行时 里返回的是**缓冲**，
                    # 于是整段文本切片的返回值变成缓冲，下一句「文 + 切片结果」就报
                    # 「「+」不支持文本和缓冲」（151 的 直线翻译机器码 正是死在这）。
                    # 直接用 + 拼：左是文本、字符取 也返回文本，结果稳定是文本。
                    将 出 变成 出 + 字符取(对, 序)
                    将 序 变成 序 + 步
                结束
            否则
                当 序 > 止 且 序 >= 0 则
                    将 出 变成 出 + 字符取(对, 序)
                    将 序 变成 序 + 步
                结束
            结束
            返回 出
        结束
        将 长 变成 长度(对)
        将 步 变成 整数(求表达式(节点["步"]))
        将 起 变成 0
        将 止 变成 长
        如果 节点["起"]["类型"] 不等于 "空" 则
            将 起 变成 整数(求表达式(节点["起"]))
        否则
            如果 步 < 0 则
                将 起 变成 长 - 1
            结束
        结束
        如果 节点["止"]["类型"] 不等于 "空" 则
            将 止 变成 整数(求表达式(节点["止"]))
        否则
            如果 步 < 0 则
                将 止 变成 -1
            结束
        结束
        如果 起 < 0 则
            将 起 变成 长 + 起
        结束
        如果 止 < 0 且 止 不等于 -1 则
            将 止 变成 长 + 止
        结束
        将 出 变成 []
        将 序 变成 起
        如果 步 > 0 则
            当 序 < 止 且 序 < 长 则
                追加(出, 对[序])
                将 序 变成 序 + 步
            结束
        否则
            当 序 > 止 且 序 >= 0 则
                追加(出, 对[序])
                将 序 变成 序 + 步
            结束
        结束
        返回 出
    结束
    如果 类 等于 "名字" 则
        将 名 变成 节点["值"]
        # 先按「整名」查一遍：宿主在赋值位置把「甲的平方」当独立变量名，
        # 104 里 将 甲的平方 变成 5 之后 打印 甲的平方 得 5，而 甲 并没有定义。
        # 所以同名的独立变量必须压过下面「X的平方 = X*X」的后缀推断。
        如果 有键(求值全局["求值环境"], 名) 则
            返回 求值全局["求值环境"][名]
        结束
        如果 有键(求值环境, 名) 则
            返回 求值环境[名]
        结束
        如果 有键(求值全局, 名) 则
            返回 求值全局[名]
        结束
        # 宿主只把「依赖过的库」的常量放进来：没写 依赖 物理库 时 光速 报
        # 「没有定义名字「光速」；先赋值，或检查拼写」。求值器把物理常量全塞进了
        # 求值全局，于是不写依赖也能打印 光速 —— 这是把「未定义」误读成「有值」。
        # 用户自己赋值过的名字在上面三级查找里已经返回，走不到这里。
        如果 是物理常量(名) 则
            如果 非 有键(求值依赖, "物理库") 则
                返回 造错("没有定义名字「" + 名 + "」；先赋值，或检查拼写")
            结束
            如果 名 等于 "光速" 则
                返回 光速
            结束
            如果 名 等于 "重力加速度" 则
                返回 重力加速度
            结束
            如果 名 等于 "声速" 则
                返回 声速
            结束
            如果 名 等于 "万有引力常数" 则
                返回 万有引力常数
            结束
            如果 名 等于 "普朗克常数" 则
                返回 普朗克常数
            结束
            如果 名 等于 "电子电荷" 则
                返回 电子电荷
            结束
            如果 名 等于 "阿伏伽德罗常数" 则
                返回 阿伏伽德罗常数
            结束
            如果 名 等于 "理想气体常数" 则
                返回 理想气体常数
            结束
            如果 名 等于 "静电力常量" 则
                返回 静电力常量
            结束
        结束
        # 注意：这个文件里裸调的 字符切片 是 自举运行时 的同名函数，它返回**缓冲**，
        # 直接和文本比 "的平方" 永远不等（01基本 的 打印 甲的平方 就是这么落到
        # 「未定义变量」的）。比较前统一 缓冲转文本。
        如果 字符长(名) > 3 且 缓冲转文本(字符切片(名, 字符长(名) - 3, 字符长(名))) 等于 "的平方" 则
            将 基 变成 缓冲转文本(字符切片(名, 0, 字符长(名) - 3))
            # 基 可能不在当前环境（01基本 里 甲 是脚本顶层变量），必须按
            # 与普通名字相同的三级顺序查，否则 X的平方 一律「未定义变量」。
            将 基值 变成 读变量(基)
            如果 非 是错误(基值) 则
                返回 基值 * 基值
            结束
        结束
        如果 长度(名) > 1 且 名[0] 等于 "√" 则
            返回 平方根(小数(名[1:长度(名)]))
        结束
        如果 字符长(名) > 1 且 缓冲转文本(字符切片(名, 字符长(名) - 1, 字符长(名))) 等于 "²" 则
            将 基 变成 缓冲转文本(字符切片(名, 0, 字符长(名) - 1))
            将 基值 变成 读变量(基)
            如果 非 是错误(基值) 则
                返回 基值 * 基值
            结束
        结束
        如果 名 等于 "真" 则
            返回 1
        结束
        如果 名 等于 "假" 则
            返回 0
        结束
        如果 名 等于 "空" 则
            返回 空
        结束
        如果 名 等于 "圆周率" 则
            返回 圆周率()
        结束
        # 当前环境字典本身存在 求值全局["求值环境"] 里（变量赋值要能改到它，
        # 见 写变量），所以先查这一层。
        如果 有键(求值全局["求值环境"], 节点["值"]) 则
            返回 求值全局["求值环境"][节点["值"]]
        结束
        如果 有键(求值环境, 节点["值"]) 则
            返回 求值环境[节点["值"]]
        结束
        # 函数体有自己的局部环境（参数 + 内部赋值），库顶层变量不在里面。
        # 解析库 的单字符号/双字符号 这类查表就是库全局，缺了它 词法 一进门就报
        # 「未定义变量：单字符号」。所以局部查不到时回退到 求值全局。
        如果 有键(求值全局, 节点["值"]) 则
            返回 求值全局[节点["值"]]
        结束
        如果 有键(求值函数, 节点["值"]) 则
            返回 求值函数[节点["值"]]
        结束
        返回 造错("没有定义名字「" + 节点["值"] + "」；先赋值，或检查拼写")
    结束
    如果 类 等于 "一元" 则
        将 值 变成 求表达式(节点["值"])
        如果 节点["符"] 等于 "-" 或 节点["符"] 等于 "减" 则
            返回 0 - 值
        结束
        如果 真值(值) 等于 0 则
            返回 "真"
        结束
        返回 "假"
    结束
    如果 类 等于 "运算" 则
        将 左 变成 求表达式(节点["左"])
        将 右 变成 求表达式(节点["右"])
        # 宿主把「函数名 空格 负号 数字」当成并置调用，静态报错：
        #   负数参数必须加括号：写「平方根(-5)」，不要写「平方根 -5」
        # 求值器原来当普通减法，只能报成「「-」需要数字，收到字典」。
        # 判断放在语法树上：左侧是名字、这个名字在库归属表里、右侧是数字。
        # 名字节点的字段是「值」（不是「名」）：{"类型":"名字","值":"平方根"}。
        如果 节点["符"] 等于 "-" 且 类型(右) 等于 "数字" 且 类型(节点["左"]) 等于 "字典" 且 有键(节点["左"], "类型") 且 节点["左"]["类型"] 等于 "名字" 且 有键(节点["左"], "值") 且 有键(求值归属, 文本(节点["左"]["值"])) 则
            将 坏名 变成 文本(节点["左"]["值"])
            # 宿主这句是固定模板：不管实际写的是 -4 还是 -7，示例一律写 -5。
            返回 造错("负数参数必须加括号：写「" + 坏名 + "(-5)」，不要写「" + 坏名 + " -5」")
        结束
        # 宿主对「体」也重载了四则：体 * 0.5 + 体 * 0.5 直接算出新体，
        # 体 / 2 是逐格缩放（体混合、体归一化 就压在这两句上）。
        # 而 乘法/减法/除法 这几个库内辅助只吃数字，体一进去就报
        # 「不能转成整数：值类型不匹配」，所以体参与的算式整体交回宿主算子。
        如果 类型(左) 等于 "体" 或 类型(右) 等于 "体" 则
            如果 节点["符"] 等于 "+" 或 节点["符"] 等于 "加" 则
                返回 左 + 右
            结束
            如果 节点["符"] 等于 "-" 或 节点["符"] 等于 "减" 则
                返回 左 - 右
            结束
            如果 节点["符"] 等于 "*" 或 节点["符"] 等于 "×" 或 节点["符"] 等于 "乘" 则
                返回 左 * 右
            结束
            如果 节点["符"] 等于 "/" 或 节点["符"] 等于 "除以" 则
                返回 左 / 右
            结束
        结束
        如果 节点["符"] 等于 "+" 或 节点["符"] 等于 "加" 则
            返回 左 + 右
        结束
        将 数错 变成 需数字(左, 右, 节点["符"])
        如果 是错误(数错) 则
            返回 数错
        结束
        如果 节点["符"] 等于 "-" 则
            返回 减法(左, 右)
        结束
        如果 节点["符"] 等于 "*" 或 节点["符"] 等于 "×" 或 节点["符"] 等于 "乘" 则
            返回 乘法(左, 右)
        结束
        如果 节点["符"] 等于 "**" 则
            返回 幂(左, 右)
        结束
        如果 节点["符"] 等于 "//" 则
            返回 整除(左, 右)
        结束
        如果 节点["符"] 等于 "/" 或 节点["符"] 等于 "除以" 则
            如果 右 等于 0 则
                返回 错误值("除数不能为 0")
            结束
            返回 除法(左, 右)
        结束
        返回 取余(左, 右)
    结束
    如果 类 等于 "比较" 则
        将 左 变成 求表达式(节点["左"])
        将 右 变成 求表达式(节点["右"])
        将 符 变成 节点["符"]
        # 宿主把「体」和任意比较算子都重载成逐格比较，结果仍是体（不是布尔）：
        # 甲 == 乙、甲 != 乙、甲 < 3、甲 > 3 全部打印成 <三维体 #n>。
        # 求值器原来一律折 真/假，106体打印 里 打印 体 等 体 就对不上。
        如果 类型(左) 等于 "体" 或 类型(右) 等于 "体" 则
            如果 符 等于 "==" 则
                返回 左 == 右
            结束
            如果 符 等于 "不等于" 则
                返回 左 != 右
            结束
            如果 符 等于 "<" 则
                返回 左 < 右
            结束
            如果 符 等于 "<=" 则
                返回 左 <= 右
            结束
            如果 符 等于 ">" 则
                返回 左 > 右
            结束
            返回 左 >= 右
        结束
        将 成 变成 0
        如果 符 等于 "==" 则
        结束
        如果 符 等于 "==" 则
            将 成 变成 相等值(左, 右)
        否则如果 符 等于 "不等于" 则
            将 成 变成 左 不等于 右
        否则如果 符 等于 "<" 则
            将 成 变成 左 < 右
        否则如果 符 等于 "<=" 则
            将 成 变成 左 <= 右
        否则如果 符 等于 ">" 则
            将 成 变成 左 > 右
        否则
            将 成 变成 左 >= 右
        结束
        # 宿主对「体」重载了比较算子：体 > 200 不是布尔，而是逐格比较出来的新体
        # （100体对拍 第 209 行 将 掩 变成 原 > 200 就是靠这个）。求值器原来一律
        # 折算成 真/假 文本，掩 变成 "假"，下一句 体读(掩, …) 就报「需要数字，收到文本」。
        如果 类型(成) 等于 "体" 则
            返回 成
        结束
        如果 成 则
            返回 "真"
        结束
        返回 "假"
    结束
    如果 类 等于 "包含" 则
        将 左 变成 求表达式(节点["左"])
        将 右 变成 求表达式(节点["右"])
        如果 类型(右) 等于 "列表" 则
            对于 项 在 右 中 则
                如果 项 等于 左 则
                    返回 "真"
                结束
            结束
        结束
        # 集合的成员判断走 集合存在（107体容器 第 16 行 甲 在 集 中）：
        # 原来只认列表，集合一律落到下面的 返回 "假"。
        如果 类型(右) 等于 "集合" 则
            返回 集合存在(右, 左)
        结束
        返回 "假"
    结束
    如果 类 等于 "逻辑" 则
        # 且 / 或 必须短路：宿主就是短路的，求值器原来一口气把两边都求了。
        # 后果很具体 —— 自举库:1441 写 `如果 句["类型"] 等于 "赋值" 且 找序号(全局表, 句["名"]) < 0 则`，
        # 编译「返回 1」时 句 是 返回 节点、根本没有 名，右边被强行求值就
        # 「字典里没有键「名」」；宿主编同一句只出 42 字节，求值侧整条编译链全废。
        将 左 变成 求表达式(节点["左"])
        如果 节点["符"] 等于 "且" 则
            如果 真值(左) 等于 0 则
                返回 "假"
            结束
            将 右 变成 求表达式(节点["右"])
            如果 真值(右) 不等于 0 则
                返回 "真"
            结束
            返回 "假"
        结束
        如果 真值(左) 不等于 0 则
            返回 "真"
        结束
        将 右 变成 求表达式(节点["右"])
        如果 真值(右) 不等于 0 则
            返回 "真"
        结束
        返回 "假"
    结束
    如果 类 等于 "调用" 则
        尝试
        # 漏写 依赖 就用库函数：宿主报「属于 X 库，请先写 依赖 X」，这里对齐。
        # 用户自己定义过同名函数时跳过（宿主也是用户定义优先）。
        如果 非 有键(求值函数, 节点["名"]) 则
            如果 有键(求值归属, 节点["名"]) 则
                将 属库 变成 求值归属[节点["名"]]
                如果 非 有键(求值依赖, 属库) 则
                    返回 造错("「" + 节点["名"] + "」属于「" + 属库 + "」，请先在使用前写「依赖 " + 属库 + "」")
                结束
            结束
        结束
        # 宿主里脚本自己定义的函数优先于同名内置（102体形态对拍 第 7 行
        # 函数 值 层坐标 行坐标 列坐标 就盖掉了内置的字典取值 值；
        # 宿主 值(1,2,3) 算 99，求值器原来先去内置分派，报
        # 「需要字典，收到数字」的同族错误「数字不能用 [ ] 取下标」）。
        如果 有键(求值函数, 节点["名"]) 则
            返回 调用函数(求值函数[节点["名"]], 节点)
        结束
        # 内置参数个数校验要排在分派前面：少传参数时，分派里先取 参数[0] 会报成下标越界。
        如果 非 有键(求值函数, 节点["名"]) 则
            如果 有键(求值内置参数数, 节点["名"]) 则
                如果 数不等(长度(节点["参数"]), 求值内置参数数[节点["名"]]) 则
                    返回 造错("函数「" + 节点["名"] + "」需要 " + 文本(求值内置参数数[节点["名"]]) + ".." + 文本(求值内置参数数[节点["名"]]) + " 个参数，收到 " + 文本(长度(节点["参数"])) + " 个")
                结束
            结束
        结束
        如果 节点["名"] 等于 "抛出" 则
            # 宿主对 抛出(5) 照样抛运行时错误、原因就是「5」；求值器 造错 只吃文本，
            # 直接传数字会报成「「+」不支持文本和数字」。
            将 抛值 变成 求表达式(节点["参数"][0])
            如果 类型(抛值) 不等于 "文本" 则
                将 抛值 变成 文本(抛值)
            结束
            返回 造错(抛值)
        结束
        如果 节点["名"] 等于 "是错误" 则
            返回 是错误(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "新建集合" 则
            返回 新建集合()
        结束
        如果 节点["名"] 等于 "集合添加" 则
            将 集 变成 求表达式(节点["参数"][0])
            集合添加(集, 求表达式(节点["参数"][1]))
            返回 集
        结束
        如果 节点["名"] 等于 "集合存在" 则
            返回 集合存在(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "并集" 则
            返回 并集(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "交集" 则
            返回 交集(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "差集" 则
            返回 差集(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "阶乘" 则
            返回 阶乘(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "最大公约数" 则
            返回 最大公约数(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "最小公倍数" 则
            返回 最小公倍数(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "是否素数" 则
            返回 是否素数(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "质因数分解" 则
            返回 质因数分解(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "平均数" 则
            返回 平均数(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "中位数" 则
            返回 中位数(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "方差" 则
            返回 方差(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "标准差" 则
            返回 标准差(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "样本方差" 则
            返回 样本方差(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "样本标准差" 则
            返回 样本标准差(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "组合数" 则
            返回 组合数(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "排列数" 则
            返回 排列数(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "抛出" 则
            返回 造错(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "是错误" 则
            返回 是错误(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "格式化" 则
            如果 长度(节点["参数"]) 等于 1 则
                返回 格式化(求表达式(节点["参数"][0]), 2)
            结束
            返回 格式化(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "查找" 则
            返回 查找(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "替换" 则
            返回 替换(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]), 求表达式(节点["参数"][2]))
        结束
        如果 节点["名"] 等于 "分割" 则
            返回 分割(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "修剪" 则
            返回 修剪(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "根号" 则
            返回 平方根(求表达式(节点["参数"][0]))
        结束
        # 解析库 的 词法 第一句就是 缓冲长度(文本转缓冲(源))，求值器不分派它，
        # 语法程序 一进门就报「未定义函数：缓冲长度」。
        如果 节点["名"] 等于 "缓冲长度" 则
            返回 缓冲长度(求表达式(节点["参数"][0]))
        结束
        # 字符串长 同理（自举运行时 自己也用它量缓冲）。
        如果 节点["名"] 等于 "字符串长" 则
            返回 字符串长(求表达式(节点["参数"][0]))
        结束
        # 解析库 的词法整条链都压在缓冲原语上（分裂字 里连续调 缓冲长度/缓冲读/
        # 新建缓冲/缓冲写/缓冲转文本，最后 追加 进记号表）。缺任何一个，
        # 语法程序 都走不到第一句之后的第二句。名字与宿主同口径转发。
        如果 节点["名"] 等于 "文本转缓冲" 则
            返回 文本转缓冲(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "缓冲转文本" 则
            返回 缓冲转文本(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "缓冲读" 则
            返回 缓冲读(求表达式(节点["参数"][0]), 整数(求表达式(节点["参数"][1])))
        结束
        如果 节点["名"] 等于 "缓冲写" 则
            返回 缓冲写(求表达式(节点["参数"][0]), 整数(求表达式(节点["参数"][1])), 求表达式(节点["参数"][2]))
        结束
        # PE 打包链（PE最小库 的 打包代码PE → 写PE头）整条压在 缓冲写整数/缓冲读整数 上。
        # 原来只分了 缓冲写，走到写头部那句就「未定义函数：缓冲写整数」，
        # 151 的第四象限 直线编译机器码 因此只回一个错误字典。
        如果 节点["名"] 等于 "缓冲写整数" 则
            # 宿主签名 缓冲写整数(缓冲, 偏移, 值, 宽度[, 端序]) —— PE 打包链两个都用。
            将 参 变成 节点["参数"]
            如果 长度(参) > 4 则
                返回 缓冲写整数(求表达式(参[0]), 整数(求表达式(参[1])), 求表达式(参[2]), 整数(求表达式(参[3])), 文本(求表达式(参[4])))
            结束
            返回 缓冲写整数(求表达式(参[0]), 整数(求表达式(参[1])), 求表达式(参[2]), 整数(求表达式(参[3])))
        结束
        如果 节点["名"] 等于 "缓冲读整数" 则
            将 参 变成 节点["参数"]
            如果 长度(参) > 3 则
                返回 缓冲读整数(求表达式(参[0]), 整数(求表达式(参[1])), 整数(求表达式(参[2])), 文本(求表达式(参[3])))
            结束
            返回 缓冲读整数(求表达式(参[0]), 整数(求表达式(参[1])), 整数(求表达式(参[2])))
        结束
        如果 节点["名"] 等于 "写二进制" 则
            # 打包代码PE 最后一步：把整块缓冲落盘。
            返回 写二进制(文本(求表达式(节点["参数"][0])), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "新建缓冲" 则
            如果 长度(节点["参数"]) > 1 则
                返回 新建缓冲(整数(求表达式(节点["参数"][0])), 求表达式(节点["参数"][1]))
            结束
            返回 新建缓冲(整数(求表达式(节点["参数"][0])))
        结束
        如果 节点["名"] 等于 "追加" 则
            返回 追加(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        # 下面这一批是宿主最常见的内置，求值器原来一个分派都没有：
        # 调用它们会落进 取函值 的兜底，返回「未定义函数」错误字典，
        # 而错误字典又会被当普通值继续参与运算 —— 错得无声无息。
        # 名字和后端按宿主同一口径转发；其中 字符长/字符取/字符切片/取余/整除/
        # 字符串新建/字符串连接/列表新建 在 自举运行时 里有自举实现，名字解析到这里即用自举版。
        如果 节点["名"] 等于 "类型" 则
            # 自举运行时 的 是错误/显式值 全走 类型(值) 判类，宿主有这个名字但求值器
            # 原来没转发，于是任何依赖 自举运行时 的库一进来就「未定义函数：类型」。
            将 型值 变成 求表达式(节点["参数"][0])
            # 函数在本求值器里就是「名/参数/主体」三个键的字典，直接交给宿主 类型
            # 会报「字典」；宿主口径是 函数（100零参显式 第 4 行 类型(空参函数)）。
            如果 类型(型值) 等于 "字典" 且 有键(型值, "主体") 且 有键(型值, "名") 且 有键(型值, "参数") 则
                返回 "函数"
            结束
            返回 类型(型值)
        结束
        如果 节点["名"] 等于 "取余" 则
            返回 取余(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "整除" 则
            返回 整除(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "列表新建" 则
            返回 列表新建(整数(求表达式(节点["参数"][0])))
        结束
        如果 节点["名"] 等于 "字符串新建" 则
            返回 字符串新建(整数(求表达式(节点["参数"][0])))
        结束
        如果 节点["名"] 等于 "字符取" 则
            返回 字符取(求表达式(节点["参数"][0]), 整数(求表达式(节点["参数"][1])))
        结束
        如果 节点["名"] 等于 "字符长" 则
            返回 字符长(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "字符切片" 则
            将 果 变成 字符切片(求表达式(节点["参数"][0]), 整数(求表达式(节点["参数"][1])), 整数(求表达式(节点["参数"][2])))
            # 自举运行时 的 字符切片 用 字符串新建/字符串连接 拼，返回的是**缓冲**；
            # 宿主同名函数返回文本。不归一，后面任何 `文本 + 字符切片(…)` 都会
            # 报「「+」不支持文本和缓冲」——错点跑到下游，源头看不出来。
            如果 类型(果) 等于 "缓冲" 则
                返回 缓冲转文本(果)
            结束
            返回 果
        结束
        如果 节点["名"] 等于 "字符串连接" 则
            # 自举运行时 里的 字符串连接 返回的是「缓冲」（它内部用 字符串新建 拼），
            # 宿主同名函数返回文本。不转一下，打印出来是 <缓冲 6 字节>。
            返回 缓冲转文本(字符串连接(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1])))
        结束
        如果 节点["名"] 等于 "读文件" 则
            返回 读文件(文本(求表达式(节点["参数"][0])))
        结束
        如果 节点["名"] 等于 "写文件" 则
            返回 写文件(文本(求表达式(节点["参数"][0])), 文本(求表达式(节点["参数"][1])))
        结束
        # 写入 是 文件库 的原生名字（读文件/写文件 之外的另一套），141写入错误 用它。
        如果 节点["名"] 等于 "写入" 则
            # 宿主 写入(路径, 内容, 追加?)：第三参为真时追加而不是覆盖（140文件追加）。
            如果 长度(节点["参数"]) >= 3 则
                返回 写入(文本(求表达式(节点["参数"][0])), 文本(求表达式(节点["参数"][1])), 求表达式(节点["参数"][2]))
            结束
            返回 写入(文本(求表达式(节点["参数"][0])), 文本(求表达式(节点["参数"][1])))
        结束
        如果 节点["名"] 等于 "文件存在" 则
            返回 文件存在(文本(求表达式(节点["参数"][0])))
        结束
        如果 节点["名"] 等于 "新建缓冲" 则
            返回 新建缓冲(整数(求表达式(节点["参数"][0])))
        结束
        如果 节点["名"] 等于 "睡眠" 则
            # 宿主的名字是「休眠」，属 时间库；「睡眠」这个名字根本不存在。
            返回 休眠(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "字符串查找" 则
            # 宿主的名字是「查找」（返回位置）。
            返回 查找(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "字符串替换" 则
            # 宿主的名字是「替换」。
            返回 替换(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]), 求表达式(节点["参数"][2]))
        结束
        如果 节点["名"] 等于 "幂" 则
            # 属 数学库，头部已经 依赖 数学库。
            返回 幂(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "调用外部" 则
            # 宿主：调用外部(库文件路径, 函数名, 参数…) —— 从库文件里取函数并调用。
            # 求值器原来没有这条，43后缀 第二行直接返回「未定义函数：调用外部」。
            # 这里用同一套机制实现：读文件 → 语法程序 → 注册函数 → 按名调用。
            将 参 变成 节点["参数"]
            如果 长度(参) < 2 则
                抛出("调用外部 至少需要「路径」和「函数名」两个参数")
            结束
            将 路 变成 文本(求表达式(参[0]))
            将 函名 变成 文本(求表达式(参[1]))
            将 实参 变成 []
            将 序 变成 2
            当 序 < 长度(参) 则
                追加(实参, 求表达式(参[序]))
                将 序 变成 序 + 1
            结束
            如果 非 文件在(路) 则
                抛出("调用外部 找不到库文件：" + 路)
            结束
            将 库树 变成 语法程序(读文件(路))
            # 外部库顶层的 将 甲 变成 999 这类变量必须先落地，否则函数体里的 甲
            # 解析成错误对象，一加就报「「+」不支持数字和字典」（18外部调用）。
            # 但外部库的全局不能写进主程序环境（主程序的 甲 仍是 1），
            # 所以单独开一层，执行完把这一层挂成函数的闭包。
            将 旧环 变成 求值环境
            将 库环 变成 {}
            设环境(库环)
            将 前置 变成 []
            将 函处 变成 0
            对于 库句 在 库树["语句"] 中 则
                如果 库句["类型"] 等于 "函数" 则
                    将 求值函数[库句["名"]] 变成 库句
                    将 库句["闭包"] 变成 库环
                    如果 库句["名"] 等于 函名 且 长度(库句["主体"]) > 0 且 有键(库句["主体"][0], "行") 则
                        将 函处 变成 库句["主体"][0]["行"]
                    结束
                否则如果 库句["类型"] 不等于 "依赖" 则
                    追加(前置, 库句)
                结束
            结束
            如果 长度(前置) > 0 则
                求块(前置)
            结束
            设环境(旧环)
            # 宿主把外部库里的错误包成「外部库「路径」第 N 行的「函数」失败：原因」，
            # 求值器原来只把裸原因冒出去。按同一格式补上前缀，N 取函数首个语句的行号。
            将 外返 变成 调用值(取函值(函名), 实参)
            如果 是错误(外返) 则
                如果 类型(外返) 等于 "字典" 且 有键(外返, "原因") 则
                    抛出("外部库「" + 路 + "」第 " + 文本(函处) + " 行的「" + 函名 + "」失败：" + 外返["原因"])
                结束
            结束
            返回 外返
        结束
        如果 节点["名"] 等于 "删除文件" 则
            # 文件库 的语句式内置，46反编译 最后一句就是 删除文件 "例子/_bc.json"。
            # 它是函数形态也可以（宿主实测 删除文件("路径") 返回 真），直接在求值器里转发。
            返回 删除文件(文本(求表达式(节点["参数"][0])))
        结束
        如果 节点["名"] 等于 "翻译" 则
            # 兼容库 的内建三件套。46反编译 全靠它们，求值器原来一条都没有：
            # 取函值 找不到 → 返回错误字典 → 整段静默零输出。
            返回 翻译(文本(求表达式(节点["参数"][0])), 文本(求表达式(节点["参数"][1])))
        结束
        如果 节点["名"] 等于 "反汇编" 则
            返回 反汇编(文本(求表达式(节点["参数"][0])))
        结束
        如果 节点["名"] 等于 "反汇编文本" 则
            返回 反汇编文本(文本(求表达式(节点["参数"][0])))
        结束
        如果 节点["名"] 等于 "换行符" 则
            # 换行符/制表符/回车符 是宿主内置，求值器原来没有分派。
            # 取函值 找不到会返回错误字典，错误字典再被当操作数参与 "+"，
            # 于是报成「「+」不支持文本和字典」——错误源和报错点完全错位。
            返回 换行符()
        结束
        如果 节点["名"] 等于 "制表符" 则
            返回 制表符()
        结束
        如果 节点["名"] 等于 "回车符" 则
            返回 回车符()
        结束
        如果 节点["名"] 等于 "解析JSON" 则
            # 数据格式库 是宿主内建库（库\ 下没有 数据格式库.wen），
            # 加载库 找不到文件就静默跳过，于是 解析JSON 未定义 —— 10数据格式 一行都不吐。
            # 这四个函数没有自举侧等价物，直接转发给宿主同名函数。
            返回 解析JSON(文本(求表达式(节点["参数"][0])))
        结束
        如果 节点["名"] 等于 "生成JSON" 则
            返回 生成JSON(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "解析CSV" 则
            返回 解析CSV(文本(求表达式(节点["参数"][0])))
        结束
        如果 节点["名"] 等于 "生成CSV" 则
            返回 生成CSV(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "语言法" 则
            # 宿主内置的「语言法 / 语言限制 / 合规检查」在求值器里没有分派，
            # 95语言法 一跑就报「未定义函数：语言限制」。这三个本来就是查语言自身
            # 的元信息，没有自举侧等价物，直接转发给宿主同名函数。
            返回 语言法()
        结束
        如果 节点["名"] 等于 "语言限制" 则
            返回 语言限制()
        结束
        如果 节点["名"] 等于 "合规检查" 则
            返回 合规检查(文本(求表达式(节点["参数"][0])))
        结束
        如果 节点["名"] 等于 "正弦" 则
            返回 正弦(除法(乘法(浮点化(求表达式(节点["参数"][0])), 圆周率()), 浮点新建(180)))
        结束
        如果 节点["名"] 等于 "余弦" 则
            返回 余弦(除法(乘法(浮点化(求表达式(节点["参数"][0])), 圆周率()), 浮点新建(180)))
        结束
        如果 节点["名"] 等于 "正切" 则
            返回 正切(除法(乘法(浮点化(求表达式(节点["参数"][0])), 圆周率()), 浮点新建(180)))
        结束
        如果 节点["名"] 等于 "类型" 则
            将 型参 变成 节点["参数"][0]
            如果 型参["类型"] 等于 "布尔" 则
                返回 "布尔"
            结束
            如果 型参["类型"] 等于 "空值" 则
                返回 "空"
            结束
            如果 型参["类型"] 等于 "名字" 则
                如果 型参["值"] 等于 "真" 或 型参["值"] 等于 "假" 则
                    返回 "布尔"
                结束
                如果 型参["值"] 等于 "空" 则
                    返回 "空"
                结束
            结束
            将 型值 变成 求表达式(型参)
            如果 类型(型值) 等于 "字典" 则
                如果 有键(型值, "类型") 则
                    如果 型值["类型"] 等于 "函数" 则
                        返回 "函数"
                    结束
                结束
            结束
            返回 类型(型值)
        结束
        如果 节点["名"] 等于 "文本" 则
            将 文参 变成 节点["参数"][0]
            如果 文参["类型"] 等于 "布尔" 则
                返回 文参["值"]
            结束
            如果 文参["类型"] 等于 "空值" 则
                返回 ""
            结束
            如果 文参["类型"] 等于 "名字" 则
                如果 文参["值"] 等于 "真" 则
                    返回 "真"
                结束
                如果 文参["值"] 等于 "假" 则
                    返回 "假"
                结束
                如果 文参["值"] 等于 "空" 则
                    返回 ""
                结束
            结束
            返回 文本(求表达式(文参))
        结束
        如果 节点["名"] 等于 "有键" 则
            将 表值 变成 求表达式(节点["参数"][0])
            将 键值 变成 求表达式(节点["参数"][1])
            如果 有键(表值, 键值) 则
                返回 "真"
            结束
            返回 "假"
        结束
        如果 节点["名"] 等于 "键" 则
            返回 键(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "值" 则
            将 字 变成 求表达式(节点["参数"][0])
            将 出 变成 []
            对于 键名 在 键(字) 中 则
                追加(出, 字[键名])
            结束
            返回 出
        结束
        如果 节点["名"] 等于 "长度" 则
            将 长值 变成 求表达式(节点["参数"][0])
            如果 是文本(长值) 则
                返回 字符长(长值)
            结束
            返回 长度(长值)
        结束
        如果 节点["名"] 等于 "插入" 则
            将 列 变成 求表达式(节点["参数"][0])
            插入(列, 整数(求表达式(节点["参数"][1])), 求表达式(节点["参数"][2]))
            返回 列
        结束
        如果 节点["名"] 等于 "弹出" 则
            返回 弹出(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "追加" 则
            将 列 变成 求表达式(节点["参数"][0])
            追加(列, 求表达式(节点["参数"][1]))
            返回 列
        结束
        如果 节点["名"] 等于 "排序" 则
            返回 排序(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "反转" 则
            返回 反转(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "求和" 则
            返回 求和(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "范围" 则
            # 三参形式 范围(起, 止, 步) 原来只转发两参，第三参被静默丢掉，
            # 130字节码对拍 里 范围(0,10,3) 输出成 0..9 而不是 0 3 6 9。
            如果 长度(节点["参数"]) 等于 3 则
                返回 范围(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]), 求表达式(节点["参数"][2]))
            结束
            返回 范围(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "文本" 则
            返回 文本(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "整数" 则
            # 宿主 整数 有第二参（进制）：整数("FF", 16) = 255。
            # 原来这里只取 节点["参数"][0]，两参写法会被当成单参，
            # 于是 整数("FF", 16) 报「不是有效数字：FF」——参数被静默吞掉一个。
            如果 长度(节点["参数"]) 等于 2 则
                返回 整数(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
            结束
            返回 整数(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "小数" 则
            返回 小数(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "调用" 则
            将 名参 变成 节点["参数"][0]
            将 名值 变成 名参["值"]
            将 列 变成 求表达式(节点["参数"][1])
            将 参们 变成 []
            对于 项 在 列 中 则
                追加(参们, {"类型": "值", "值": 项})
            结束
            返回 求表达式({"类型": "调用", "名": 名值, "参数": 参们})
        结束
        如果 节点["名"] 等于 "平方根" 则
            返回 平方根(求表达式(节点["参数"][0]))
        结束
        # 数学库 的取整族是「一元内建」，求值器没分派。三维计算 的三维缩放 第一句就是
        # 最大(1, 向下取整(体宽(体) * 倍率))，缺 向下取整 时它返回错误字典，接着
        # 最大 里 值 > 最 就变成「字典和数字不能比较」，报错点离根因隔了两层。
        如果 节点["名"] 等于 "向下取整" 则
            返回 向下取整(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "向上取整" 则
            返回 向上取整(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "四舍五入" 则
            返回 四舍五入(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "绝对值" 则
            返回 绝对值(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "图像存PNG" 则
            返回 图像存PNG(文本(求表达式(节点["参数"][0])), 整数(求表达式(节点["参数"][1])), 整数(求表达式(节点["参数"][2])), 求表达式(节点["参数"][3]))
        结束
        如果 节点["名"] 等于 "最大" 则
            如果 长度(节点["参数"]) > 1 则
                将 最 变成 求表达式(节点["参数"][0])
                对于 参 在 节点["参数"] 中 则
                    将 值 变成 求表达式(参)
                    如果 值 > 最 则
                        将 最 变成 值
                    结束
                结束
                返回 最
            结束
            返回 最大(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "最小" 则
            如果 长度(节点["参数"]) > 1 则
                将 最 变成 求表达式(节点["参数"][0])
                对于 参 在 节点["参数"] 中 则
                    将 值 变成 求表达式(参)
                    如果 值 < 最 则
                        将 最 变成 值
                    结束
                结束
                返回 最
            结束
            返回 最小(求表达式(节点["参数"][0]))
        结束
        如果 节点["名"] 等于 "查找字节" 则
            返回 查找字节(求表达式(节点["参数"][0]), 求表达式(节点["参数"][1]))
        结束
        如果 节点["名"] 等于 "映射" 则
            将 列 变成 求表达式(节点["参数"][0])
            将 新函 变成 取函值(节点["参数"][1]["值"])
            将 出列 变成 []
            对于 项 在 列 中 则
                追加(出列, 调用值(新函, [项]))
            结束
            返回 出列
        结束
        如果 节点["名"] 等于 "过滤" 则
            将 列 变成 求表达式(节点["参数"][0])
            将 新函 变成 取函值(节点["参数"][1]["值"])
            将 出列 变成 []
            对于 项 在 列 中 则
                如果 真值(调用值(新函, [项])) 不等于 0 则
                    追加(出列, 项)
                结束
            结束
            返回 出列
        结束
        如果 节点["名"] 等于 "折叠" 则
            将 列 变成 求表达式(节点["参数"][0])
            将 累 变成 求表达式(节点["参数"][1])
            将 新函 变成 取函值(节点["参数"][2]["值"])
            对于 项 在 列 中 则
                将 累 变成 调用值(新函, [累, 项])
            结束
            返回 累
        结束
        如果 节点["名"] 等于 "任意" 则
            将 列 变成 求表达式(节点["参数"][0])
            将 新函 变成 取函值(节点["参数"][1]["值"])
            对于 项 在 列 中 则
                如果 真值(调用值(新函, [项])) 不等于 0 则
                    返回 "真"
                结束
            结束
            返回 "假"
        结束
        如果 节点["名"] 等于 "全部" 则
            将 列 变成 求表达式(节点["参数"][0])
            将 新函 变成 取函值(节点["参数"][1]["值"])
            对于 项 在 列 中 则
                如果 真值(调用值(新函, [项])) 等于 0 则
                    返回 "假"
                结束
            结束
            返回 "真"
        结束
        如果 节点["名"] 等于 "找到" 则
            将 列 变成 求表达式(节点["参数"][0])
            将 新函 变成 取函值(节点["参数"][1]["值"])
            对于 项 在 列 中 则
                如果 真值(调用值(新函, [项])) 不等于 0 则
                    返回 项
                结束
            结束
            返回 0
        结束
        如果 节点["名"] 等于 "计数" 则
            将 列 变成 求表达式(节点["参数"][0])
            将 新函 变成 取函值(节点["参数"][1]["值"])
            将 数 变成 0
            对于 项 在 列 中 则
                如果 真值(调用值(新函, [项])) 不等于 0 则
                    将 数 变成 数 + 1
                结束
            结束
            返回 数
        结束
        如果 节点["名"] 等于 "排序依据" 则
            将 列 变成 求表达式(节点["参数"][0])
            将 新函 变成 取函值(节点["参数"][1]["值"])
            将 出列 变成 []
            对于 项 在 列 中 则
                将 新键 变成 调用值(新函, [项])
                将 位 变成 长度(出列)
                当 位 > 0 则
                    将 前键 变成 调用值(新函, [出列[位 - 1]])
                    如果 前键 > 新键 则
