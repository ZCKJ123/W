# 体库：把语言内建的「体」包一层常用操作，别的代码直接 依赖 体库 就能用
# 不用再关心句柄、序列化、包围盒这些细节

依赖 文件库
依赖 数学库
依赖 哈希库

函数 体深 体 则
    返回 体尺寸(体)["层"]
结束

函数 体高 体 则
    返回 体尺寸(体)["行"]
结束

函数 体宽 体 则
    返回 体尺寸(体)["列"]
结束

# 取一层截面，返回 RGB 缓冲（行×列×3）
函数 层切片 体 层 则
    局部 宽 变成 体宽(体)
    局部 高 变成 体高(体)
    局部 出 变成 新建缓冲(宽 * 高 * 3, 0)
    局部 行坐标 变成 0
    当 行坐标 < 高 则
        局部 列坐标 变成 0
        当 列坐标 < 宽 则
            局部 样 变成 体采样(体, 层, 行坐标, 列坐标)
            缓冲写(出, (行坐标 * 宽 + 列坐标) * 3, 向下取整(样["红"]))
            缓冲写(出, (行坐标 * 宽 + 列坐标) * 3 + 1, 向下取整(样["绿"]))
            缓冲写(出, (行坐标 * 宽 + 列坐标) * 3 + 2, 向下取整(样["蓝"]))
            将 列坐标 变成 列坐标 + 1
        结束
        将 行坐标 变成 行坐标 + 1
    结束
    返回 出
结束

# 取一层灰度（亮度），返回 行×列 缓冲
函数 层灰度 体 层 则
    局部 宽 变成 体宽(体)
    局部 高 变成 体高(体)
    局部 出 变成 新建缓冲(宽 * 高, 0)
    局部 行坐标 变成 0
    当 行坐标 < 高 则
        局部 列坐标 变成 0
        当 列坐标 < 宽 则
            局部 样 变成 体采样(体, 层, 行坐标, 列坐标)
            局部 亮 变成 向下取整((样["红"] * 30 + 样["绿"] * 59 + 样["蓝"] * 11) / 100)
            缓冲写(出, 行坐标 * 宽 + 列坐标, 亮)
            将 列坐标 变成 列坐标 + 1
        结束
        将 行坐标 变成 行坐标 + 1
    结束
    返回 出
结束

# 内容包围盒：返回 {层起, 层止, 行起, 行止, 列起, 列止, 空}
函数 体包围盒 体 则
    局部 深 变成 体深(体)
    局部 高 变成 体高(体)
    局部 宽 变成 体宽(体)
    局部 层起 变成 深
    局部 层止 变成 -1
    局部 行起 变成 高
    局部 行止 变成 -1
    局部 列起 变成 宽
    局部 列止 变成 -1
    局部 层坐标 变成 0
    当 层坐标 < 深 则
        局部 行坐标 变成 0
        当 行坐标 < 高 则
            局部 列坐标 变成 0
            当 列坐标 < 宽 则
                局部 样 变成 体采样(体, 层坐标, 行坐标, 列坐标)
                如果 样["红"] + 样["绿"] + 样["蓝"] 大于 0 则
                    如果 层坐标 < 层起 则
                        将 层起 变成 层坐标
                    结束
                    如果 层坐标 > 层止 则
                        将 层止 变成 层坐标
                    结束
                    如果 行坐标 < 行起 则
                        将 行起 变成 行坐标
                    结束
                    如果 行坐标 > 行止 则
                        将 行止 变成 行坐标
                    结束
                    如果 列坐标 < 列起 则
                        将 列起 变成 列坐标
                    结束
                    如果 列坐标 > 列止 则
                        将 列止 变成 列坐标
                    结束
                结束
                将 列坐标 变成 列坐标 + 1
            结束
            将 行坐标 变成 行坐标 + 1
        结束
        将 层坐标 变成 层坐标 + 1
    结束
    返回 {"层起": 层起, "层止": 层止, "行起": 行起, "行止": 行止, "列起": 列起, "列止": 列止, "空": 层止 小于 0}
结束

# 是不是彩色体（体尺寸 里的「彩色」是真/假）
函数 体是彩色 体 则
    返回 体尺寸(体)["彩色"]
结束

# 写一个格子：彩色体写三通道，灰度体按亮度折成一个 0..255
函数 体写格 体 层坐标 行坐标 列坐标 红 绿 蓝 则
    如果 体是彩色(体) 则
        体彩写(体, 层坐标, 行坐标, 列坐标, 红, 绿, 蓝)
    否则
        体写(体, 层坐标, 行坐标, 列坐标, 向下取整((红 * 30 + 绿 * 59 + 蓝 * 11) / 100))
    结束
结束

# 体印章：把 小体 盖到 大体 的 (层, 行, 列) 处（只盖非空体素）
函数 体盖章 大体 小体 层0 行0 列0 则
    局部 小深 变成 体深(小体)
    局部 小高 变成 体高(小体)
    局部 小宽 变成 体宽(小体)
    局部 层坐标 变成 0
    当 层坐标 < 小深 则
        局部 行坐标 变成 0
        当 行坐标 < 小高 则
            局部 列坐标 变成 0
            当 列坐标 < 小宽 则
                局部 样 变成 体采样(小体, 层坐标, 行坐标, 列坐标)
                如果 样["红"] + 样["绿"] + 样["蓝"] 大于 0 则
                    体写格(大体, 层0 + 层坐标, 行0 + 行坐标, 列0 + 列坐标, 向下取整(样["红"]), 向下取整(样["绿"]), 向下取整(样["蓝"]))
                结束
                将 列坐标 变成 列坐标 + 1
            结束
            将 行坐标 变成 行坐标 + 1
        结束
        将 层坐标 变成 层坐标 + 1
    结束
    返回 大体
结束

# 体到缓冲、缓冲到体（转调内建，便于别的库统一入口）
函数 体存缓冲 体 则
    返回 体转缓冲(体)
结束

函数 缓冲成体 缓 则
    返回 缓冲转体(缓)
结束

# 指纹：把体序列化后做 SHA-256，用来比对两份体是否一致
函数 体指纹 体 则
    返回 缓冲SHA256(体转缓冲(体))
结束

# 填充：把所有体素设成同一个灰度值（三维 / 彩色都行）
函数 体填充 体 灰度 则
    局部 深 变成 体深(体)
    局部 高 变成 体高(体)
    局部 宽 变成 体宽(体)
    局部 层坐标 变成 0
    当 层坐标 < 深 则
        局部 行坐标 变成 0
        当 行坐标 < 高 则
            局部 列坐标 变成 0
            当 列坐标 < 宽 则
                体写格(体, 层坐标, 行坐标, 列坐标, 灰度, 灰度, 灰度)
                将 列坐标 变成 列坐标 + 1
            结束
            将 行坐标 变成 行坐标 + 1
        结束
        将 层坐标 变成 层坐标 + 1
    结束
    返回 体
结束

# 平滑：调用内建的可分离盒式模糊
函数 体平滑半径 体 半径 则
    返回 体模糊(体, 半径)
结束

# 逐层计数：每层非零体素数，返回列表
函数 体分层计数 体 则
    局部 深 变成 体深(体)
    局部 出 变成 []
    局部 层坐标 变成 0
    当 层坐标 < 深 则
        局部 数 变成 0
        局部 行坐标 变成 0
        当 行坐标 < 体高(体) 则
            局部 列坐标 变成 0
            当 列坐标 < 体宽(体) 则
                局部 样 变成 体采样(体, 层坐标, 行坐标, 列坐标)
                如果 样["红"] + 样["绿"] + 样["蓝"] 大于 0 则
                    将 数 变成 数 + 1
                结束
                将 列坐标 变成 列坐标 + 1
            结束
            将 行坐标 变成 行坐标 + 1
        结束
        追加(出, 数)
        将 层坐标 变成 层坐标 + 1
    结束
    返回 出
结束

# 切片缓冲：一层转成灰度缓冲（行×列）
函数 体切片缓冲 体 层 则
    返回 层灰度(体, 层)
结束

# 图入体：把一张 PNG（图像读PNG 的结果）缩放着写进某一层
# 图大就按双线性前的最近邻取点；灰度的体自动折算亮度
函数 图层入体 体 图 层 则
    局部 高 变成 体高(体)
    局部 宽 变成 体宽(体)
    局部 图宽 变成 图["宽"]
    局部 图高 变成 图["高"]
    局部 源 变成 图["像素"]
    局部 行坐标 变成 0
    当 行坐标 < 高 则
        局部 列坐标 变成 0
        当 列坐标 < 宽 则
            局部 纵比 变成 向下取整(行坐标 * 图高 / 高)
            局部 横比 变成 向下取整(列坐标 * 图宽 / 宽)
            局部 旧值 变成 (纵比 * 图宽 + 横比) * 3
            体写格(体, 层, 行坐标, 列坐标, 缓冲读(源, 旧值), 缓冲读(源, 旧值 + 1), 缓冲读(源, 旧值 + 2))
            将 列坐标 变成 列坐标 + 1
        结束
        将 行坐标 变成 行坐标 + 1
    结束
    返回 体
结束

# 体出图：把某一层存成 PNG（行×列，彩色体按颜色，灰度体是灰度三通道）
函数 体出图 体 层 路径 则
    图像存PNG彩色(路径, 体宽(体), 体高(体), 层切片(体, 层))
    返回 路径
结束
