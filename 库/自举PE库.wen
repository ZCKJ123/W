# 库/自举PE库.wen
# 【状态：可用（2026-11-13）】能产出 Windows 可加载的独立 PE，产物自带运行时。
#
# 已修好的四处（此前都表现为「不是有效的 Win32 应用程序」或运行即 0xC0000005）：
#   1. 节的 VirtualAddress 必须首尾相接填满镜像，VA 之间留空洞 → 加载器判 WinError 193；
#   2. 全局变量区必须是可写节（原先把 0x7E000 落在只读 .text 里，一带变量就崩）；
#   3. 分配桩的 call 目标基数写错 2 字节（FF 15 后下一条指令在 +15，不是 +17），
#      导致 call 直接跳到 0，字符串/列表一分配就崩；
#   4. 代码段容量与桩/导入/全局区地址整体上移，留给「整包 781KB 机器码」足够空间。
#
# 布局（节全部连续，无空洞）：
#   .text  0x1000..0xC1000   代码（容量 0xC0000）
#   .data  0xC1000..0xC2000  全局变量区（可写，512 项 × 8 字节）
#   .stub  0xC2000..0xC3000  原语桩（槽 0xC2050…0xC20A0，桩 0xC2100…0xC2180）
#   .idata 0xC3000..0xC3200  导入表（IAT 0xC3060/0xC3068/0xC3070）
#
# 布局按自举库的假定来：
#   代码起点 = 镜像偏移 0x1014（VA 0x140001014）
#   导入槽   = 镜像偏移 0xC2060 / 0xC2068 …（VA 0x1400C20xx）
# 与 打包代码PE 的区别：布局全部动态算，槽里放的是指向镜像内桩函数的指针，
# 桩函数再转调 kernel32 —— 所以产物自带运行时，不依赖宿主。
#
# 验证：10 例（常量/算术/分支/循环/函数/递归/变量/字符串长）+ 列表读写 + 运行时级
# 字符串连接 全部退出码正确；整包 781778 字节码可打包、可加载到首选基址 0x140000000。


函数 写8位 缓冲 位 值 则
    将 v 变成 整数(值) % 256
    如果 v < 0 则
        将 v 变成 v + 256
    结束
    缓冲写(缓冲, 位, v)
结束

函数 写字16 缓冲 位 值 则
    写8位(缓冲, 位, 值 % 256)
    写8位(缓冲, 位 + 1, 向下取整(值 / 256) % 256)
结束

函数 写字32 缓冲 位 值 则
    将 v 变成 值
    如果 v < 0 则
        将 v 变成 v + 4294967296
    结束
    写8位(缓冲, 位, v % 256)
    写8位(缓冲, 位 + 1, 向下取整(v / 256) % 256)
    写8位(缓冲, 位 + 2, 向下取整(v / 65536) % 256)
    写8位(缓冲, 位 + 3, 向下取整(v / 16777216) % 256)
结束

函数 写字64 缓冲 位 值 则
    将 v 变成 值
    将 权 变成 1
    对于 序 在 范围(0, 8) 中 则
        将 字节 变成 向下取整(v / 权) % 256
        如果 字节 < 0 则
            将 字节 变成 字节 + 256
        结束
        写8位(缓冲, 位 + 序, 字节)
        将 权 变成 权 * 256
    结束
结束

函数 写表 缓冲 位 表 则
    将 序 变成 0
    对于 字节 在 表 中 则
        写8位(缓冲, 位 + 序, 字节)
        将 序 变成 序 + 1
    结束
结束

函数 写节头 缓冲 位 名 虚大 虚址 原大 原址 属性 则
    写表(缓冲, 位, 名)
    写字32(缓冲, 位 + 8, 虚大)
    写字32(缓冲, 位 + 12, 虚址)
    写字32(缓冲, 位 + 16, 原大)
    写字32(缓冲, 位 + 20, 原址)
    写字32(缓冲, 位 + 36, 属性)
结束

函数 打包自举PE 路径 码文 则
    打印 "P-1 码文类型=" + 类型(码文)
    如果 是文本(码文) 则
        将 码 变成 十六进制转缓冲(码文)
    否则
        将 码 变成 码文
    结束
    将 码长 变成 缓冲长度(码)
    打印 "P-2 码类型=" + 类型(码)

    # —— 布局 ——
    将 文原 变成 0x400
    将 文对齐 变成 0x200
    当 文对齐 < 0x14 + 码长 则
        将 文对齐 变成 文对齐 + 0x200
    结束
    将 桩原 变成 文原 + 文对齐
    将 导原 变成 桩原 + 0x400
    将 总大小 变成 导原 + 0x400
    将 桩虚 变成 0xC2000
    将 导虚 变成 0xC3000
    将 基址 变成 0x140000000

    # 桩函数在镜像里的位置
    将 分配址 变成 桩虚 + 0x100
    将 清零址 变成 桩虚 + 0x140
    将 空址 变成 桩虚 + 0x180
    将 打开址 变成 桩虚 + 0x1C0
    将 大小址 变成 桩虚 + 0x1D0
    将 读入址 变成 桩虚 + 0x1E0
    将 关址 变成 桩虚 + 0x1F0
    将 写出址 变成 桩虚 + 0x200
    将 查询址 变成 桩虚 + 0x210
    将 命令址 变成 桩虚 + 0x220
    将 睡址 变成 桩虚 + 0x230
    # 导入表位置（RVA）—— IAT 保持从 +0x60 起（分配桩硬编码依赖前两项）
    将 取堆槽 变成 导虚 + 0x60
    将 分配槽 变成 导虚 + 0x68
    将 退出槽 变成 导虚 + 0x70
    将 打开槽 变成 导虚 + 0x78
    将 读入槽 变成 导虚 + 0x80
    将 写出槽 变成 导虚 + 0x88
    将 关槽 变成 导虚 + 0x90
    将 大小槽 变成 导虚 + 0x98
    将 查询槽 变成 导虚 + 0xA0
    将 命令槽 变成 导虚 + 0xA8
    将 睡槽 变成 导虚 + 0xB0

    将 缓冲 变成 新建缓冲(总大小, 0)
    打印 整数(77)
    打印 是文本(码文)
    打印 码长
    打印 总大小

    # —— DOS 头 ——
    写8位(缓冲, 0, 77)
    写8位(缓冲, 1, 90)
    打印 缓冲读(缓冲, 0)
    打印 缓冲读(缓冲, 1)
    写字32(缓冲, 0x3C, 0x40)
    写8位(缓冲, 0x40, 80)
    写8位(缓冲, 0x41, 69)
    写8位(缓冲, 0x42, 0)
    写8位(缓冲, 0x43, 0)

    # —— COFF 头（可选头从 0x58 开始）——
    将 可 变成 0x58
    写字16(缓冲, 可 - 20, 0x8664)
    写字16(缓冲, 可 - 18, 4)
    将 特 变成 0x22
    写字16(缓冲, 可 - 2, 0x22)
    写字16(缓冲, 0x54, 0xF0)
    写字16(缓冲, 0x56, 0x22)

    # —— 可选头 ——
    写字16(缓冲, 可, 0x20B)
    写字32(缓冲, 可 + 4, 0x200)
    写字32(缓冲, 可 + 8, 0x200)
    写字32(缓冲, 可 + 16, 0x1000)
    写字32(缓冲, 可 + 20, 0x1000)
    写字64(缓冲, 可 + 24, 基址)
    写字32(缓冲, 可 + 32, 0x1000)
    写字32(缓冲, 可 + 36, 0x200)
    写字16(缓冲, 可 + 40, 6)
    写字16(缓冲, 可 + 42, 0)
    写字16(缓冲, 可 + 48, 6)
    写字32(缓冲, 可 + 56, 导虚 + 0x1000)
    写字32(缓冲, 可 + 60, 0x400)
    写字16(缓冲, 可 + 68, 2)
    写字64(缓冲, 可 + 72, 0x100000)
    写字64(缓冲, 可 + 80, 0x1000)
    写字64(缓冲, 可 + 88, 0x100000)
    写字64(缓冲, 可 + 96, 0x1000)
    写字32(缓冲, 可 + 108, 16)
    写字32(缓冲, 可 + 120, 导虚)
    写字32(缓冲, 可 + 124, 0x28)

    # —— 节头（3 个）——
    将 节 变成 可 + 0xF0
    # 节必须首尾相接填满镜像：VA 之间留空洞会被加载器判为无效（WinError 193）
    #  .text 0x1000..0xC1000   代码（容量 0xC0000，够装整包 781KB 机器码）
    #  .data 0xC1000..0xC2000  全局变量区（自举库的 找全局址 从这里起算，必须可写）
    #  .stub 0xC2000..0xC3000  原语桩
    #  .idata 0xC3000..0xC3200 导入表
    写节头(缓冲, 节, [46, 116, 101, 120, 116], 0xC1000 - 0x1000, 0x1000, 文对齐, 文原, 0x60000020)
    写节头(缓冲, 节 + 40, [46, 100, 97, 116, 97], 0x1000, 0xC1000, 0, 0, 0xC0000080)
    写节头(缓冲, 节 + 80, [46, 115, 116, 117, 98], 导虚 - 桩虚, 桩虚, 0x400, 桩原, 0x60000020)
    写节头(缓冲, 节 + 120, [46, 105, 100, 97, 116, 97], 0x400, 导虚, 0x400, 导原, 0x40000040)

    # —— 入口蹦床：调代码，再把 xmm0 当退出码 ——
    写8位(缓冲, 文原 + 0, 72)
    写8位(缓冲, 文原 + 1, 131)
    写8位(缓冲, 文原 + 2, 236)
    写8位(缓冲, 文原 + 3, 8)
    写8位(缓冲, 文原 + 4, 232)
    写字32(缓冲, 文原 + 5, 0x0B)
    写8位(缓冲, 文原 + 9, 242)
    写8位(缓冲, 文原 + 10, 15)
    写8位(缓冲, 文原 + 11, 44)
    写8位(缓冲, 文原 + 12, 200)
    写8位(缓冲, 文原 + 13, 255)
    写8位(缓冲, 文原 + 14, 21)
    写字32(缓冲, 文原 + 15, (基址 + 退出槽) - (基址 + 0x1013))
    写8位(缓冲, 文原 + 19, 204)

    # —— 代码 ——
    将 序 变成 0
    当 序 < 码长 则
        缓冲写(缓冲, 文原 + 0x14 + 序, 缓冲读(码, 序))
        将 序 变成 序 + 1
    结束

    # —— 槽表：0x7F050… 全部指向桩 ——
    将 槽表 变成 [0x50, 0x58, 0x60, 0x68, 0x70, 0x78, 0x80, 0x88, 0x90, 0x98, 0xA0, 0x2C0]
    对于 偏 在 槽表 中 则
        将 目 变成 空址
        如果 偏 等于 0x60 则
            将 目 变成 分配址
        结束
        如果 偏 等于 0x68 则
            将 目 变成 清零址
        结束
        如果 偏 等于 0x50 则
            将 目 变成 睡址
        结束
        如果 偏 等于 0x70 则
            将 目 变成 打开址
        结束
        如果 偏 等于 0x78 则
            将 目 变成 大小址
        结束
        如果 偏 等于 0x80 则
            将 目 变成 读入址
        结束
        如果 偏 等于 0x88 则
            将 目 变成 关址
        结束
        如果 偏 等于 0x90 则
            将 目 变成 写出址
        结束
        如果 偏 等于 0x98 则
            将 目 变成 查询址
        结束
        如果 偏 等于 0xA0 则
            将 目 变成 命令址
        结束
        写字64(缓冲, 桩原 + 偏, 基址 + 目)
    结束

    # —— 桩：分配（转 GetProcessHeap + HeapAlloc）——
    将 偏 变成 桩原 + 0x100
    写表(缓冲, 偏, [72, 131, 236, 40, 73, 137, 200, 49, 201, 255, 21])
    写字32(缓冲, 偏 + 11, (基址 + 取堆槽) - (基址 + 分配址 + 15))
    写表(缓冲, 偏 + 15, [72, 137, 193, 49, 210, 255, 21])
    写字32(缓冲, 偏 + 22, (基址 + 分配槽) - (基址 + 分配址 + 26))
    写表(缓冲, 偏 + 26, [72, 131, 196, 40, 195])

    # —— 桩：清零（memset 等价）——
    将 偏 变成 桩原 + 0x140
    写表(缓冲, 偏, [72, 137, 200, 77, 133, 192, 116, 10, 136, 17, 72, 255, 193, 73, 255, 200, 117, 248, 195])

    # —— 桩：未实现，直接返回 0 ——
    将 偏 变成 桩原 + 0x180
    写表(缓冲, 偏, [49, 192, 195])

    # —— 桩：文件/系统类，全部 `jmp qword ptr [rip+disp32]` 直达 IAT ——
    将 桩偏表 变成 [0x1C0, 0x1D0, 0x1E0, 0x1F0, 0x200, 0x210, 0x220, 0x230]
    将 桩槽表 变成 [打开槽, 大小槽, 读入槽, 关槽, 写出槽, 查询槽, 命令槽, 睡槽]
    将 序 变成 0
    当 序 < 8 则
        将 偏 变成 桩原 + 桩偏表[序]
        写表(缓冲, 偏, [255, 37])
        写字32(缓冲, 偏 + 2, (基址 + 桩槽表[序]) - (基址 + 桩虚 + 桩偏表[序] + 6))
        将 序 变成 序 + 1
    结束

    # —— 导入表（11 个 kernel32 函数）——
    将 导 变成 导原
    # ImportDescriptor：ILT @0x200，IAT @0x60，DLL 名 @0x370
    写字32(缓冲, 导, 导虚 + 0x200)
    写字32(缓冲, 导 + 12, 导虚 + 0x370)
    写字32(缓冲, 导 + 16, 导虚 + 0x60)
    将 名字节 变成 [71, 101, 116, 80, 114, 111, 99, 101, 115, 115, 72, 101, 97, 112, 0, 72, 101, 97, 112, 65, 108, 108, 111, 99, 0, 69, 120, 105, 116, 80, 114, 111, 99, 101, 115, 115, 0, 67, 114, 101, 97, 116, 101, 70, 105, 108, 101, 65, 0, 82, 101, 97, 100, 70, 105, 108, 101, 0, 87, 114, 105, 116, 101, 70, 105, 108, 101, 0, 67, 108, 111, 115, 101, 72, 97, 110, 100, 108, 101, 0, 71, 101, 116, 70, 105, 108, 101, 83, 105, 122, 101, 0, 71, 101, 116, 67, 111, 109, 109, 97, 110, 100, 76, 105, 110, 101, 65, 0, 86, 105, 114, 116, 117, 97, 108, 81, 117, 101, 114, 121, 0, 83, 108, 101, 101, 112, 0]
    将 名址 变成 0x260
    将 序 变成 0
    将 名位 变成 0
    当 序 < 11 则
        写字64(缓冲, 导 + 0x200 + 序 * 8, 导虚 + 名址)
        写字64(缓冲, 导 + 0x60 + 序 * 8, 导虚 + 名址)
        写字16(缓冲, 导 + 名址, 0)
        将 内 变成 0
        当 名字节[名位] 不等于 0 则
            写8位(缓冲, 导 + 名址 + 2 + 内, 名字节[名位])
            将 内 变成 内 + 1
            将 名位 变成 名位 + 1
        结束
        将 名位 变成 名位 + 1
        将 名址 变成 名址 + 24
        将 序 变成 序 + 1
    结束
    写字64(缓冲, 导 + 0x200 + 11 * 8, 0)
    写字64(缓冲, 导 + 0x60 + 11 * 8, 0)
    写表(缓冲, 导 + 0x370, [75, 69, 82, 78, 69, 76, 51, 50, 46, 100, 108, 108, 0])

    写二进制(路径, 缓冲)
    返回 真
结束

导出 打包自举PE
