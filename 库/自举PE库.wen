# 库/自举PE库.wen
# 【状态：未完成】能产出 PE，但 Windows 报「不是有效的 Win32 应用程序」。
#
# 二分结果（2026-11-05）：
#   · 只留 .text（单节、无导入）      → 能加载（跑到野地址崩溃，说明头部本身没问题）
#   · 加一个 VA 0x80000 的 .idata 节   → 加载失败
#   · 三节、无导入目录                → 也失败
#   · 把旧打包器的 .idata 挪到 0x80000 → 能加载
# 所以不是远地址、也不是导入表内容；差异在我写的第二节节头与旧打包器之间，待逐字节比对。
#
# 布局按自举库的假定来：
#   代码起点 = 镜像偏移 0x1014（VA 0x140001014）
#   导入槽   = 镜像偏移 0x7F060 / 0x7F068 …（VA 0x14007F0xx）
# 与 打包代码PE 的区别：布局全部动态算，槽里放的是指向镜像内桩函数的指针，
# 桩函数再转调 kernel32 —— 所以产物自带运行时，不依赖宿主。

函数 写8位 缓冲 位 值 则
    将 v 变成 值 % 256
    如果 v < 0 则
        将 v 变成 v + 256
    结束
    缓冲写(缓冲, 位, v)
结束

函数 写字16 缓冲 位 值 则
    写8位(缓冲, 位, 值 % 256)
    写8位(缓冲, 位 + 1, 向下取整(值 / 256) % 256)
结束

函数 写字32 缓冲 位 值 则
    将 v 变成 值
    如果 v < 0 则
        将 v 变成 v + 4294967296
    结束
    写8位(缓冲, 位, v % 256)
    写8位(缓冲, 位 + 1, 向下取整(v / 256) % 256)
    写8位(缓冲, 位 + 2, 向下取整(v / 65536) % 256)
    写8位(缓冲, 位 + 3, 向下取整(v / 16777216) % 256)
结束

函数 写字64 缓冲 位 值 则
    将 v 变成 值
    将 权 变成 1
    对于 序 在 范围(0, 8) 中 则
        将 字节 变成 向下取整(v / 权) % 256
        如果 字节 < 0 则
            将 字节 变成 字节 + 256
        结束
        写8位(缓冲, 位 + 序, 字节)
        将 权 变成 权 * 256
    结束
结束

函数 写表 缓冲 位 表 则
    将 序 变成 0
    对于 字节 在 表 中 则
        写8位(缓冲, 位 + 序, 字节)
        将 序 变成 序 + 1
    结束
结束

函数 写节头 缓冲 位 名 虚大 虚址 原大 原址 属性 则
    写表(缓冲, 位, 名)
    写字32(缓冲, 位 + 8, 虚大)
    写字32(缓冲, 位 + 12, 虚址)
    写字32(缓冲, 位 + 16, 原大)
    写字32(缓冲, 位 + 20, 原址)
    写字32(缓冲, 位 + 36, 属性)
结束

函数 打包自举PE 路径 码文 则
    将 码 变成 十六进制转缓冲(码文)
    将 码长 变成 长度(码)

    # —— 布局 ——
    将 文原 变成 0x400
    将 文对齐 变成 0x200
    当 文对齐 < 0x14 + 码长 则
        将 文对齐 变成 文对齐 + 0x200
    结束
    将 桩原 变成 文原 + 文对齐
    将 导原 变成 桩原 + 0x400
    将 总大小 变成 导原 + 0x200
    将 桩虚 变成 0x7F000
    将 导虚 变成 0x80000
    将 基址 变成 0x140000000

    # 桩函数在镜像里的位置
    将 分配址 变成 桩虚 + 0x100
    将 清零址 变成 桩虚 + 0x140
    将 空址 变成 桩虚 + 0x180
    # 导入表位置（RVA）
    将 取堆槽 变成 导虚 + 0x60
    将 分配槽 变成 导虚 + 0x68
    将 退出槽 变成 导虚 + 0x70

    将 缓冲 变成 新建缓冲(总大小, 0)

    # —— DOS 头 ——
    写8位(缓冲, 0, 77)
    写8位(缓冲, 1, 90)
    写字32(缓冲, 0x3C, 0x40)
    写8位(缓冲, 0x40, 80)
    写8位(缓冲, 0x41, 69)
    写8位(缓冲, 0x42, 0)
    写8位(缓冲, 0x43, 0)

    # —— COFF 头（可选头从 0x58 开始）——
    将 可 变成 0x58
    写字16(缓冲, 可 - 20, 0x8664)
    写字16(缓冲, 可 - 18, 3)
    将 特 变成 0x22
    写字16(缓冲, 可 - 2, 0x22)
    写字16(缓冲, 0x54, 0xF0)
    写字16(缓冲, 0x56, 0x22)

    # —— 可选头 ——
    写字16(缓冲, 可, 0x20B)
    写字32(缓冲, 可 + 4, 0x200)
    写字32(缓冲, 可 + 8, 0x200)
    写字32(缓冲, 可 + 16, 0x1000)
    写字32(缓冲, 可 + 20, 0x1000)
    写字64(缓冲, 可 + 24, 基址)
    写字32(缓冲, 可 + 32, 0x1000)
    写字32(缓冲, 可 + 36, 0x200)
    写字16(缓冲, 可 + 40, 6)
    写字16(缓冲, 可 + 42, 0)
    写字16(缓冲, 可 + 48, 6)
    写字32(缓冲, 可 + 56, 导虚 + 0x1000)
    写字32(缓冲, 可 + 60, 0x400)
    写字16(缓冲, 可 + 68, 2)
    写字64(缓冲, 可 + 72, 0x100000)
    写字64(缓冲, 可 + 80, 0x1000)
    写字64(缓冲, 可 + 88, 0x100000)
    写字64(缓冲, 可 + 96, 0x1000)
    写字32(缓冲, 可 + 108, 16)
    写字32(缓冲, 可 + 120, 导虚)
    写字32(缓冲, 可 + 124, 0x28)

    # —— 节头（3 个）——
    将 节 变成 可 + 0xF0
    写节头(缓冲, 节, [46, 116, 101, 120, 116], 0x14 + 码长, 0x1000, 文对齐, 文原, 0x60000020)
    写节头(缓冲, 节 + 40, [46, 115, 116, 117, 98], 0x400, 桩虚, 0x400, 桩原, 0x60000020)
    写节头(缓冲, 节 + 80, [46, 105, 100, 97, 116, 97], 0x200, 导虚, 0x200, 导原, 0x40000040)

    # —— 入口蹦床：调代码，再把 xmm0 当退出码 ——
    写表(缓冲, 文原, [72, 131, 236, 8])
    写8位(缓冲, 文原 + 4, 232)
    写字32(缓冲, 文原 + 5, 0x0B)
    写表(缓冲, 文原 + 9, [242, 15, 44, 200])
    写表(缓冲, 文原 + 13, [255, 21])
    写字32(缓冲, 文原 + 15, (基址 + 退出槽) - (基址 + 0x1013))
    写8位(缓冲, 文原 + 19, 204)

    # —— 代码 ——
    将 序 变成 0
    当 序 < 码长 则
        写8位(缓冲, 文原 + 0x14 + 序, 缓冲读(码, 序))
        将 序 变成 序 + 1
    结束

    # —— 槽表：0x7F050… 全部指向桩 ——
    将 槽表 变成 [0x50, 0x58, 0x60, 0x68, 0x70, 0x78, 0x80, 0x88, 0x90, 0x98, 0xA0, 0x2C0]
    对于 偏 在 槽表 中 则
        将 目 变成 空址
        如果 偏 等于 0x60 则
            将 目 变成 分配址
        结束
        如果 偏 等于 0x68 则
            将 目 变成 清零址
        结束
        写字64(缓冲, 桩原 + 偏, 基址 + 目)
    结束

    # —— 桩：分配（转 GetProcessHeap + HeapAlloc）——
    将 偏 变成 桩原 + 0x100
    写表(缓冲, 偏, [72, 131, 236, 40, 73, 137, 200, 49, 201, 255, 21])
    写字32(缓冲, 偏 + 11, (基址 + 取堆槽) - (基址 + 分配址 + 17))
    写表(缓冲, 偏 + 17, [72, 137, 193, 49, 210, 255, 21])
    写字32(缓冲, 偏 + 25, (基址 + 分配槽) - (基址 + 分配址 + 31))
    写表(缓冲, 偏 + 31, [72, 131, 196, 40, 195])

    # —— 桩：清零（memset 等价）——
    将 偏 变成 桩原 + 0x140
    写表(缓冲, 偏, [72, 137, 200, 77, 133, 192, 116, 10, 136, 17, 72, 255, 193, 73, 255, 200, 117, 248, 195])

    # —— 桩：未实现，直接返回 0 ——
    将 偏 变成 桩原 + 0x180
    写表(缓冲, 偏, [49, 192, 195])

    # —— 导入表 ——
    将 导 变成 导原
    # ImportDescriptor
    写字32(缓冲, 导, 导虚 + 0x40)
    写字32(缓冲, 导 + 12, 导虚 + 0xB0)
    写字32(缓冲, 导 + 16, 导虚 + 0x60)
    # ILT @+0x40，IAT @+0x58
    写字64(缓冲, 导 + 0x40, 导虚 + 0xC0)
    写字64(缓冲, 导 + 0x48, 导虚 + 0xD0)
    写字64(缓冲, 导 + 0x50, 导虚 + 0xDC)
    写字64(缓冲, 导 + 0x60, 导虚 + 0xC0)
    写字64(缓冲, 导 + 0x68, 导虚 + 0xD0)
    写字64(缓冲, 导 + 0x70, 导虚 + 0xDC)
    # 名字
    写表(缓冲, 导 + 0xB0, [75, 69, 82, 78, 69, 76, 51, 50, 46, 100, 108, 108, 0])
    写字16(缓冲, 导 + 0xC0, 0)
    写表(缓冲, 导 + 0xC2, [71, 101, 116, 80, 114, 111, 99, 101, 115, 115, 72, 101, 97, 112, 0])
    写字16(缓冲, 导 + 0xD0, 0)
    写表(缓冲, 导 + 0xD2, [72, 101, 97, 112, 65, 108, 108, 111, 99, 0])
    写字16(缓冲, 导 + 0xDC, 0)
    写表(缓冲, 导 + 0xDE, [69, 120, 105, 116, 80, 114, 111, 99, 101, 115, 115, 0])

    写二进制(路径, 缓冲)
    返回 真
结束

导出 打包自举PE
