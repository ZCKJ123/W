# 贪吃蛇.wen —— 回合制贪吃蛇
# 玩法：输入() w/a/s/d（或 上/下/左/右）回车走一步，q 退出；吃到 * 加分变长
依赖 数学库

将 宽 变成 12
将 高 变成 8
将 蛇 变成 [[5, 3], [4, 3], [3, 3]]
将 方向 变成 "右"
将 分数 变成 0
将 食物 变成 [0, 0]

函数 有蛇 蛇, x, y 则
    对于 节 在 蛇 中 则
        如果 节[0] == x 且 节[1] == y 则
            返回 真
        结束
    结束
    返回 假
结束

函数 放食物 蛇, 宽, 高 则
    当 真 则
        将 点 变成 [随机整数(0, 宽 - 1), 随机整数(0, 高 - 1)]
        如果 非 有蛇(蛇, 点[0], 点[1]) 则
            返回 点
        结束
    结束
结束

函数 画一格 x, y 则
    如果 有蛇(蛇, x, y) 则
        如果 x == 蛇[0][0] 且 y == 蛇[0][1] 则
            返回 "●"
        结束
        返回 "○"
    结束
    如果 x == 食物[0] 且 y == 食物[1] 则
        返回 "★"
    结束
    返回 "　"
结束

函数 画横线 宽 则
    将 线 变成 "+"
    将 i 变成 0
    当 i < 宽 则
        将 线 变成 线 + "--"
        将 i 变成 i + 1
    结束
    返回 线 + "+"
结束

将 食物 变成 放食物(蛇, 宽, 高)
打印 "【贪吃蛇】"
打印 "方向：上 下 左 右；输入()「退出」结束（每次输入后按回车）"

当 真 则
    打印 画横线(宽)
    将 y 变成 0
    当 y < 高 则
        将 行 变成 "|"
        将 x 变成 0
        当 x < 宽 则
            将 行 变成 行 + 画一格(x, y)
            将 x 变成 x + 1
        结束
        打印 行 + "|"
        将 y 变成 y + 1
    结束
    打印 画横线(宽)
    打印 "分数：" + 文本(分数) + "  长度：" + 文本(长度(蛇)) + "  方向：" + 方向
    将 按键 变成 输入("> ")
    如果 按键 == "q" 或 按键 == "退出" 则
        打印 "已退出。最终分数：" + 文本(分数)
        中断
    结束
    如果 (按键 == "w" 或 按键 == "上") 且 方向 != "下" 则
        将 方向 变成 "上"
    否则如果 (按键 == "s" 或 按键 == "下") 且 方向 != "上" 则
        将 方向 变成 "下"
    否则如果 (按键 == "a" 或 按键 == "左") 且 方向 != "右" 则
        将 方向 变成 "左"
    否则如果 (按键 == "d" 或 按键 == "右") 且 方向 != "左" 则
        将 方向 变成 "右"
    结束
    将 头 变成 蛇[0]
    将 新头 变成 [头[0], 头[1]]
    如果 方向 == "上" 则
        将 新头[1] 变成 新头[1] - 1
    否则如果 方向 == "下" 则
        将 新头[1] 变成 新头[1] + 1
    否则如果 方向 == "左" 则
        将 新头[0] 变成 新头[0] - 1
    否则
        将 新头[0] 变成 新头[0] + 1
    结束
    如果 新头[0] < 0 或 新头[0] >= 宽 或 新头[1] < 0 或 新头[1] >= 高 则
        打印 "撞墙了！最终分数：" + 文本(分数)
        中断
    结束
    将 吃到 变成 新头[0] == 食物[0] 且 新头[1] == 食物[1]
    将 尾 变成 蛇[长度(蛇) - 1]
    如果 有蛇(蛇, 新头[0], 新头[1]) 且 (吃到 或 新头[0] != 尾[0] 或 新头[1] != 尾[1]) 则
        打印 "撞到自己了！最终分数：" + 文本(分数)
        中断
    结束
    插入(蛇, 0, 新头)
    如果 吃到 则
        将 分数 变成 分数 + 1
        打印 "吃到食物！分数 " + 文本(分数)
        如果 长度(蛇) >= 宽 * 高 则
            打印 "满屏通关！最终分数：" + 文本(分数)
            中断
        结束
        将 食物 变成 放食物(蛇, 宽, 高)
    否则
        弹出(蛇)
    结束
结束
打印 "再见！"
