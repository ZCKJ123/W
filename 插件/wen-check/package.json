{
  "name": "dsh-wen-check",
  "version": "0.4.2",
  "private": false,
  "type": "module",
  "description": "DSH plugin: expose the wen language compiler as a structured-diagnostic tool (wen_check)."
  ,"license": "MIT"
  ,"repository": { "type": "git", "url": "https://gitee.com/zhuchen_1/wen.git" }
  ,"keywords": ["dsh", "dsh-plugin", "wen", "diagnostics"],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "wen.exe",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "wen": {
    "official": true,
    "signature": "WEN-LANG-0.2",
    "version": "0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}

