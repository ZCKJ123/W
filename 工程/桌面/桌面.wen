依赖 视口库, 时间库
# 文桌面 —— 纯文语言自绘桌面
# 系统窗口只提供像素；标题栏、窗口、任务栏、时钟、图标全部自己画。
界面新建(800, 560, "文桌面 · 自绘视口")
将 尺寸 变成 界面尺寸()
将 宽 变成 尺寸[0]
将 高 变成 尺寸[1]
将 选中 变成 0
将 已开 变成 假
将 提示 变成 "方向键选择  ·  回车打开  ·  Esc 退出"
函数 画图标 x y 名称 序号 则
    如果 选中 等于 序号 则
        界面矩形(x - 6, y - 6, 92, 92, 颜色(54, 96, 132))
        界面矩形(x - 6, y - 6, 92, 3, 颜色(120, 200, 245))
    否则
        界面矩形(x - 6, y - 6, 92, 92, 颜色(27, 36, 48))
    结束
    界面矩形(x, y, 80, 56, 颜色(88, 138, 178))
    界面矩形(x + 8, y + 8, 64, 40, 颜色(30, 52, 74))
    界面文本(x + 12, y + 68, 名称, 颜色(228, 236, 244), 15)
结束
函数 画窗口 x y 宽 高 标题 则
    界面矩形(x + 8, y + 8, 宽, 高, 颜色(8, 12, 20))
    界面矩形(x, y, 宽, 高, 颜色(226, 232, 240))
    界面矩形(x, y, 宽, 36, 颜色(36, 52, 72))
    界面文本(x + 16, y + 9, 标题, 颜色(242, 247, 252), 16)
    界面文本(x + 宽 - 26, y + 9, "×", 颜色(242, 247, 252), 16)
    界面矩形(x, y + 高 - 28, 宽, 28, 颜色(210, 218, 228))
    界面文本(x + 12, y + 高 - 22, "文语言 · 自绘窗口", 颜色(80, 96, 112), 12)
结束
函数 画内容 页 x y 宽 高 则
    如果 页 等于 0 则
        界面文本(x, y, "终端", 颜色(20, 45, 30), 20)
        界面文本(x, y + 38, "文语言 0.2.0-snapshot", 颜色(60, 76, 92), 15)
        界面文本(x, y + 68, "> 依赖 数学库", 颜色(30, 90, 60), 15)
        界面文本(x, y + 96, "> 打印 平方根(81)", 颜色(30, 60, 100), 15)
        界面文本(x, y + 124, "9", 颜色(140, 70, 30), 15)
    否则如果 页 等于 1 则
        界面文本(x, y, "文件", 颜色(20, 45, 30), 20)
        界面文本(x, y + 38, "库/   演算库、集合库、几何库", 颜色(60, 76, 92), 15)
        界面文本(x, y + 66, "工程/ 三维、光影展示、桌面", 颜色(60, 76, 92), 15)
        界面文本(x, y + 94, "测试/ 用例与错误回归", 颜色(60, 76, 92), 15)
    否则如果 页 等于 2 则
        界面文本(x, y, "光影", 颜色(20, 45, 30), 20)
        界面文本(x, y + 38, "粒子体云 · GGX · 5×5 PCF", 颜色(60, 76, 92), 15)
        界面文本(x, y + 66, "天空环境反射 · ACES · Bloom", 颜色(60, 76, 92), 15)
        界面文本(x, y + 94, "截图目录默认不上传", 颜色(140, 70, 30), 15)
    否则
        界面文本(x, y, "设置", 颜色(20, 45, 30), 20)
        界面文本(x, y + 38, "视口：自绘 800×560", 颜色(60, 76, 92), 15)
        界面文本(x, y + 66, "截图：本地保留，不进仓库", 颜色(60, 76, 92), 15)
        界面文本(x, y + 94, "核心：C++ 引导 / 机器码子集", 颜色(140, 70, 30), 15)
    结束
    界面矩形(x, y + 高 - 44, 宽, 1, 颜色(188, 200, 212))
    界面文本(x, y + 高 - 26, "回车切换页面  ·  Esc 退出", 颜色(100, 116, 132), 13)
结束
当 真 则
    将 事 变成 界面事件()
    如果 事["类型"] 等于 "关闭" 则
        中断
    结束
    如果 事["类型"] 等于 "按键" 则
        如果 事["值"] 等于 "上" 则
            将 选中 变成 (选中 + 3) % 4
        否则如果 事["值"] 等于 "下" 则
            将 选中 变成 (选中 + 1) % 4
        否则如果 事["值"] 等于 "保存" 则
            将 已开 变成 真
            将 提示 变成 "已打开 · 回车切换页面 · Esc 退出"
        结束
    结束
    界面清屏(颜色(16, 22, 32))
    界面矩形(0, 0, 宽, 38, 颜色(10, 16, 26))
    界面文本(18, 10, "文桌面 0.2", 颜色(224, 234, 244), 16)
    界面文本(宽 - 116, 10, 格式化时间(时间戳())[11:16], 颜色(120, 190, 230), 15)
    将 任务栏 变成 高 - 58
    界面矩形(0, 任务栏, 宽, 58, 颜色(10, 16, 26))
    界面矩形(16, 任务栏 + 10, 92, 38, 颜色(40, 56, 76))
    界面文本(34, 任务栏 + 20, "开始", 颜色(232, 240, 248), 15)
    界面文本(128, 任务栏 + 20, 提示, 颜色(154, 180, 204), 13)
    画图标(40, 68, "终端", 0)
    画图标(40, 173, "文件", 1)
    画图标(40, 278, "光影", 2)
    画图标(40, 383, "设置", 3)
    如果 已开 则
        画窗口(190, 76, 宽 - 240, 高 - 180, "文语言 · " + ["终端", "文件", "光影", "设置"][选中])
        画内容(选中, 222, 142, 宽 - 350, 高 - 240)
    否则
        画窗口(250, 190, 480, 200, "欢迎")
        界面文本(282, 250, "方向键选择左侧图标", 颜色(30, 40, 50), 18)
        界面文本(282, 290, "回车打开，Esc 退出", 颜色(70, 85, 100), 15)
        界面文本(282, 330, "截图默认不上传", 颜色(140, 70, 30), 14)
    结束
    界面刷新()
结束
界面关闭()
