依赖 视口库
# 文桌面 —— 纯文语言自绘桌面
# 只把系统窗口当像素输出，不依赖系统按钮/菜单/控件。

界面新建(960, 600, "文桌面 · 自绘视口")
界面清屏(颜色(18, 24, 34))

将 选中 变成 0
将 已开 变成 假
将 提示 变成 "方向键选择，回车打开，Esc 退出"

函数 画图标 x y 名称 序号 则
    如果 选中 等于 序号 则
        界面矩形(x - 6, y - 6, 92, 92, 颜色(56, 92, 120))
    否则
        界面矩形(x - 6, y - 6, 92, 92, 颜色(30, 40, 54))
    结束
    界面矩形(x, y, 80, 56, 颜色(90, 140, 180))
    界面文本(x + 8, y + 68, 名称, 颜色(230, 238, 245), 15)
结束

函数 画窗口 x y 宽 高 标题 则
    界面矩形(x + 6, y + 6, 宽, 高, 颜色(8, 12, 20))
    界面矩形(x, y, 宽, 高, 颜色(226, 232, 240))
    界面矩形(x, y, 宽, 34, 颜色(38, 52, 72))
    界面文本(x + 14, y + 8, 标题, 颜色(240, 246, 252), 16)
    界面文本(x + 宽 - 28, y + 8, "×", 颜色(240, 246, 252), 16)
结束

当 真 则
    将 事 变成 界面事件()
    如果 事["类型"] 等于 "关闭" 则
        中断
    结束
    如果 事["类型"] 等于 "按键" 则
        如果 事["值"] 等于 "上" 则
            将 选中 变成 (选中 + 3) % 4
        否则如果 事["值"] 等于 "下" 则
            将 选中 变成 (选中 + 1) % 4
        否则如果 事["值"] 等于 "保存" 则
            将 已开 变成 真
            如果 选中 等于 0 则
                将 提示 变成 "终端：文语言已就绪"
            否则如果 选中 等于 1 则
                将 提示 变成 "文件：库/、工程/、测试/"
            否则如果 选中 等于 2 则
                将 提示 变成 "光影：粒子云 + GGX + 级联阴影"
            否则
                将 提示 变成 "设置：当前是自绘视口"
            结束
        结束
    结束

    界面清屏(颜色(18, 24, 34))
    界面矩形(0, 0, 960, 38, 颜色(12, 18, 28))
    界面文本(18, 10, "文桌面 0.2", 颜色(220, 230, 240), 16)
    界面文本(760, 10, "自绘 · 无系统控件", 颜色(120, 170, 210), 14)

    界面矩形(0, 540, 960, 60, 颜色(12, 18, 28))
    界面矩形(16, 550, 90, 38, 颜色(38, 52, 72))
    界面文本(34, 560, "开始", 颜色(230, 238, 245), 15)
    界面文本(130, 562, 提示, 颜色(180, 200, 220), 13)

    画图标(40, 80, "终端", 0)
    画图标(40, 190, "文件", 1)
    画图标(40, 300, "光影", 2)
    画图标(40, 410, "设置", 3)

    如果 已开 则
        画窗口(190, 90, 700, 390, "文语言 · 自绘窗口")
        界面文本(220, 150, "这是文语言自己画的窗口。", 颜色(30, 40, 50), 20)
        界面文本(220, 190, "窗口标题、边框、阴影、图标、任务栏都不是系统控件。", 颜色(70, 85, 100), 15)
        界面矩形(220, 235, 640, 2, 颜色(180, 195, 210))
        界面文本(220, 260, "依赖 数学库", 颜色(30, 90, 60), 16)
        界面文本(220, 288, "打印 平方根(81)", 颜色(30, 60, 100), 16)
        界面文本(220, 330, "输出：9", 颜色(120, 60, 30), 16)
        界面文本(220, 400, "回车继续，Esc 退出", 颜色(100, 115, 130), 14)
    否则
        画窗口(250, 180, 480, 220, "欢迎")
        界面文本(280, 240, "方向键选择左侧图标", 颜色(30, 40, 50), 18)
        界面文本(280, 280, "回车打开，Esc 退出", 颜色(70, 85, 100), 15)
    结束

    界面刷新()
结束
界面关闭()
